# MySQL 首次启动时创建的生产数据库名称。
MYSQL_DATABASE=hotpot_shop
# MySQL 首次启动时创建的最小权限业务账号。
MYSQL_USER=shop
# MySQL 业务账号密码；由 scripts/init-prod-env.sh 生成。
MYSQL_PASSWORD=<generated-by-init-script>
# MySQL root 密码；仅用于备份、恢复和紧急维护。
MYSQL_ROOT_PASSWORD=<generated-by-init-script>

# Redis 密码；由 scripts/init-prod-env.sh 生成并同步到应用配置。
REDIS_PASSWORD=<generated-by-init-script>
