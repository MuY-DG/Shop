# local、txcloud、shop 共用这一份结构；真实文件位于同目录且永不提交 Git。
# 运行 scripts/config/init-runtime-env.sh <target> 生成独立密钥。

# MySQL
SHOP_DB_PASSWORD=<generated-by-init-script>
# MySQL root 只用于初始化、备份和应急维护；
SHOP_DB_ROOT_PASSWORD=<generated-by-init-script>
# Redis requirepass 密码；
SHOP_REDIS_PASSWORD=<generated-by-init-script>

# 微信、支付、COS 等敏感配置共用AES-256 主密钥。
SHOP_SECRET_ENCRYPTION_ACTIVE_KEY_ID=<generated-lowercase-key-id>
# key-id=base64:<32-byte-key>；轮换期用分号分隔，最多保留 16 个 key-id。
SHOP_SECRET_ENCRYPTION_KEY_RING=<generated-key-ring>
