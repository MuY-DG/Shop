# 生产应用环境文件只保留启动依赖、可信代理和通用主加密材料。
# 微信平台及支付业务凭据通过后台数据库配置管理，不再进入新部署模板。

# Docker Compose 内使用 mysql 服务名，不填写宿主机 IP。
SHOP_DB_URL=jdbc:mysql://mysql:3306/hotpot_shop?useUnicode=true&characterEncoding=utf8&serverTimezone=UTC&allowPublicKeyRetrieval=true&useSSL=false
# 与 MYSQL_USER 保持一致的 MySQL 业务账号。
SHOP_DB_USERNAME=shop
# 与 MYSQL_PASSWORD 保持一致的 MySQL 业务密码。
SHOP_DB_PASSWORD=<generated-by-init-script>

# Docker Compose 内使用 redis 服务名，不填写宿主机 IP。
SHOP_REDIS_HOST=redis
# Redis 容器内部服务端口。
SHOP_REDIS_PORT=6379
# 应用使用的 Redis 逻辑数据库编号。
SHOP_REDIS_DATABASE=0
# 当前仅使用 requirepass，不启用 ACL 用户名。
SHOP_REDIS_USERNAME=
# Redis 密码；由 scripts/init-prod-env.sh 与基础设施文件同步。
SHOP_REDIS_PASSWORD=<generated-by-init-script>

# 仅信任 OpenResty 经宿主机回环端口进入容器时实际看到的 Docker bridge 网关。
# 部署后用 docker inspect 核验并将占位符替换为单个网关 /32；禁止放宽为整个 172.16.0.0/12。
SHOP_TRUSTED_PROXY_CIDRS=127.0.0.0/8,::1/128,<docker-edge-gateway-ip>/32
# OpenResty 必须覆盖 X-Forwarded-For，因此生产链路只接受一跳转发。
SHOP_MAX_FORWARDED_HOPS=1

# 数据库敏感配置共用这套通用主密钥；主密钥禁止写入数据库或镜像。
# 新生产数据库直接写入带密钥 ID 和上下文绑定的 v2 密文。
SHOP_SECRET_ENCRYPTION_WRITE_VERSION=2
# 当前用于写入 v2 密文的密钥 ID，必须存在于下方密钥环中。
SHOP_SECRET_ENCRYPTION_ACTIVE_KEY_ID=<lowercase-key-id>
# v2 AES-256 密钥环，格式为 key-id=base64:<32-byte-key>。
SHOP_SECRET_ENCRYPTION_KEY_RING=<key-id=base64:key>
# 旧版 v1 兼容读取主密钥，保留到历史备份和回滚窗口结束。
SHOP_SECRET_ENCRYPTION_LEGACY_KEY=<independent-legacy-32-byte-key>
# 全新数据库没有待迁移的 v1 密文，默认关闭后台轮换。
SHOP_SECRET_ENCRYPTION_ROTATION_ENABLED=false

# 全新数据库首次执行 V36 时默认停用初始化 Super。
SHOP_DEFAULT_ADMIN_STATUS=DISABLED
# 如需首次启用 Super，请用 AdminPasswordHashTool 生成独立 BCrypt 哈希后替换。
SHOP_DEFAULT_ADMIN_PASSWORD_HASH=<bcrypt-hash>
