# 全新数据库首次执行 V36 时默认停用初始化 Super。
SHOP_DEFAULT_ADMIN_STATUS=DISABLED
# 如需首次启用 Super，请用 AdminPasswordHashTool 生成独立 BCrypt 哈希后替换。
SHOP_DEFAULT_ADMIN_PASSWORD_HASH=<bcrypt-hash>

# Docker Compose 内使用 redis 服务名，不填写宿主机 IP。
SHOP_REDIS_HOST=redis
# Redis 容器内部服务端口。
SHOP_REDIS_PORT=6379
# 应用使用的 Redis 逻辑数据库编号。
SHOP_REDIS_DATABASE=0
# 当前仅使用 requirepass，不启用 ACL 用户名。
SHOP_REDIS_USERNAME=
# Redis 密码；由 scripts/init-prod-env.sh 与基础设施文件同步。
SHOP_REDIS_PASSWORD=<generated-by-init-script>

# 仅信任 OpenResty 经宿主机回环端口进入容器时实际看到的 Docker bridge 网关。
# 部署后用 docker inspect 核验并将占位符替换为单个网关 /32；禁止放宽为整个 172.16.0.0/12。
SHOP_TRUSTED_PROXY_CIDRS=127.0.0.0/8,::1/128,<docker-edge-gateway-ip>/32
# OpenResty 必须覆盖 X-Forwarded-For，因此生产链路只接受一跳转发。
SHOP_MAX_FORWARDED_HOPS=1

# 支付配置与 COS 凭证共用这套通用主密钥配置；它不是 COS SecretId/SecretKey。
# 新生产数据库直接写入带密钥 ID 和上下文绑定的 v2 密文。
SHOP_SECRET_ENCRYPTION_WRITE_VERSION=2
# 当前用于写入 v2 密文的密钥 ID，必须存在于下方密钥环中。
SHOP_SECRET_ENCRYPTION_ACTIVE_KEY_ID=<lowercase-key-id>
# v2 AES-256 密钥环，格式为 key-id=base64:<32-byte-key>。
SHOP_SECRET_ENCRYPTION_KEY_RING=<key-id=base64:key>
# 旧版 v1 兼容读取主密钥，保留到历史备份和回滚窗口结束。
SHOP_SECRET_ENCRYPTION_LEGACY_KEY=<independent-legacy-32-byte-key>
# 全新数据库没有待迁移的 v1 密文，默认关闭后台轮换。
SHOP_SECRET_ENCRYPTION_ROTATION_ENABLED=false

# 生产微信小程序 AppID。
WECHAT_MINI_PROGRAM_APP_ID=<wechat-mini-program-app-id>
# 生产微信小程序 AppSecret。
WECHAT_MINI_PROGRAM_APP_SECRET=<wechat-mini-program-app-secret>
# 生产微信支付总开关。
WECHAT_PAY_ENABLED=true
# 生产环境必须关闭支付模拟模式。
WECHAT_PAY_MOCK_ENABLED=false
# 支付配置来源，可使用 ENV、DB 或 AUTO。
WECHAT_PAY_CONFIG_SOURCE=ENV
# 生产微信支付关联的 AppID。
WECHAT_PAY_APP_ID=<wechat-pay-app-id>
# 生产微信支付商户号。
WECHAT_PAY_MCH_ID=<wechat-pay-merchant-id>
# 生产商户 API 证书序列号。
WECHAT_PAY_MERCHANT_SERIAL_NO=<merchant-certificate-serial-no>
# 生产微信支付 APIv3 密钥。
WECHAT_PAY_API_V3_KEY=<wechat-pay-api-v3-key>
# 支付结果公网 HTTPS 回调地址。
WECHAT_PAY_NOTIFY_URL=https://example.com/wxpay/pay/notify
# 退款结果公网 HTTPS 回调地址。
WECHAT_PAY_REFUND_NOTIFY_URL=https://example.com/wxpay/refund/notify
# 微信平台应答签名验证方式。
WECHAT_PAY_VERIFY_MODE=PUBLIC_KEY
# 微信支付公钥 ID。
WECHAT_PAY_PUBLIC_KEY_ID=<wechat-pay-public-key-id>
# 商户 API 私钥在容器内的只读路径。
WECHAT_PAY_PRIVATE_KEY_PATH=/opt/shop/shop-server/secrets/apiclient_key.pem
# 微信支付公钥在容器内的只读路径。
WECHAT_PAY_PUBLIC_KEY_PATH=/opt/shop/shop-server/secrets/pub_key.pem
# 支付订单默认过期分钟数。
SHOP_PAY_EXPIRE_MINUTES=15
# 是否向微信平台上传生产发货信息。
SHOP_WECHAT_SHIPPING_UPLOAD_ENABLED=true

# COS 直传会话审计记录保留时间。
SHOP_DIRECT_UPLOAD_SESSION_RETENTION=7d
# 每个登录主体同时有效的 COS 直传会话上限。
SHOP_DIRECT_UPLOAD_MAX_ACTIVE_SESSIONS=10
# 单个小程序用户每小时可签发的 COS 直传会话上限。
SHOP_DIRECT_UPLOAD_MAX_SESSIONS_PER_HOUR_APP=60
# 单个管理员每小时可签发的 COS 直传会话上限。
SHOP_DIRECT_UPLOAD_MAX_SESSIONS_PER_HOUR_ADMIN=600
# Docker Compose 内使用 mysql 服务名，不填写宿主机 IP。
SHOP_DB_URL=jdbc:mysql://mysql:3306/hotpot_shop?useUnicode=true&characterEncoding=utf8&serverTimezone=UTC&allowPublicKeyRetrieval=true&useSSL=false
# 与 MYSQL_USER 保持一致的 MySQL 业务账号。
SHOP_DB_USERNAME=shop
# 与 MYSQL_PASSWORD 保持一致的 MySQL 业务密码。
SHOP_DB_PASSWORD=<generated-by-init-script>
