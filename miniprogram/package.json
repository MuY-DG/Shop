{
  "name": "zaoxiangji-miniprogram",
  "version": "0.1.0",
  "private": true,
  "description": "灶香集微信小程序",
  "packageManager": "pnpm@11.10.0",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test:typecheck": "tsc --noEmit -p tsconfig.test.json",
    "test": "TZ=UTC tsx --test --test-concurrency=1 tests/*.test.ts",
    "check": "pnpm typecheck && pnpm test:typecheck && pnpm test"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "miniprogram-api-typings": "^4.0.8",
    "tsx": "^4.20.6",
    "typescript": "^5.9.0"
  }
}
