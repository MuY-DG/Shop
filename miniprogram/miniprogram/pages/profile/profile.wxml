<view class="profile-page">
  <navigation-bar title="我的" background="#FAF2E4" color="#2E1D16" />

  <view class="profile-content">
    <view
      class="member-card {{loggedIn ? '' : 'member-card--guest'}}"
      bindtap="onMemberTap"
      hover-class="member-card--pressed"
      aria-role="button"
      aria-label="{{loggedIn ? '编辑个人资料' : '前往登录'}}"
    >
      <image
        class="member-card__avatar"
        src="{{avatarUrl}}"
        mode="{{avatarMode}}"
      />
      <view class="member-card__body">
        <view class="member-card__name">{{nickname}}</view>
        <view class="member-card__copy">{{memberCopy}}</view>
      </view>
      <view wx:if="{{!loggedIn}}" class="member-card__login">登录</view>
    </view>

    <view class="order-center-card">
      <view class="order-center-card__heading" bindtap="onAllOrdersTap" aria-role="button">
        <view>
          <view class="order-center-card__title">我的订单</view>
          <view class="order-center-card__subtitle">支付、发货与收货进度</view>
        </view>
        <view class="order-center-card__all">全部订单 <text>›</text></view>
      </view>
      <view class="order-shortcuts">
        <view
          wx:for="{{orderShortcuts}}"
          wx:key="group"
          class="order-shortcut"
          data-group="{{item.group}}"
          bindtap="onOrderShortcutTap"
          aria-role="button"
        >
          <view class="order-shortcut__icon">{{item.icon}}</view>
          <text>{{item.label}}</text>
        </view>
      </view>
    </view>

    <view class="service-card">
      <view class="service-card__heading">
        <view class="service-card__title">常用服务</view>
        <view class="service-card__subtitle">管理账户资料与购物足迹</view>
      </view>
      <view class="service-grid">
        <view
          wx:for="{{accountServices}}"
          wx:key="path"
          class="service-item"
          data-path="{{item.path}}"
          bindtap="onAccountServiceTap"
          aria-role="button"
        >
          <view class="service-item__icon">{{item.icon}}</view>
          <text>{{item.label}}</text>
        </view>
      </view>
      <button
        class="customer-service"
        open-type="contact"
        hover-class="customer-service--pressed"
        aria-label="联系在线客服"
      >
        <view class="customer-service__icon">客</view>
        <view class="customer-service__body">
          <view class="customer-service__title">在线客服</view>
          <view class="customer-service__copy">商品、配送或订单问题，随时联系我们</view>
        </view>
        <text class="customer-service__chevron">›</text>
      </button>
    </view>

    <view class="profile-note">
      <view class="profile-note__mark">安</view>
      <view>
        <view class="profile-note__title">交易保障</view>
        <view class="profile-note__copy">支付结果以微信和服务端同步状态为准，异常订单可重新同步。</view>
      </view>
    </view>
  </view>
</view>
