<view class="profile-page">
  <image
    class="profile-page__background"
    src="/assets/images/profile-watercolor-background.png"
    mode="aspectFill"
    aria-hidden="true"
  />
  <navigation-bar
    title=""
    background="transparent"
    color="#2E1D16"
    show-divider="{{false}}"
  />

  <view class="profile-content">
    <view
      class="member-card {{loggedIn ? '' : 'member-card--guest'}}"
      bindtap="onMemberTap"
      hover-class="member-card--pressed"
      aria-role="button"
      aria-label="{{loggedIn ? '查看个人资料' : '前往登录'}}"
    >
      <view class="member-card__avatar-shell">
        <image
          class="member-card__avatar"
          src="{{avatarUrl}}"
          mode="{{avatarMode}}"
        />
        <image
          wx:if="{{loggedIn}}"
          class="member-card__vip-mark"
          src="/assets/icons/member-v-diamond.svg"
          mode="aspectFit"
          aria-label="钻石 V 会员"
        />
      </view>
      <view class="member-card__body">
        <view class="member-card__identity">
          <view class="member-card__name">{{nickname}}</view>
          <view wx:if="{{loggedIn}}" class="member-card__member-badge" aria-label="金牌会员">
            <image
              class="member-card__member-crown"
              src="/assets/icons/member-crown.svg"
              mode="aspectFit"
              aria-hidden="true"
            />
            <text>金牌会员</text>
          </view>
        </view>
        <view class="member-card__copy">{{memberCopy}}</view>
      </view>
    </view>

    <view class="account-metrics">
      <view
        wx:for="{{accountMetrics}}"
        wx:key="path"
        class="account-metric"
        data-path="{{item.path}}"
        bindtap="onAccountServiceTap"
        hover-class="account-metric--pressed"
        aria-role="button"
        aria-label="{{item.ariaLabel}} {{item.value}}"
      >
        <view class="account-metric__identity">
          <image
            class="account-metric__icon"
            src="{{item.iconPath}}"
            mode="aspectFit"
            aria-hidden="true"
          />
          <text class="account-metric__label">{{item.label}}</text>
        </view>
        <text class="account-metric__value">{{item.value}}</text>
      </view>
    </view>

    <view class="order-center-card">
      <view
        class="order-center-card__heading"
        bindtap="onAllOrdersTap"
        hover-class="order-center-card__heading--pressed"
        aria-role="button"
      >
        <view class="order-center-card__title">我的订单</view>
        <view class="order-center-card__all">
          <text>查看全部订单</text>
          <image
            class="order-center-card__chevron"
            src="/assets/icons/chevron-right-light.svg"
            mode="aspectFit"
            aria-hidden="true"
          />
        </view>
      </view>
      <view class="order-shortcuts">
        <view
          wx:for="{{orderShortcuts}}"
          wx:key="label"
          class="order-shortcut"
          data-group="{{item.group}}"
          data-path="{{item.path}}"
          bindtap="onOrderShortcutTap"
          hover-class="order-shortcut--pressed"
          aria-role="button"
          aria-label="{{item.ariaLabel || item.label}}"
        >
          <view class="order-shortcut__visual">
            <image
              class="order-shortcut__icon"
              src="{{item.iconPath}}"
              mode="aspectFit"
              aria-hidden="true"
            />
            <text wx:if="{{item.badge}}" class="order-shortcut__badge">{{item.badge}}</text>
          </view>
          <text class="order-shortcut__label">{{item.label}}</text>
        </view>
      </view>
    </view>

    <view class="service-card">
      <view class="service-card__title">常用服务</view>
      <view class="service-grid">
        <view
          wx:for="{{serviceItems}}"
          wx:key="label"
          class="service-item"
          data-path="{{item.path}}"
          data-kind="{{item.kind}}"
          bindtap="onServiceItemTap"
          hover-class="service-item--pressed"
          aria-role="button"
          aria-label="{{item.label}}"
        >
          <image
            class="service-item__icon"
            src="{{item.iconPath}}"
            mode="aspectFit"
            aria-hidden="true"
          />
          <text class="service-item__label">{{item.label}}</text>
        </view>
      </view>
    </view>
  </view>
</view>
