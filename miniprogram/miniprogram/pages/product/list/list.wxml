<view class="catalog-page">
  <navigation-bar
    back="{{true}}"
    background="#F3F3F7"
    color="#2E1D16"
    show-divider="{{false}}"
    wide-center="{{true}}"
  >
    <view
      slot="center"
      class="catalog-search"
      bindtap="onSearchTap"
      hover-class="catalog-search--pressed"
      aria-role="button"
      aria-label="{{initialKeyword ? '修改搜索关键词' : '搜索商品'}}"
    >
      <image
        class="catalog-search__icon"
        src="/assets/icons/search-material-symbols-iconify.svg"
        mode="aspectFit"
        aria-hidden="true"
      />
      <input
        class="catalog-search__text"
        value="{{initialKeyword}}"
        disabled="{{true}}"
        placeholder="输入商品名称"
        placeholder-style="color: #b9b9b9;"
        aria-hidden="true"
      />
    </view>
  </navigation-bar>
  <catalog-browser
    wx:if="{{ready}}"
    id="catalog"
    class="catalog-results"
    scroll-page="{{true}}"
    initial-category-id="{{initialCategoryId}}"
    initial-keyword="{{initialKeyword}}"
    bindproductselect="onProductSelect"
    bindcartchange="onCartChange"
  />
</view>
