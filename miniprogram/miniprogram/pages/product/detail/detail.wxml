<view class="detail-page">
  <view class="hero-navigation">
    <navigation-bar
      title=""
      back="{{true}}"
      loading="{{loading}}"
      background="transparent"
      color="#2E1D16"
      show-divider="{{false}}"
      round-back="{{true}}"
    >
      <view wx:if="{{detail}}" slot="right" class="hero-actions">
        <button
          class="hero-action {{favorited ? 'hero-action--active' : ''}}"
          bindtap="onFavoriteToggle"
          disabled="{{favoriteLoading}}"
          hover-class="hero-action--pressed"
          hover-stay-time="80"
          aria-label="{{favorited ? '取消收藏' : '收藏商品'}}"
        >
          <image
            class="hero-action__icon hero-action__icon--favorite {{favorited ? 'hero-action__icon--favorited' : ''}}"
            src="{{favorited ? '/assets/icons/favorite-clarity-solid.svg' : '/assets/icons/favorite-clarity-line.svg'}}"
            mode="aspectFit"
          />
        </button>
        <button
          class="hero-action"
          open-type="share"
          hover-class="hero-action--pressed"
          hover-stay-time="80"
          aria-label="分享商品"
        >
          <image class="hero-action__icon" src="/assets/icons/share-weui-outlined.svg" mode="aspectFit" />
        </button>
      </view>
    </navigation-bar>
  </view>

  <view wx:if="{{!loaded && loading}}" class="detail-state">
    <ui-state type="loading" title="正在准备商品详情" description="好味道马上呈现" />
  </view>

  <view wx:elif="{{!loaded && errorText}}" class="detail-state">
    <ui-state
      type="error"
      title="商品详情加载失败"
      description="{{errorText}}"
      action-text="重新加载"
      bindaction="onRetry"
    />
  </view>

  <block wx:elif="{{detail}}">
    <scroll-view
      class="detail-scroll"
      scroll-y="{{true}}"
      enhanced="{{true}}"
      bounces="{{true}}"
      enable-passive="{{true}}"
      show-scrollbar="{{false}}"
      refresher-enabled="{{false}}"
    >
      <view class="detail-scroll-content">
      <view class="hero-section">
        <product-gallery images="{{galleryImages}}" />
      </view>

      <view class="detail-content">
      <product-summary
        detail="{{detail}}"
        price-text="{{priceText}}"
        price-integer-text="{{priceIntegerText}}"
        price-decimal-text="{{priceDecimalText}}"
        original-price-text="{{originalPriceText}}"
        has-original-price="{{hasOriginalPrice}}"
        wholesale-applied="{{wholesaleApplied}}"
        sales-text="已售 {{detail.salesCount}}+"
      />

      <view class="commerce-card">
        <view class="commerce-info-group">
          <view
            wx:if="{{wholesaleSummary}}"
            class="commerce-row commerce-row--detail-info commerce-row--interactive"
            data-sheet="wholesale"
            bindtap="onInfoSheetOpen"
            aria-role="button"
            aria-label="查看全部批发价格"
          >
            <image class="commerce-icon" src="/assets/icons/sell-outline-rounded.svg" mode="aspectFit" />
            <view class="commerce-value">
              <text class="commerce-value__text">{{wholesaleSummary}}</text>
            </view>
            <image class="commerce-action-icon" src="/assets/icons/chevron-right-detail.svg" mode="aspectFit" />
          </view>
          <view
            wx:if="{{weightParameter || spiceParameter || otherParameterViews.length}}"
            class="commerce-row commerce-row--detail-info commerce-row--parameters commerce-row--interactive"
            data-sheet="parameters"
            bindtap="onInfoSheetOpen"
            aria-role="button"
            aria-label="查看商品参数"
          >
            <image class="commerce-icon" src="/assets/icons/tune-outline-rounded.svg" mode="aspectFit" />
            <scroll-view
              class="commerce-parameter-scroll"
              scroll-x="{{true}}"
              enhanced="{{true}}"
              show-scrollbar="{{false}}"
              enable-flex="{{true}}"
            >
              <view class="commerce-parameter-track">
                <view wx:if="{{weightParameter}}" class="commerce-parameter-item">
                  <text>净含量：{{weightParameter.value}}</text>
                </view>
                <view wx:if="{{weightParameter && weightParameter.fact.servingText}}" class="commerce-parameter-item">
                  <text>{{weightParameter.fact.servingText}}</text>
                </view>
                <view wx:if="{{spiceParameter}}" class="commerce-parameter-item">
                  <text>辣度：</text>
                  <text class="commerce-parameter-spice commerce-parameter-spice--{{spiceParameter.fact.spiceTone}}">{{spiceParameter.value}}</text>
                  <view class="commerce-parameter-icons">
                    <image
                      wx:for="{{spiceParameter.fact.spiceIconIndexes}}"
                      wx:for-item="iconIndex"
                      wx:key="*this"
                      class="commerce-parameter-icon"
                      src="{{spiceParameter.fact.iconPath}}"
                      mode="aspectFit"
                    />
                  </view>
                </view>
                <view wx:for="{{otherParameterViews}}" wx:key="id" class="commerce-parameter-item">
                  <text>{{item.name}}：{{item.value}}</text>
                </view>
              </view>
            </scroll-view>
            <image class="commerce-action-icon" src="/assets/icons/chevron-right-detail.svg" mode="aspectFit" />
          </view>
          <view
            class="commerce-row commerce-row--detail-info commerce-row--address commerce-row--interactive"
            bindtap="onAddressTap"
            aria-role="button"
            aria-label="选择收货地址"
          >
            <image class="commerce-icon" src="/assets/icons/location-on-outline-rounded.svg" mode="aspectFit" />
            <view class="commerce-value {{selectedAddress ? '' : 'commerce-value--empty'}}">
              <view class="commerce-address-copy">
                <text class="commerce-value__text commerce-value__text--address">{{selectedAddress ? selectedAddress.formattedAddress : '请选择收货地址'}}</text>
                <text wx:if="{{selectedAddress && selectedAddress.isDefault}}" class="address-default-tag commerce-default-tag">默认</text>
              </view>
            </view>
            <image class="commerce-action-icon" src="/assets/icons/chevron-right-detail.svg" mode="aspectFit" />
          </view>
          <view
            wx:if="{{guaranteeSummary}}"
            class="commerce-row commerce-row--detail-info commerce-row--interactive"
            data-sheet="guarantee"
            bindtap="onInfoSheetOpen"
            aria-role="button"
            aria-label="查看服务保障"
          >
            <image class="commerce-icon" src="/assets/icons/verified-user-outline-rounded.svg" mode="aspectFit" />
            <view class="commerce-value">
              <text class="commerce-value__text">{{guaranteeSummary}}</text>
            </view>
            <image class="commerce-action-icon" src="/assets/icons/chevron-right-detail.svg" mode="aspectFit" />
          </view>
          <view
            wx:if="{{freightSummary}}"
            class="commerce-row commerce-row--detail-info commerce-row--interactive"
            data-sheet="freight"
            bindtap="onInfoSheetOpen"
            aria-role="button"
            aria-label="查看运费说明"
          >
            <image class="commerce-icon" src="/assets/icons/local-shipping-outline-rounded.svg" mode="aspectFit" />
            <view class="commerce-value">
              <text class="commerce-value__text">{{freightSummary}}</text>
            </view>
            <image class="commerce-action-icon" src="/assets/icons/chevron-right-detail.svg" mode="aspectFit" />
          </view>
        </view>
      </view>

      <view class="detail-card review-card">
        <view class="review-card__header">
          <view>
            <text class="section-heading__title">买家评价</text>
            <text class="review-card__count">{{reviewSummary.reviewCountPlusText}}</text>
          </view>
          <button
            class="review-card__all"
            bindtap="onReviewListOpen"
            aria-label="查看全部买家评价"
          >
            <text>{{reviewSummary.hasReviews ? reviewSummary.goodRateText : '暂无评价'}}</text>
            <image class="review-card__chevron" src="/assets/icons/chevron-right-light.svg" mode="aspectFit" />
          </button>
        </view>

        <view wx:if="{{reviewPreviewLoading}}" class="review-inline-state">
          <text>正在加载真实买家评价…</text>
        </view>
        <view wx:elif="{{reviewPreviewErrorText}}" class="review-inline-state review-inline-state--error">
          <text>{{reviewPreviewErrorText}}</text>
          <button class="review-inline-retry" bindtap="onReviewPreviewRetry">重试</button>
        </view>
        <view wx:elif="{{reviewPreview.length}}" class="review-preview-list">
          <view
            wx:for="{{reviewPreview}}"
            wx:for-item="review"
            wx:key="id"
            class="review-item"
          >
            <view class="review-item__main">
              <view class="review-item__header">
                <view class="review-user">
                  <view class="review-user__avatar-shell">
                    <image
                      class="review-user__avatar review-user__avatar--image"
                      src="/assets/images/profile-default-avatar.png"
                      mode="aspectFill"
                      aria-label="买家头像"
                    />
                    <image
                      class="review-user__avatar-frame"
                      src="/assets/images/member-avatar-frame-v.png"
                      mode="aspectFit"
                      aria-hidden="true"
                    />
                  </view>
                  <view class="review-user__copy">
                    <text class="review-user__name">{{review.reviewerName}}</text>
                  </view>
                </view>
              </view>
              <text class="review-item__content {{review.hasContent ? '' : 'review-item__content--empty'}}">{{review.hasContent ? review.content : '此用户没有填写文字评价'}}</text>
            </view>
            <view
              wx:if="{{review.hasImages}}"
              class="review-preview-media"
              data-review-id="{{review.id}}"
              data-image-url="{{review.previewImageUrl}}"
              bindtap="onReviewImagePreview"
              aria-role="button"
              aria-label="查看买家上传的 {{review.imageCount}} 张图片"
            >
              <image
                class="review-preview-media__image"
                src="{{review.previewImageUrl}}"
                mode="aspectFill"
              />
              <text class="review-preview-media__count">{{review.imageCount}}</text>
            </view>
          </view>
        </view>
        <view wx:else class="review-empty-preview">
          <text class="review-empty-preview__title">还没有买家评价</text>
          <text class="review-empty-preview__description">完成订单后，欢迎分享真实体验</text>
        </view>

      </view>

      <view wx:if="{{detail.detailHtml}}" class="detail-card rich-detail">
        <view class="section-heading">
          <text class="section-heading__title">商品详情</text>
        </view>
        <rich-text nodes="{{detail.detailHtml}}" />
      </view>
      </view>
      </view>
    </scroll-view>

    <view class="purchase-bar">
      <view class="purchase-utilities">
        <button class="utility-action" bindtap="onCustomerServiceTap" aria-label="联系客服">
          <view class="utility-icon-frame">
            <image class="utility-icon utility-icon--support" src="/assets/icons/support-agent-outline-rounded.svg" mode="aspectFit" />
          </view>
          <text class="utility-label">客服</text>
        </button>
        <button class="utility-action" bindtap="onGoToCart" aria-label="前往购物车">
          <view class="utility-icon-frame">
            <image class="utility-icon" src="/assets/icons/shopping-cart-brand.svg" mode="aspectFit" />
          </view>
          <text class="utility-label">购物车</text>
        </button>
      </view>
      <view class="purchase-actions">
        <view
          wx:if="{{detail.saleState === 'SOLD_OUT'}}"
          class="purchase-sold-out"
          aria-role="text"
          aria-label="暂时售空"
        >
          <text class="purchase-sold-out__title">暂时售空</text>
        </view>
        <block wx:else>
          <button
            class="purchase-action purchase-action--cart"
            data-mode="CART"
            bindtap="onOpenPurchase"
          >加入购物车</button>
          <button
            class="purchase-action purchase-action--buy"
            data-mode="BUY"
            bindtap="onOpenPurchase"
          >立即购买</button>
        </block>
      </view>
    </view>
  </block>

  <view
    wx:if="{{purchaseSheetOpen}}"
    class="sheet-mask purchase-sheet-mask {{purchaseSheetClosing ? 'sheet-mask--closing' : ''}}"
    catchtap="onClosePurchaseSheet"
    catchtouchmove="onPreventMove"
  >
    <view class="sheet-panel sheet-panel--purchase {{purchaseSheetClosing ? 'sheet-panel--closing' : ''}}" catchtap="onPreventMove">
      <block>
        <view class="purchase-sheet-header">
          <view wx:if="{{purchaseImageUrl}}" class="purchase-image-wrap">
            <image
              class="purchase-image"
              src="{{purchaseImageUrl}}"
              mode="aspectFill"
            />
            <button
              class="image-preview-button purchase-image-preview"
              catchtap="onPreviewPurchaseImage"
              aria-label="放大查看当前商品图片"
            >
              <image class="image-preview-button__icon" src="/assets/icons/zoom-in-material-symbols.svg" mode="aspectFit" />
            </button>
          </view>
          <view class="purchase-sheet-summary">
            <view wx:if="{{priceText}}" class="sheet-price">
              <text class="sheet-price__currency">¥</text>
              <text class="sheet-price__integer">{{priceIntegerText}}</text>
              <text class="sheet-price__decimal">{{priceDecimalText}}</text>
            </view>
            <text wx:if="{{hasOriginalPrice}}" class="sheet-original-price">¥{{originalPriceText}}</text>
            <text wx:if="{{selectedSkuName}}" class="selected-spec">已选：{{selectedSkuName}}</text>
            <text wx:if="{{wholesaleHint}}" class="sheet-wholesale-hint">{{wholesaleHint}}</text>
          </view>
          <button class="sheet-close" bindtap="onClosePurchaseSheet" aria-label="关闭规格选择">
            <image class="sheet-close__icon" src="/assets/icons/close-material-symbols.svg" mode="aspectFit" />
          </button>
        </view>

        <scroll-view
          class="purchase-sheet-scroll"
          scroll-y="{{true}}"
          enhanced="{{true}}"
          bounces="{{true}}"
          enable-passive="{{true}}"
          show-scrollbar="{{false}}"
        >
          <view class="purchase-sheet-scroll-content">
          <view wx:if="{{specificationGroups.length}}" class="sheet-section sheet-section--specifications">
            <view
              wx:for="{{specificationGroups}}"
              wx:for-item="group"
              wx:key="key"
              class="specification-group"
            >
              <view class="specification-group__header">
                <text class="sheet-section-title">{{group.name}}</text>
                <button
                  wx:if="{{group.hasImages}}"
                  class="specification-view-toggle"
                  catchtap="onSpecificationImageModeToggle"
                  aria-label="{{specificationImageMode === 'list' ? '切换为规格大图' : '切换为规格列表'}}"
                >
                  <image
                    class="specification-view-toggle__icon"
                    src="{{specificationImageMode === 'list' ? '/assets/icons/view-grid-outline.svg' : '/assets/icons/view-list-rounded.svg'}}"
                    mode="aspectFit"
                  />
                </button>
              </view>
              <view class="specification-options {{group.hasImages && specificationImageMode === 'image' ? 'specification-options--image' : ''}}">
                <view
                  wx:for="{{group.options}}"
                  wx:for-item="option"
                  wx:key="key"
                  class="specification-option {{option.hasImage ? 'specification-option--with-image' : ''}} {{group.hasImages && specificationImageMode === 'image' ? 'specification-option--image-mode' : ''}} {{option.selected ? 'specification-option--selected' : ''}} {{option.disabled ? 'specification-option--disabled' : ''}}"
                  data-spec-name="{{group.name}}"
                  data-spec-value="{{option.value}}"
                  bindtap="onSheetSpecificationSelect"
                  aria-role="button"
                  aria-label="{{group.name}}：{{option.value}}{{option.disabled ? '，暂不可选' : ''}}"
                >
                  <view wx:if="{{option.hasImage}}" class="specification-image-frame">
                    <image
                      class="specification-option__image"
                      src="{{option.imageUrl}}"
                      mode="aspectFill"
                    />
                    <button
                      wx:if="{{group.hasImages && specificationImageMode === 'image'}}"
                      class="image-preview-button specification-image-preview"
                      data-image-url="{{option.imageUrl}}"
                      catchtap="onPreviewSpecificationImage"
                      aria-label="放大查看{{option.value}}规格图片"
                    >
                      <image class="image-preview-button__icon" src="/assets/icons/zoom-in-material-symbols.svg" mode="aspectFit" />
                    </button>
                  </view>
                  <text class="specification-option__text">{{option.value}}</text>
                  <text wx:if="{{option.disabled}}" class="specification-option__sold-out">售罄</text>
                </view>
              </view>
            </view>
          </view>
          <view wx:if="{{wholesaleTiers.length}}" class="sheet-section">
            <view class="sheet-section-heading">
              <text class="sheet-section-title">批发价</text>
              <text class="sheet-section-note">点击自动补足对应数量</text>
            </view>
            <view class="wholesale-shortcuts">
              <view
                wx:for="{{wholesaleTiers}}"
                wx:key="minQuantity"
                class="wholesale-shortcut {{item.active ? 'wholesale-shortcut--active' : ''}}"
                data-quantity="{{item.minQuantity}}"
                bindtap="onWholesaleQuantityTap"
                aria-role="button"
                aria-label="选择{{item.minQuantity}}件批发价，每件{{item.priceText}}元"
              >
                <text class="wholesale-shortcut__quantity">{{item.minQuantity}}件起</text>
                <text class="wholesale-shortcut__price">¥{{item.priceText}}/件</text>
              </view>
            </view>
          </view>

          <view class="sheet-section quantity-section">
            <view>
              <text class="sheet-section-title">购买数量</text>
              <text class="quantity-note">达到门槛自动享受对应批发价</text>
            </view>
            <view class="quantity-control">
              <view
                class="quantity-button {{quantity <= 1 ? 'quantity-button--disabled' : ''}}"
                bindtap="onQuantityMinus"
                aria-role="button"
                aria-label="减少数量"
              >−</view>
              <text class="quantity-value">{{quantity}}</text>
              <view
                class="quantity-button {{quantityMax <= 0 || quantity >= quantityMax ? 'quantity-button--disabled' : ''}}"
                bindtap="onQuantityPlus"
                aria-role="button"
                aria-label="增加数量"
              >＋</view>
            </view>
          </view>
          </view>
        </scroll-view>

        <view class="sheet-footer">
          <button
            class="sheet-confirm sheet-confirm--{{purchaseMode === 'CART' ? 'cart' : 'buy'}} {{!selectedSkuId || confirmLoading ? 'sheet-confirm--disabled' : ''}}"
            disabled="{{!selectedSkuId || confirmLoading}}"
            loading="{{confirmLoading}}"
            bindtap="onPurchaseConfirm"
          >{{purchaseActionText}}</button>
        </view>
      </block>

    </view>
  </view>

  <view
    wx:if="{{activeSheet}}"
    class="sheet-mask {{activeSheet === 'reviews' ? 'sheet-mask--reviews' : ''}} {{sheetClosing ? 'sheet-mask--closing' : ''}}"
    catchtap="onCloseSheet"
    catchtouchmove="onPreventMove"
  >
    <view class="sheet-panel {{sheetClosing ? 'sheet-panel--closing' : ''}} {{activeSheet === 'address' ? 'sheet-panel--address' : ''}} {{activeSheet === 'parameters' ? 'sheet-panel--parameters' : ''}} {{activeSheet === 'guarantee' ? 'sheet-panel--guarantee' : ''}} {{activeSheet === 'freight' ? 'sheet-panel--freight' : ''}} {{activeSheet === 'wholesale' ? 'sheet-panel--wholesale' : ''}} {{activeSheet === 'reviews' ? 'sheet-panel--reviews' : ''}}" catchtap="onPreventMove">

      <block wx:if="{{activeSheet === 'address'}}">
        <view class="parameter-sheet-header address-sheet-header">
          <text class="parameter-sheet-title">选择收货地址</text>
          <button class="sheet-close" bindtap="onCloseSheet" aria-label="关闭收货地址选择">
            <image class="sheet-close__icon" src="/assets/icons/close-material-symbols.svg" mode="aspectFit" />
          </button>
        </view>
        <text class="address-sheet-intro">请选择已保存的地址</text>

        <scroll-view
          class="address-sheet-scroll"
          scroll-y="{{true}}"
          enhanced="{{true}}"
          bounces="{{true}}"
          enable-passive="{{true}}"
          show-scrollbar="{{false}}"
        >
          <view wx:if="{{addressLoading && !addressLoaded}}" class="address-sheet-state">
            <text>正在加载收货地址…</text>
          </view>
          <view wx:elif="{{addressErrorText && !addresses.length}}" class="address-sheet-state address-sheet-state--error">
            <text>{{addressErrorText}}</text>
            <button class="address-retry" bindtap="onAddressRetry">重新加载</button>
          </view>
          <view wx:elif="{{!addresses.length}}" class="address-sheet-state">
            <text class="address-sheet-state__title">还没有收货地址</text>
            <text>新增后即可在这里选择</text>
          </view>
          <view wx:else class="address-options">
            <view wx:if="{{addressErrorText}}" class="address-inline-error">
              <text>{{addressErrorText}}</text>
              <button bindtap="onAddressRetry">重试</button>
            </view>
            <view
              wx:for="{{addresses}}"
              wx:key="id"
              class="address-option {{selectedAddress && selectedAddress.id === item.id ? 'address-option--selected' : ''}}"
              data-id="{{item.id}}"
              bindtap="onAddressSelect"
              aria-role="button"
              aria-label="选择{{item.receiverName}}的收货地址"
            >
              <view class="address-option__check">
                <image
                  wx:if="{{selectedAddress && selectedAddress.id === item.id}}"
                  class="address-option__check-icon"
                  src="/assets/icons/check-rounded-material-symbols-iconify.svg"
                  mode="aspectFit"
                  aria-hidden="true"
                />
              </view>
              <view class="address-option__body">
                <text class="address-option__detail">{{item.formattedAddress}}</text>
                <view class="address-option__receiver">
                  <text wx:if="{{item.isDefault}}" class="address-default-tag">默认</text>
                  <text>{{item.receiverName}}</text>
                  <text>{{item.receiverPhone}}</text>
                </view>
              </view>
            </view>
          </view>
        </scroll-view>

        <view class="address-sheet-footer">
          <button class="add-address-action" bindtap="onAddAddress">新增地址</button>
        </view>
      </block>

      <block wx:elif="{{activeSheet === 'parameters'}}">
        <view class="parameter-sheet-header">
          <text class="parameter-sheet-title">商品参数</text>
          <button class="sheet-close" bindtap="onCloseSheet" aria-label="关闭商品参数">
            <image class="sheet-close__icon" src="/assets/icons/close-material-symbols.svg" mode="aspectFit" />
          </button>
        </view>

        <scroll-view
          class="parameter-sheet-scroll"
          scroll-y="{{true}}"
          enhanced="{{true}}"
          bounces="{{true}}"
          enable-passive="{{true}}"
          show-scrollbar="{{false}}"
        >
          <view class="parameter-sheet-list">
            <view wx:for="{{parameterViews}}" wx:key="id" class="parameter-sheet-row">
              <text class="parameter-sheet-label">{{item.name}}</text>
              <view class="parameter-sheet-value">
                <text class="{{item.fact.kind === 'spice' ? 'parameter-sheet-spice parameter-sheet-spice--' + item.fact.spiceTone : ''}}">{{item.value}}</text>
                <view wx:if="{{item.fact.kind === 'spice'}}" class="parameter-sheet-spice-icons">
                  <image
                    wx:for="{{item.fact.spiceIconIndexes}}"
                    wx:for-item="iconIndex"
                    wx:key="*this"
                    class="parameter-sheet-spice-icon"
                    src="{{item.fact.iconPath}}"
                    mode="aspectFit"
                  />
                </view>
              </view>
            </view>
            <view wx:if="{{weightParameter && weightParameter.fact.servingText}}" class="parameter-sheet-row">
              <text class="parameter-sheet-label">适合人数</text>
              <text class="parameter-sheet-value">{{weightParameter.fact.servingText}}</text>
            </view>
            <text class="parameter-sheet-tip">商品参数仅供参考，具体信息以实物为准</text>
          </view>
        </scroll-view>

        <view class="parameter-sheet-footer">
          <button class="parameter-sheet-confirm" bindtap="onCloseSheet">我知道了</button>
        </view>
      </block>

      <block wx:elif="{{activeSheet === 'guarantee'}}">
        <view class="parameter-sheet-header">
          <text class="parameter-sheet-title">安心保障</text>
          <button class="sheet-close" bindtap="onCloseSheet" aria-label="关闭安心保障">
            <image class="sheet-close__icon" src="/assets/icons/close-material-symbols.svg" mode="aspectFit" />
          </button>
        </view>
        <scroll-view
          class="info-sheet-scroll info-sheet-scroll--fill"
          scroll-y="{{true}}"
          enhanced="{{true}}"
          bounces="{{true}}"
          enable-passive="{{true}}"
        >
          <view wx:for="{{detail.guaranteeServices}}" wx:key="id" class="guarantee-item">
            <image wx:if="{{item.icon}}" class="guarantee-icon" src="{{item.icon}}" mode="aspectFit" />
            <view class="guarantee-copy">
              <text class="guarantee-name">{{item.termsName}}</text>
              <text class="guarantee-description">{{item.contentDescription}}</text>
            </view>
          </view>
        </scroll-view>
        <view class="parameter-sheet-footer">
          <button class="parameter-sheet-confirm" bindtap="onCloseSheet">我知道了</button>
        </view>
      </block>

      <block wx:elif="{{activeSheet === 'freight'}}">
        <view class="parameter-sheet-header">
          <text class="parameter-sheet-title">运费说明</text>
          <button class="sheet-close" bindtap="onCloseSheet" aria-label="关闭运费说明">
            <image class="sheet-close__icon" src="/assets/icons/close-material-symbols.svg" mode="aspectFit" />
          </button>
        </view>
        <view class="freight-detail">
          <view class="freight-detail-row">
            <text class="freight-detail-label">模板</text>
            <text class="freight-detail-value">{{detail.freightTemplate.name}}</text>
          </view>
          <view class="freight-detail-row">
            <text class="freight-detail-label">计费方式</text>
            <text class="freight-detail-value">{{freightChargeText}}</text>
          </view>
          <text class="freight-tip">最终运费会根据收货地址在结算时确认。</text>
        </view>
        <view class="parameter-sheet-footer">
          <button class="parameter-sheet-confirm" bindtap="onCloseSheet">我知道了</button>
        </view>
      </block>

      <block wx:elif="{{activeSheet === 'wholesale'}}">
        <view class="parameter-sheet-header">
          <text class="parameter-sheet-title">批发价格</text>
          <button class="sheet-close" bindtap="onCloseSheet" aria-label="关闭批发价格">
            <image class="sheet-close__icon" src="/assets/icons/close-material-symbols.svg" mode="aspectFit" />
          </button>
        </view>

        <scroll-view
          class="parameter-sheet-scroll"
          scroll-y="{{true}}"
          enhanced="{{true}}"
          bounces="{{true}}"
          enable-passive="{{true}}"
          show-scrollbar="{{false}}"
        >
          <view class="parameter-sheet-list">
            <view wx:for="{{wholesaleTiers}}" wx:key="minQuantity" class="parameter-sheet-row">
              <text class="parameter-sheet-label">{{item.minQuantity}} 件起</text>
              <text class="parameter-sheet-value">¥{{item.priceText}} / 件</text>
            </view>
            <text class="parameter-sheet-tip">购买数量达到门槛后，系统会自动使用对应单价</text>
          </view>
        </scroll-view>

        <view class="parameter-sheet-footer">
          <button class="parameter-sheet-confirm" bindtap="onCloseSheet">我知道了</button>
        </view>
      </block>

      <block wx:elif="{{activeSheet === 'reviews'}}">
        <view class="review-list-header">
          <text class="parameter-sheet-title">买家评价</text>
          <button class="sheet-close" bindtap="onCloseSheet" aria-label="关闭买家评价">
            <image class="sheet-close__icon" src="/assets/icons/close-material-symbols.svg" mode="aspectFit" />
          </button>
        </view>

        <view class="review-filter-bar">
          <button
            class="review-filter-chip {{reviewFilter === 'ALL' ? 'review-filter-chip--active' : ''}}"
            data-review-filter="ALL"
            bindtap="onReviewFilterSelect"
          >全部 {{reviewSummary.reviewCount}}</button>
          <button
            class="review-filter-chip {{reviewFilter === 'WITH_IMAGES' ? 'review-filter-chip--active' : ''}}"
            data-review-filter="WITH_IMAGES"
            bindtap="onReviewFilterSelect"
          >有图 {{reviewSummary.imageReviewCount}}</button>
          <button
            class="review-filter-chip {{reviewFilter === 'GOOD' ? 'review-filter-chip--active' : ''}}"
            data-review-filter="GOOD"
            bindtap="onReviewFilterSelect"
          >好评 {{reviewSummary.goodReviewCount}}</button>
          <button
            class="review-filter-chip {{reviewFilter === 'CRITICAL' ? 'review-filter-chip--active' : ''}}"
            data-review-filter="CRITICAL"
            bindtap="onReviewFilterSelect"
          >中/差评 {{reviewSummary.criticalReviewCount}}</button>
        </view>

        <view class="review-toolbar">
          <view class="review-toolbar__truth">
            <image src="/assets/icons/verified-user-outline-rounded.svg" mode="aspectFit" />
            <text>好评优先展示真实评价</text>
          </view>
          <view class="review-toolbar__actions">
            <button
              class="review-toolbar-action {{reviewSort === 'LATEST' ? 'review-toolbar-action--active' : ''}}"
              bindtap="onReviewSortTap"
            >
              <text>最新</text>
              <image src="/assets/icons/chat-history.svg" mode="aspectFit" />
            </button>
            <button
              wx:if="{{reviewSpecOptions.length}}"
              class="review-toolbar-action {{reviewSpecText ? 'review-toolbar-action--active' : ''}}"
              bindtap="onReviewSpecOpen"
            >
              <text>{{reviewSpecText || '规格'}}</text>
              <image src="/assets/icons/tune-outline-rounded.svg" mode="aspectFit" />
            </button>
          </view>
        </view>

        <scroll-view
          class="review-sheet-scroll"
          scroll-y="{{true}}"
          enhanced="{{true}}"
          bounces="{{true}}"
          enable-passive="{{true}}"
          show-scrollbar="{{false}}"
          lower-threshold="120"
          bindscrolltolower="onReviewLoadMore"
        >
          <view wx:if="{{reviewLoading && !reviewRecords.length}}" class="review-sheet-state">
            <text>正在加载评价…</text>
          </view>
          <view wx:elif="{{reviewErrorText && !reviewRecords.length}}" class="review-sheet-state">
            <text>{{reviewErrorText}}</text>
            <button class="review-state-action" bindtap="onReviewListRetry">重新加载</button>
          </view>
          <view wx:elif="{{!reviewRecords.length}}" class="review-sheet-state">
            <text class="review-sheet-state__title">当前筛选暂无评价</text>
            <text>换一个分类或规格看看</text>
          </view>
          <view wx:else class="review-sheet-list">
            <view
              wx:for="{{reviewRecords}}"
              wx:for-item="review"
              wx:key="id"
              class="review-item review-item--sheet"
            >
              <view class="review-item__header">
                <view class="review-user">
                  <view class="review-user__avatar-shell">
                    <image
                      class="review-user__avatar review-user__avatar--image"
                      src="/assets/images/profile-default-avatar.png"
                      mode="aspectFill"
                      aria-label="买家头像"
                    />
                    <image
                      class="review-user__avatar-frame"
                      src="/assets/images/member-avatar-frame-v.png"
                      mode="aspectFit"
                      aria-hidden="true"
                    />
                  </view>
                  <text class="review-user__name">{{review.reviewerName}}</text>
                </view>
              </view>
              <view class="review-item__purchase-line">
                <view class="review-rating-summary" aria-label="评价 {{review.rating}} 星">
                  <text wx:if="{{review.ratingLabel}}" class="review-rating-summary__label">{{review.ratingLabel}}</text>
                  <view class="review-rating-summary__stars">
                    <image
                      wx:for="{{review.stars}}"
                      wx:for-item="star"
                      wx:key="value"
                      wx:if="{{star.filled}}"
                      class="review-rating-summary__star"
                      src="/assets/icons/favorite-clarity-solid.svg"
                      mode="aspectFit"
                      aria-hidden="true"
                    />
                  </view>
                </view>
                <text class="review-purchase-spec">{{review.purchaseSpecText ? '｜已购 ' + review.purchaseSpecText : '｜已购'}}</text>
              </view>
              <view class="review-item__content-wrap {{review.contentExpanded ? 'review-item__content-wrap--expanded' : ''}}">
                <text class="review-item__content {{review.hasContent ? '' : 'review-item__content--empty'}}">{{review.hasContent ? review.content : '此用户没有填写文字评价'}}<text
                    wx:if="{{review.contentCollapsible && review.contentExpanded}}"
                    class="review-content-collapse"
                    data-review-id="{{review.id}}"
                    bindtap="onReviewContentToggle"
                  > 收起</text></text>
                <text
                  wx:if="{{review.hasContent}}"
                  class="review-item__content-measure"
                  data-review-id="{{review.id}}"
                  aria-hidden="true"
                >{{review.content}}</text>
                <button
                  wx:if="{{review.contentCollapsible && !review.contentExpanded}}"
                  class="review-content-toggle"
                  data-review-id="{{review.id}}"
                  bindtap="onReviewContentToggle"
                >…展开</button>
              </view>
              <view wx:if="{{review.hasImages}}" class="review-image-gallery">
                <image
                  wx:for="{{review.images}}"
                  wx:for-item="reviewImage"
                  wx:key="fileId"
                  class="review-image-gallery__image"
                  src="{{reviewImage.url}}"
                  mode="aspectFill"
                  data-review-id="{{review.id}}"
                  data-image-url="{{reviewImage.url}}"
                  bindtap="onReviewImagePreview"
                />
              </view>
            </view>
            <view class="review-list-footer">
              <text wx:if="{{reviewLoading}}">正在加载更多…</text>
              <button wx:elif="{{reviewErrorText}}" class="review-state-action" bindtap="onReviewLoadMore">加载失败，点击重试</button>
              <text wx:elif="{{reviewHasMore}}">继续上拉加载</text>
              <text wx:else>已显示全部 {{reviewTotal}} 条评价</text>
            </view>
          </view>
        </scroll-view>

      </block>

    </view>
  </view>
</view>

<view
  wx:if="{{reviewSpecSheetOpen}}"
  class="review-spec-mask"
  catchtap="onReviewSpecClose"
  catchtouchmove="onPreventMove"
>
  <view class="review-spec-panel" catchtap="onPreventMove">
    <view class="review-spec-header">
      <text class="parameter-sheet-title">筛选规格</text>
      <button class="sheet-close" bindtap="onReviewSpecClose" aria-label="关闭规格筛选">
        <image class="sheet-close__icon" src="/assets/icons/close-material-symbols.svg" mode="aspectFit" />
      </button>
    </view>
    <view class="review-spec-product">
      <image
        class="review-spec-product__image"
        src="{{purchaseImageUrl}}"
        mode="aspectFill"
      />
      <text class="review-spec-product__title">{{detail.title}}</text>
    </view>
    <text class="review-spec-hint">请选择：商品规格</text>
    <scroll-view
      class="review-spec-scroll"
      scroll-y="{{true}}"
      enhanced="{{true}}"
      show-scrollbar="{{false}}"
    >
      <text class="review-spec-group-title">商品规格</text>
      <view class="review-spec-options">
        <button
          wx:for="{{reviewSpecOptions}}"
          wx:key="value"
          class="review-spec-option {{reviewSpecDraftText === item.value ? 'review-spec-option--active' : ''}}"
          data-review-spec-text="{{item.value}}"
          bindtap="onReviewSpecSelect"
        >{{item.label}}</button>
        <text wx:if="{{!reviewSpecOptions.length}}" class="review-spec-empty">当前商品暂无可筛选规格</text>
      </view>
    </scroll-view>
    <view class="review-spec-footer">
      <button class="review-spec-reset" bindtap="onReviewSpecReset">重置</button>
      <button class="review-spec-confirm" bindtap="onReviewSpecConfirm">确定</button>
    </view>
  </view>
</view>
