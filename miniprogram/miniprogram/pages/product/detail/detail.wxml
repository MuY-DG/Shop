<view class="detail-page">
  <view class="hero-navigation">
    <navigation-bar
      title=""
      back="{{true}}"
      loading="{{loading}}"
      background="transparent"
      color="#2E1D16"
      show-divider="{{false}}"
      round-back="{{true}}"
    >
      <view wx:if="{{detail}}" slot="right" class="hero-actions">
        <button
          class="hero-action {{favorited ? 'hero-action--active' : ''}}"
          bindtap="onFavoriteToggle"
          disabled="{{favoriteLoading}}"
          hover-class="hero-action--pressed"
          hover-stay-time="80"
          aria-label="{{favorited ? '取消收藏' : '收藏商品'}}"
        >
          <image
            class="hero-action__icon hero-action__icon--favorite {{favorited ? 'hero-action__icon--favorited' : ''}}"
            src="{{favorited ? '/assets/icons/favorite-clarity-solid.svg' : '/assets/icons/favorite-clarity-line.svg'}}"
            mode="aspectFit"
          />
        </button>
        <button
          class="hero-action"
          open-type="share"
          hover-class="hero-action--pressed"
          hover-stay-time="80"
          aria-label="分享商品"
        >
          <image class="hero-action__icon" src="/assets/icons/share-weui-outlined.svg" mode="aspectFit" />
        </button>
      </view>
    </navigation-bar>
  </view>

  <view wx:if="{{!loaded && loading}}" class="detail-state">
    <ui-state type="loading" title="正在准备商品详情" description="好味道马上呈现" />
  </view>

  <view wx:elif="{{!loaded && errorText}}" class="detail-state">
    <ui-state
      type="error"
      title="商品详情加载失败"
      description="{{errorText}}"
      action-text="重新加载"
      bindaction="onRetry"
    />
  </view>

  <block wx:elif="{{detail}}">
    <scroll-view
      class="detail-scroll"
      scroll-y="{{true}}"
      enhanced="{{true}}"
      bounces="{{true}}"
      enable-passive="{{true}}"
      show-scrollbar="{{false}}"
      refresher-enabled="{{false}}"
    >
      <view class="detail-scroll-content">
      <view class="hero-section">
        <product-gallery images="{{galleryImages}}" />
      </view>

      <view class="detail-content">
      <product-summary
        detail="{{detail}}"
        price-text="{{priceText}}"
        price-integer-text="{{priceIntegerText}}"
        price-decimal-text="{{priceDecimalText}}"
        original-price-text="{{originalPriceText}}"
        has-original-price="{{hasOriginalPrice}}"
        wholesale-applied="{{wholesaleApplied}}"
        sales-text="已售 {{detail.salesCount}}+"
        weight-parameter="{{weightParameter}}"
        spice-parameter="{{spiceParameter}}"
        other-parameters="{{otherParameterViews}}"
      />

      <scroll-view
        wx:if="{{benefitItems.length}}"
        class="benefit-scroll"
        scroll-x="{{true}}"
        enhanced="{{true}}"
        show-scrollbar="{{false}}"
        enable-flex="{{true}}"
      >
        <view class="benefit-track">
          <view
            wx:for="{{benefitItems}}"
            wx:key="key"
            class="benefit-card {{item.interactive ? 'benefit-card--interactive' : 'benefit-card--plain'}}"
            data-sheet="{{item.sheet}}"
            bindtap="onInfoSheetOpen"
            aria-role="{{item.interactive ? 'button' : 'text'}}"
            aria-label="{{item.text}}"
          >
            <image wx:if="{{item.iconUrl}}" class="benefit-icon" src="{{item.iconUrl}}" mode="aspectFit" />
            <text class="benefit-text">{{item.text}}</text>
          </view>
        </view>
      </scroll-view>

      <view class="commerce-card">
        <view
          wx:if="{{wholesaleSummary}}"
          class="commerce-row commerce-row--interactive"
          data-sheet="wholesale"
          bindtap="onInfoSheetOpen"
          aria-role="button"
          aria-label="查看全部批发价格"
        >
          <image class="commerce-icon" src="/assets/icons/sell-outline-rounded.svg" mode="aspectFit" />
          <view class="commerce-value">
            <text class="commerce-value__text">{{wholesaleSummary}}</text>
          </view>
          <image class="commerce-action-icon" src="/assets/icons/chevron-right-light.svg" mode="aspectFit" />
        </view>
        <view
          class="commerce-row commerce-row--address commerce-row--interactive"
          bindtap="onAddressTap"
          aria-role="button"
          aria-label="选择收货地址"
        >
          <image class="commerce-icon" src="/assets/icons/location-on-outline-rounded.svg" mode="aspectFit" />
          <view class="commerce-value {{selectedAddress ? '' : 'commerce-value--empty'}}">
            <text wx:if="{{selectedAddress && selectedAddress.isDefault}}" class="commerce-default-tag">默认</text>
            <text class="commerce-value__text">{{selectedAddress ? selectedAddress.formattedAddress : '请选择收货地址'}}</text>
          </view>
          <image class="commerce-action-icon" src="/assets/icons/chevron-right-light.svg" mode="aspectFit" />
        </view>
      </view>

      <view class="detail-card review-card">
        <view class="review-card__header">
          <view>
            <text class="section-heading__title">买家评价</text>
            <text class="review-card__count">{{reviewSummary.reviewCountText}}</text>
          </view>
          <button
            class="review-card__all"
            bindtap="onReviewListOpen"
            aria-label="查看全部买家评价"
          >
            <text>{{reviewSummary.hasReviews ? reviewSummary.goodRateText : '暂无评价'}}</text>
            <image class="review-card__chevron" src="/assets/icons/chevron-right-light.svg" mode="aspectFit" />
          </button>
        </view>

        <view wx:if="{{reviewPreviewLoading}}" class="review-inline-state">
          <text>正在加载真实买家评价…</text>
        </view>
        <view wx:elif="{{reviewPreviewErrorText}}" class="review-inline-state review-inline-state--error">
          <text>{{reviewPreviewErrorText}}</text>
          <button class="review-inline-retry" bindtap="onReviewPreviewRetry">重试</button>
        </view>
        <view wx:elif="{{reviewPreview.length}}" class="review-preview-list">
          <view
            wx:for="{{reviewPreview}}"
            wx:for-item="review"
            wx:key="id"
            class="review-item"
          >
            <view class="review-item__header">
              <view class="review-user">
                <image
                  class="review-user__avatar review-user__avatar--image"
                  src="/assets/images/profile-default-avatar.png"
                  mode="aspectFill"
                  aria-label="买家头像"
                />
                <view class="review-user__copy">
                  <text class="review-user__name">{{review.reviewerName}}</text>
                  <text class="review-item__content {{review.hasContent ? '' : 'review-item__content--empty'}}">{{review.hasContent ? review.content : '此用户没有填写文字评价'}}</text>
                </view>
              </view>
            </view>
          </view>
        </view>
        <view wx:else class="review-empty-preview">
          <text class="review-empty-preview__title">还没有买家评价</text>
          <text class="review-empty-preview__description">完成订单后，欢迎分享真实体验</text>
        </view>

      </view>

      <view wx:if="{{detail.detailHtml}}" class="detail-card rich-detail">
        <view class="section-heading">
          <text class="section-heading__title">商品详情</text>
        </view>
        <rich-text nodes="{{detail.detailHtml}}" />
      </view>
      </view>
      </view>
    </scroll-view>

    <view class="purchase-bar">
      <view class="purchase-utilities">
        <button class="utility-action" bindtap="onCustomerServiceTap" aria-label="联系客服">
          <view class="utility-icon-frame">
            <image class="utility-icon utility-icon--support" src="/assets/icons/support-agent-outline-rounded.svg" mode="aspectFit" />
          </view>
          <text class="utility-label">客服</text>
        </button>
        <button class="utility-action" bindtap="onGoToCart" aria-label="前往购物车">
          <view class="utility-icon-frame">
            <image class="utility-icon" src="/assets/icons/shopping-cart-brand.svg" mode="aspectFit" />
          </view>
          <text class="utility-label">购物车</text>
        </button>
      </view>
      <view class="purchase-actions">
        <view
          wx:if="{{detail.saleState === 'SOLD_OUT'}}"
          class="purchase-sold-out"
          aria-role="text"
          aria-label="暂时售空"
        >
          <text class="purchase-sold-out__title">暂时售空</text>
        </view>
        <block wx:else>
          <button
            class="purchase-action purchase-action--cart"
            data-mode="CART"
            bindtap="onOpenPurchase"
          >加入购物车</button>
          <button
            class="purchase-action purchase-action--buy"
            data-mode="BUY"
            bindtap="onOpenPurchase"
          >立即购买</button>
        </block>
      </view>
    </view>
  </block>

  <view
    wx:if="{{activeSheet}}"
    class="sheet-mask {{sheetClosing ? 'sheet-mask--closing' : ''}}"
    catchtap="onCloseSheet"
    catchtouchmove="onPreventMove"
  >
    <view class="sheet-panel {{sheetClosing ? 'sheet-panel--closing' : ''}} {{activeSheet === 'purchase' ? 'sheet-panel--purchase' : ''}} {{activeSheet === 'address' ? 'sheet-panel--address' : ''}} {{activeSheet === 'reviews' ? 'sheet-panel--reviews' : ''}}" catchtap="onPreventMove">
      <block wx:if="{{activeSheet === 'purchase'}}">
        <view class="purchase-sheet-header">
          <view wx:if="{{purchaseImageUrl}}" class="purchase-image-wrap">
            <image
              class="purchase-image"
              src="{{purchaseImageUrl}}"
              mode="aspectFill"
            />
            <button
              class="image-preview-button purchase-image-preview"
              catchtap="onPreviewPurchaseImage"
              aria-label="放大查看当前商品图片"
            >
              <image class="image-preview-button__icon" src="/assets/icons/zoom-in-material-symbols.svg" mode="aspectFit" />
            </button>
          </view>
          <view class="purchase-sheet-summary">
            <view wx:if="{{priceText}}" class="sheet-price">
              <text class="sheet-price__currency">¥</text>
              <text class="sheet-price__integer">{{priceIntegerText}}</text>
              <text class="sheet-price__decimal">{{priceDecimalText}}</text>
            </view>
            <text wx:if="{{hasOriginalPrice}}" class="sheet-original-price">¥{{originalPriceText}}</text>
            <text class="selected-spec">已选：{{selectedSkuName}}</text>
            <text wx:if="{{wholesaleHint}}" class="sheet-wholesale-hint">{{wholesaleHint}}</text>
          </view>
          <button class="sheet-close" bindtap="onCloseSheet" aria-label="关闭规格选择">
            <image class="sheet-close__icon" src="/assets/icons/close-material-symbols.svg" mode="aspectFit" />
          </button>
        </view>

        <scroll-view
          class="purchase-sheet-scroll"
          scroll-y="{{true}}"
          enhanced="{{true}}"
          bounces="{{true}}"
          enable-passive="{{true}}"
          show-scrollbar="{{false}}"
        >
          <view class="purchase-sheet-scroll-content">
          <view wx:if="{{specificationGroups.length}}" class="sheet-section sheet-section--specifications">
            <view
              wx:for="{{specificationGroups}}"
              wx:for-item="group"
              wx:key="key"
              class="specification-group"
            >
              <view class="specification-group__header">
                <text class="sheet-section-title">{{group.name}}</text>
                <button
                  wx:if="{{group.hasImages}}"
                  class="specification-view-toggle"
                  catchtap="onSpecificationImageModeToggle"
                  aria-label="{{specificationImageMode === 'list' ? '切换为规格大图' : '切换为规格列表'}}"
                >
                  <image
                    class="specification-view-toggle__icon"
                    src="{{specificationImageMode === 'list' ? '/assets/icons/view-grid-outline.svg' : '/assets/icons/view-list-rounded.svg'}}"
                    mode="aspectFit"
                  />
                </button>
              </view>
              <view class="specification-options {{group.hasImages && specificationImageMode === 'image' ? 'specification-options--image' : ''}}">
                <view
                  wx:for="{{group.options}}"
                  wx:for-item="option"
                  wx:key="key"
                  class="specification-option {{option.hasImage ? 'specification-option--with-image' : ''}} {{group.hasImages && specificationImageMode === 'image' ? 'specification-option--image-mode' : ''}} {{option.selected ? 'specification-option--selected' : ''}} {{option.disabled ? 'specification-option--disabled' : ''}}"
                  data-spec-name="{{group.name}}"
                  data-spec-value="{{option.value}}"
                  bindtap="onSheetSpecificationSelect"
                  aria-role="button"
                  aria-label="{{group.name}}：{{option.value}}{{option.disabled ? '，暂不可选' : ''}}"
                >
                  <view wx:if="{{option.hasImage}}" class="specification-image-frame">
                    <image
                      class="specification-option__image"
                      src="{{option.imageUrl}}"
                      mode="aspectFill"
                    />
                    <button
                      wx:if="{{group.hasImages && specificationImageMode === 'image'}}"
                      class="image-preview-button specification-image-preview"
                      data-image-url="{{option.imageUrl}}"
                      catchtap="onPreviewSpecificationImage"
                      aria-label="放大查看{{option.value}}规格图片"
                    >
                      <image class="image-preview-button__icon" src="/assets/icons/zoom-in-material-symbols.svg" mode="aspectFit" />
                    </button>
                  </view>
                  <text class="specification-option__text">{{option.value}}</text>
                  <text wx:if="{{option.disabled}}" class="specification-option__sold-out">售罄</text>
                </view>
              </view>
            </view>
          </view>
          <view wx:if="{{wholesaleTiers.length}}" class="sheet-section">
            <view class="sheet-section-heading">
              <text class="sheet-section-title">批发价</text>
              <text class="sheet-section-note">点击自动补足对应数量</text>
            </view>
            <view class="wholesale-shortcuts">
              <view
                wx:for="{{wholesaleTiers}}"
                wx:key="minQuantity"
                class="wholesale-shortcut {{item.active ? 'wholesale-shortcut--active' : ''}}"
                data-quantity="{{item.minQuantity}}"
                bindtap="onWholesaleQuantityTap"
                aria-role="button"
                aria-label="选择{{item.minQuantity}}件批发价，每件{{item.priceText}}元"
              >
                <text class="wholesale-shortcut__quantity">{{item.minQuantity}}件起</text>
                <text class="wholesale-shortcut__price">¥{{item.priceText}}/件</text>
              </view>
            </view>
          </view>

          <view class="sheet-section quantity-section">
            <view>
              <text class="sheet-section-title">购买数量</text>
              <text class="quantity-note">达到门槛自动享受对应批发价</text>
            </view>
            <view class="quantity-control">
              <view
                class="quantity-button {{quantity <= 1 ? 'quantity-button--disabled' : ''}}"
                bindtap="onQuantityMinus"
                aria-role="button"
                aria-label="减少数量"
              >−</view>
              <text class="quantity-value">{{quantity}}</text>
              <view
                class="quantity-button {{quantityMax <= 0 || quantity >= quantityMax ? 'quantity-button--disabled' : ''}}"
                bindtap="onQuantityPlus"
                aria-role="button"
                aria-label="增加数量"
              >＋</view>
            </view>
          </view>
          </view>
        </scroll-view>

        <view class="sheet-footer">
          <button
            class="sheet-confirm sheet-confirm--{{purchaseMode === 'CART' ? 'cart' : 'buy'}} {{!selectedSkuId || confirmLoading ? 'sheet-confirm--disabled' : ''}}"
            disabled="{{!selectedSkuId || confirmLoading}}"
            loading="{{confirmLoading}}"
            bindtap="onPurchaseConfirm"
          >{{purchaseActionText}}</button>
        </view>
      </block>

      <block wx:elif="{{activeSheet === 'address'}}">
        <view class="info-sheet-header address-sheet-header">
          <view>
            <text class="info-sheet-title">选择收货地址</text>
            <text class="info-sheet-intro">请选择已保存的地址</text>
          </view>
          <button class="sheet-close" bindtap="onCloseSheet" aria-label="关闭收货地址选择">
            <image class="sheet-close__icon" src="/assets/icons/close-material-symbols.svg" mode="aspectFit" />
          </button>
        </view>

        <scroll-view
          class="address-sheet-scroll"
          scroll-y="{{true}}"
          enhanced="{{true}}"
          bounces="{{true}}"
          enable-passive="{{true}}"
          show-scrollbar="{{false}}"
        >
          <view wx:if="{{addressLoading && !addressLoaded}}" class="address-sheet-state">
            <text>正在加载收货地址…</text>
          </view>
          <view wx:elif="{{addressErrorText && !addresses.length}}" class="address-sheet-state address-sheet-state--error">
            <text>{{addressErrorText}}</text>
            <button class="address-retry" bindtap="onAddressRetry">重新加载</button>
          </view>
          <view wx:elif="{{!addresses.length}}" class="address-sheet-state">
            <text class="address-sheet-state__title">还没有收货地址</text>
            <text>新增后即可在这里选择</text>
          </view>
          <view wx:else class="address-options">
            <view wx:if="{{addressErrorText}}" class="address-inline-error">
              <text>{{addressErrorText}}</text>
              <button bindtap="onAddressRetry">重试</button>
            </view>
            <view
              wx:for="{{addresses}}"
              wx:key="id"
              class="address-option {{selectedAddress && selectedAddress.id === item.id ? 'address-option--selected' : ''}}"
              data-id="{{item.id}}"
              bindtap="onAddressSelect"
              aria-role="button"
              aria-label="选择{{item.receiverName}}的收货地址"
            >
              <view class="address-option__check">{{selectedAddress && selectedAddress.id === item.id ? '✓' : ''}}</view>
              <view class="address-option__body">
                <view class="address-option__receiver">
                  <text>{{item.receiverName}}</text>
                  <text>{{item.receiverPhone}}</text>
                  <text wx:if="{{item.isDefault}}" class="address-default-tag">默认</text>
                </view>
                <text class="address-option__detail">{{item.formattedAddress}}</text>
              </view>
            </view>
          </view>
        </scroll-view>

        <view class="address-sheet-footer">
          <button class="add-address-action" bindtap="onAddAddress">新增地址</button>
        </view>
      </block>

      <block wx:elif="{{activeSheet === 'guarantee'}}">
        <view class="info-sheet-header">
          <view>
            <text class="info-sheet-title">安心保障</text>
            <text class="info-sheet-intro">我们用清晰的服务承诺，让每一次下单都更安心。</text>
          </view>
          <button class="sheet-close" bindtap="onCloseSheet" aria-label="关闭安心保障">
            <image class="sheet-close__icon" src="/assets/icons/close-material-symbols.svg" mode="aspectFit" />
          </button>
        </view>
        <scroll-view
          class="info-sheet-scroll"
          scroll-y="{{true}}"
          enhanced="{{true}}"
          bounces="{{true}}"
          enable-passive="{{true}}"
        >
          <view wx:for="{{detail.guaranteeServices}}" wx:key="id" class="guarantee-item">
            <image wx:if="{{item.icon}}" class="guarantee-icon" src="{{item.icon}}" mode="aspectFit" />
            <view class="guarantee-copy">
              <text class="guarantee-name">{{item.termsName}}</text>
              <text class="guarantee-description">{{item.contentDescription}}</text>
            </view>
          </view>
        </scroll-view>
      </block>

      <block wx:elif="{{activeSheet === 'freight'}}">
        <view class="info-sheet-header">
          <view>
            <text class="info-sheet-title">运费说明</text>
            <text class="info-sheet-intro">费用以当前商品绑定的运费模板为准。</text>
          </view>
          <button class="sheet-close" bindtap="onCloseSheet" aria-label="关闭运费说明">
            <image class="sheet-close__icon" src="/assets/icons/close-material-symbols.svg" mode="aspectFit" />
          </button>
        </view>
        <view class="freight-detail">
          <view class="freight-detail-row">
            <text class="freight-detail-label">模板</text>
            <text class="freight-detail-value">{{detail.freightTemplate.name}}</text>
          </view>
          <view class="freight-detail-row">
            <text class="freight-detail-label">计费方式</text>
            <text class="freight-detail-value">{{freightChargeText}}</text>
          </view>
          <text class="freight-tip">最终运费会根据收货地址在结算时确认。</text>
        </view>
      </block>

      <block wx:elif="{{activeSheet === 'wholesale'}}">
        <view class="info-sheet-header">
          <view>
            <text class="info-sheet-title">批发价格</text>
            <text class="info-sheet-intro">购买数量达到门槛后，系统会自动使用对应单价。</text>
          </view>
          <button class="sheet-close" bindtap="onCloseSheet" aria-label="关闭批发价格">
            <image class="sheet-close__icon" src="/assets/icons/close-material-symbols.svg" mode="aspectFit" />
          </button>
        </view>
        <view class="wholesale-table">
          <view wx:for="{{wholesaleTiers}}" wx:key="minQuantity" class="wholesale-table-row">
            <text>{{item.minQuantity}} 件起</text>
            <text class="wholesale-table-price">¥{{item.priceText}} / 件</text>
          </view>
        </view>
      </block>

      <block wx:elif="{{activeSheet === 'reviews'}}">
        <view class="review-sheet-header">
          <view>
            <text class="info-sheet-title">全部评价</text>
            <text class="info-sheet-intro">{{reviewSummary.reviewCountText}} · {{reviewSummary.goodRateText}}</text>
          </view>
          <button class="review-sheet-write" bindtap="onReviewManageOpen">写评价</button>
          <button class="sheet-close" bindtap="onCloseSheet" aria-label="关闭全部评价">
            <image class="sheet-close__icon" src="/assets/icons/close-material-symbols.svg" mode="aspectFit" />
          </button>
        </view>
        <scroll-view
          class="review-sheet-scroll"
          scroll-y="{{true}}"
          enhanced="{{true}}"
          bounces="{{true}}"
          enable-passive="{{true}}"
          show-scrollbar="{{false}}"
          lower-threshold="120"
          bindscrolltolower="onReviewLoadMore"
        >
          <view wx:if="{{reviewLoading && !reviewRecords.length}}" class="review-sheet-state">
            <text>正在加载评价…</text>
          </view>
          <view wx:elif="{{reviewErrorText && !reviewRecords.length}}" class="review-sheet-state">
            <text>{{reviewErrorText}}</text>
            <button class="review-state-action" bindtap="onReviewListRetry">重新加载</button>
          </view>
          <view wx:elif="{{!reviewRecords.length}}" class="review-sheet-state">
            <text class="review-sheet-state__title">暂无评价</text>
            <text>完成订单后即可发布第一条评价</text>
          </view>
          <view wx:else class="review-sheet-list">
            <view
              wx:for="{{reviewRecords}}"
              wx:for-item="review"
              wx:key="id"
              class="review-item review-item--sheet"
            >
              <view class="review-item__header">
                <view class="review-user">
                  <view class="review-user__avatar">{{review.reviewerInitial}}</view>
                  <view class="review-user__copy">
                    <text class="review-user__name">{{review.reviewerName}}</text>
                    <view class="review-stars" aria-label="评分{{review.rating}}星">
                      <text
                        wx:for="{{review.stars}}"
                        wx:for-item="star"
                        wx:key="value"
                        class="review-star {{star.filled ? 'review-star--filled' : ''}}"
                      >★</text>
                    </view>
                  </view>
                </view>
                <text class="review-item__date">{{review.createdAtText}}</text>
              </view>
              <text class="review-item__content {{review.hasContent ? '' : 'review-item__content--empty'}}">
                {{review.hasContent ? review.content : '此用户没有填写文字评价'}}
              </text>
              <view class="review-item__meta">
                <text wx:if="{{review.verifiedPurchase}}" class="review-verified">已购</text>
                <text wx:if="{{review.skuSpecText}}">{{review.skuSpecText}}</text>
              </view>
            </view>
            <view class="review-list-footer">
              <text wx:if="{{reviewLoading}}">正在加载更多…</text>
              <button wx:elif="{{reviewErrorText}}" class="review-state-action" bindtap="onReviewLoadMore">加载失败，点击重试</button>
              <text wx:elif="{{reviewHasMore}}">继续上拉加载</text>
              <text wx:else>已显示全部 {{reviewTotal}} 条评价</text>
            </view>
          </view>
        </scroll-view>
      </block>

      <block wx:elif="{{activeSheet === 'reviewManage'}}">
        <view class="review-sheet-header review-sheet-header--manage">
          <view>
            <text class="info-sheet-title">我的商品评价</text>
            <text class="info-sheet-intro">只有已完成订单可以评价，内容将公开展示。</text>
          </view>
          <button class="sheet-close" bindtap="onCloseSheet" aria-label="关闭评价管理">
            <image class="sheet-close__icon" src="/assets/icons/close-material-symbols.svg" mode="aspectFit" />
          </button>
        </view>
        <scroll-view
          class="review-manage-scroll"
          scroll-y="{{true}}"
          enhanced="{{true}}"
          bounces="{{true}}"
          enable-passive="{{true}}"
          show-scrollbar="{{false}}"
        >
          <view wx:if="{{reviewManagementLoading}}" class="review-sheet-state">
            <text>正在检查可评价订单…</text>
          </view>
          <view wx:elif="{{reviewManagementErrorText}}" class="review-sheet-state">
            <text>{{reviewManagementErrorText}}</text>
            <button class="review-state-action" bindtap="onReviewManagementRetry">重新加载</button>
          </view>
          <block wx:else>
            <view
              wx:if="{{reviewFormMode === 'update' || reviewOrderItems.length}}"
              class="review-form"
            >
              <view class="review-form__heading">
                <text class="review-form__title">{{reviewFormMode === 'update' ? '修改评价' : '发表评价'}}</text>
                <button
                  wx:if="{{reviewFormMode === 'update'}}"
                  class="review-form__cancel"
                  bindtap="onReviewEditCancel"
                >取消修改</button>
              </view>

              <view wx:if="{{reviewFormMode === 'create'}}" class="review-form__field">
                <text class="review-form__label">选择已完成订单</text>
                <scroll-view
                  class="review-order-scroll"
                  scroll-x="{{true}}"
                  enhanced="{{true}}"
                  show-scrollbar="{{false}}"
                  enable-flex="{{true}}"
                >
                  <view class="review-order-track">
                    <view
                      wx:for="{{reviewOrderItems}}"
                      wx:for-item="orderItem"
                      wx:key="orderItemId"
                      class="review-order-option {{reviewSelectedOrderItemId === orderItem.orderItemId ? 'review-order-option--selected' : ''}}"
                      data-order-item-id="{{orderItem.orderItemId}}"
                      bindtap="onReviewOrderSelect"
                      aria-role="button"
                      aria-label="选择{{orderItem.label}}订单"
                    >
                      <text class="review-order-option__spec">{{orderItem.label}}</text>
                      <text class="review-order-option__date">完成于 {{orderItem.completedAtText}}</text>
                    </view>
                  </view>
                </scroll-view>
              </view>

              <view class="review-form__field">
                <text class="review-form__label">商品评分</text>
                <view class="review-form-stars">
                  <button
                    wx:for="{{reviewFormStars}}"
                    wx:for-item="star"
                    wx:key="value"
                    class="review-form-star {{star.filled ? 'review-form-star--filled' : ''}}"
                    data-rating="{{star.value}}"
                    bindtap="onReviewRatingSelect"
                    aria-label="评分{{star.value}}星"
                  >★</button>
                  <text class="review-form-rating">{{reviewRating}} 星</text>
                </view>
              </view>

              <view class="review-form__field">
                <view class="review-form__label-row">
                  <text class="review-form__label">评价内容</text>
                  <text class="review-form__counter">{{reviewContent.length}} / 1000</text>
                </view>
                <textarea
                  class="review-textarea"
                  value="{{reviewContent}}"
                  maxlength="1000"
                  auto-height="{{false}}"
                  cursor-spacing="24"
                  placeholder="说说口味、分量、包装或配送体验（选填）"
                  bindinput="onReviewContentInput"
                />
              </view>

              <view class="review-anonymous-row">
                <view>
                  <text class="review-form__label">匿名评价</text>
                  <text class="review-anonymous-row__hint">开启后其他用户看不到你的昵称</text>
                </view>
                <switch
                  checked="{{reviewAnonymous}}"
                  color="#B72B22"
                  bindchange="onReviewAnonymousChange"
                />
              </view>

              <button
                class="review-submit {{reviewSubmitting ? 'review-submit--disabled' : ''}}"
                disabled="{{reviewSubmitting}}"
                loading="{{reviewSubmitting}}"
                bindtap="onReviewSubmit"
              >{{reviewFormMode === 'update' ? '保存修改' : '发布评价'}}</button>
            </view>

            <view wx:if="{{myReviews.length}}" class="my-review-section">
              <text class="review-form__title">已发布评价</text>
              <view
                wx:for="{{myReviews}}"
                wx:for-item="review"
                wx:key="id"
                class="my-review-item"
              >
                <view class="my-review-item__top">
                  <view class="review-stars" aria-label="评分{{review.rating}}星">
                    <text
                      wx:for="{{review.stars}}"
                      wx:for-item="star"
                      wx:key="value"
                      class="review-star {{star.filled ? 'review-star--filled' : ''}}"
                    >★</text>
                  </view>
                  <text class="review-item__date">{{review.createdAtText}}</text>
                </view>
                <text class="my-review-item__content">{{review.hasContent ? review.content : '未填写文字评价'}}</text>
                <view class="review-item__meta">
                  <text class="review-verified">已购</text>
                  <text wx:if="{{review.skuSpecText}}">{{review.skuSpecText}}</text>
                  <text wx:if="{{review.anonymous}}">匿名发布</text>
                </view>
                <view class="my-review-item__actions">
                  <button
                    class="my-review-action"
                    data-review-id="{{review.id}}"
                    bindtap="onReviewEdit"
                  >修改</button>
                  <button
                    class="my-review-action my-review-action--danger"
                    data-review-id="{{review.id}}"
                    disabled="{{reviewDeletingId === review.id}}"
                    loading="{{reviewDeletingId === review.id}}"
                    bindtap="onReviewDelete"
                  >删除</button>
                </view>
              </view>
            </view>

            <view wx:if="{{!reviewOrderItems.length && reviewFormMode !== 'update'}}" class="review-sheet-state review-sheet-state--compact">
              <text class="review-sheet-state__title">暂无待评价订单</text>
              <text>{{myReviews.length ? '新的订单完成后可继续评价' : '购买并完成订单后即可发表评价'}}</text>
            </view>
          </block>
        </scroll-view>
      </block>
    </view>
  </view>
</view>
