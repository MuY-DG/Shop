<view class="refund-result-page">
  <navigation-bar title="{{phase === 'processing' ? '退款进度' : '退款结果'}}" back="{{true}}" color="#1c1c1e" background="#f6f6f6" show-divider="{{false}}" />
  <view wx:if="{{errorText}}" class="result-state" bindtap="onRetry" aria-role="button"><ui-state type="error" title="当前服务繁忙" description="{{errorText}}" /></view>
  <view wx:elif="{{phase === 'processing'}}" class="result-content" aria-label="{{processingTitle}}">
    <view class="result-loader" aria-hidden="true"></view>
    <view class="result-title">{{processingTitle}}</view>
  </view>
  <view wx:elif="{{phase === 'success' && detail}}" class="result-content">
    <view class="result-check"><image class="result-check__icon" src="/assets/icons/check-rounded-material-symbols-iconify.svg" mode="aspectFit" aria-hidden="true" /></view>
    <view class="result-title">退款成功</view>
    <view class="result-description">退款已原路退回</view>
    <view class="result-amount">{{detail.refundAmountText}}</view>
    <view class="result-note">具体到账时间以支付渠道为准</view>
    <view wx:if="{{detail.refundedAtText}}" class="result-note">{{detail.refundedAtText}}</view>
  </view>
  <view wx:elif="{{detail}}" class="result-content">
    <view class="result-attention">!</view>
    <view class="result-title">{{detail.statusText}}</view>
    <view class="result-description">{{detail.statusDescription}}</view>
  </view>
  <view wx:if="{{detail && (phase !== 'processing' || errorText)}}" class="result-actions">
    <button class="result-button result-button--secondary" bindtap="onDetailTap">退款详情</button>
    <button class="result-button" bindtap="onOrderTap">查看原订单</button>
  </view>
</view>
