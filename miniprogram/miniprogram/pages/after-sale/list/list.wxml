<view class="after-sale-list-page">
  <navigation-bar
    title="退款售后"
    back="{{true}}"
    color="#2E1D16"
    background="#f6f6f6"
    show-divider="{{false}}"
  />

  <scroll-view
    class="after-sale-list-scroll"
    scroll-y="{{true}}"
    enhanced="{{true}}"
    bounces="{{false}}"
    enable-passive="{{true}}"
    show-scrollbar="{{false}}"
    refresher-enabled="{{true}}"
    refresher-triggered="{{contentRefreshing}}"
    refresher-background="#f6f6f6"
    lower-threshold="160"
    bindrefresherrefresh="onContentRefresh"
    bindscrolltolower="onReachBottom"
  >
  <view class="list-content">
    <view wx:if="{{!loaded && loading}}" class="list-state">
      <ui-state type="loading" title="正在加载售后记录" description="请稍候" />
    </view>
    <view wx:elif="{{!loaded && errorText}}" class="list-state">
      <ui-state type="error" title="售后记录加载失败" description="{{errorText}}" action-text="重新加载" bindaction="onRetry" />
    </view>
    <view wx:elif="{{loaded && !records.length}}" class="list-state list-state--empty">
      <ui-state type="empty" icon="/assets/icons/empty-after-sale.svg" description="暂无售后记录" />
    </view>

    <block wx:else>
      <view wx:if="{{errorText}}" class="inline-error">
        <text>{{errorText}}</text>
        <button bindtap="onRetry">重试</button>
      </view>
      <view
        wx:for="{{records}}"
        wx:key="id"
        class="record-card"
        data-id="{{item.id}}"
        bindtap="onRecordTap"
        hover-class="record-card--pressed"
        hover-stay-time="80"
        aria-role="button"
      >
        <view class="record-card__heading">
          <view>
            <view class="record-card__order">售后 {{item.afterSaleNo}}</view>
            <view class="record-card__time">订单 {{item.orderNo}}</view>
            <view class="record-card__time">申请于 {{item.createdAtText}}</view>
          </view>
          <view class="record-card__status record-card__status--{{item.statusTone}}">{{item.statusText}}</view>
        </view>
        <view class="record-card__body">
          <view>
            <view class="record-card__type">{{item.typeText}}</view>
            <view class="record-card__reason">{{item.reason}}</view>
          </view>
          <view class="record-card__amount">{{item.requestedAmountText}}</view>
        </view>
        <view class="record-card__footer">
          <text>{{item.statusDescription}}</text>
          <text class="record-card__chevron">›</text>
        </view>
      </view>
      <view wx:if="{{loadingMore}}" class="page-tip">正在加载更多</view>
      <view wx:elif="{{records.length && !hasMore}}" class="page-tip">已显示全部售后记录</view>
    </block>
  </view>
  </scroll-view>
</view>
