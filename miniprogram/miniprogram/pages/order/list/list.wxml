<view class="orders-page">
  <navigation-bar
    title="我的订单"
    back="{{true}}"
    home="{{true}}"
    background="#FAF2E4"
    color="#2E1D16"
    loading="{{loaded && loading}}"
  />

  <scroll-view class="status-tabs" scroll-x="{{true}}" enhanced="{{true}}" show-scrollbar="{{false}}">
    <view class="status-tabs__inner">
      <view
        wx:for="{{tabs}}"
        wx:key="value"
        class="status-tab {{activeGroup === item.value ? 'status-tab--active' : ''}}"
        data-group="{{item.value}}"
        bindtap="onTabTap"
      >{{item.label}}</view>
    </view>
  </scroll-view>

  <view class="orders-content">
    <view wx:if="{{!loaded && loading}}" class="orders-state">
      <ui-state type="loading" title="正在加载订单" description="订单状态与支付结果正在同步" />
    </view>
    <view wx:elif="{{!loaded && errorText}}" class="orders-state">
      <ui-state type="error" title="订单加载失败" description="{{errorText}}" action-text="重新加载" bindaction="onRetry" />
    </view>
    <view wx:elif="{{loaded && !orders.length}}" class="orders-state">
      <ui-state type="empty" title="暂无相关订单" description="下单后可在这里继续支付和查看进度" />
    </view>

    <block wx:else>
      <view wx:if="{{errorText}}" class="inline-error">
        <text>{{errorText}}</text>
        <button bindtap="onRetry">重试</button>
      </view>
      <view
        wx:for="{{orders}}"
        wx:key="orderId"
        class="order-card"
        data-id="{{item.orderId}}"
        bindtap="onOrderTap"
      >
        <view class="order-card__heading">
          <view>
            <view class="order-card__no">订单 {{item.orderNo}}</view>
            <view class="order-card__time">{{item.createdAtText}}</view>
          </view>
          <text class="order-status order-status--{{item.statusTone}}">{{item.statusText}}</text>
        </view>
        <view class="order-card__product">
          <view class="order-card__product-mark">灶</view>
          <view class="order-card__product-body">
            <view class="order-card__title">{{item.productTitle || '订单商品'}}</view>
            <view class="order-card__count">{{item.itemCountText}}</view>
          </view>
          <view class="order-card__amount">
            <text>{{item.status === 'PAID' || item.paidAmountCent > 0 ? '实付' : '应付'}}</text>
            <view>{{item.amountText}}</view>
          </view>
        </view>
        <view wx:if="{{item.canPay || item.canConfirmReceipt}}" class="order-card__actions">
          <button
            wx:if="{{item.canCancel}}"
            class="order-action order-action--secondary"
            data-id="{{item.orderId}}"
            disabled="{{actionOrderId}}"
            catchtap="onCancelTap"
          >取消订单</button>
          <button
            wx:if="{{item.canSyncPayment}}"
            class="order-action order-action--secondary"
            data-id="{{item.orderId}}"
            disabled="{{actionOrderId}}"
            catchtap="onSyncTap"
          >同步结果</button>
          <button
            wx:if="{{item.canPay}}"
            class="order-action order-action--primary"
            data-id="{{item.orderId}}"
            loading="{{actionOrderId === item.orderId}}"
            disabled="{{actionOrderId}}"
            catchtap="onPayTap"
          >{{item.paymentActionText}}</button>
          <button
            wx:if="{{item.canConfirmReceipt}}"
            class="order-action order-action--primary"
            data-id="{{item.orderId}}"
            loading="{{actionOrderId === item.orderId}}"
            disabled="{{actionOrderId}}"
            catchtap="onConfirmTap"
          >确认收货</button>
        </view>
      </view>
      <view wx:if="{{loadingMore}}" class="list-footer">正在加载更多…</view>
      <view wx:elif="{{orders.length && !hasMore}}" class="list-footer">没有更多订单了</view>
    </block>
  </view>
</view>
