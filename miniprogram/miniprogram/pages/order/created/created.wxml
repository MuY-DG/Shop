<view class="created-page">
  <navigation-bar
    title="支付成功"
    background="#f6f6f6"
    color="#2E1D16"
    loading="{{loading}}"
  />

  <view class="created-content">
    <view class="success-mark" aria-hidden="true">✓</view>
    <view class="result-title">支付成功</view>
    <view class="result-subtitle">支付已确认，商家将尽快为你安排发货</view>

    <view class="result-amount">
      <text>支付金额</text>
      <view>{{paymentAmountText}}</view>
    </view>

    <view class="order-card">
      <view class="order-row"><text>订单号</text><text>{{orderNo || '已创建'}}</text></view>
      <view class="order-row"><text>订单状态</text><text class="status-tag">{{statusText}}</text></view>
    </view>

    <button class="secondary-action" bindtap="onDetailTap">查看订单详情</button>
    <button class="text-action" bindtap="onHomeTap">返回首页</button>
  </view>
</view>
