<view class="created-page">
  <image
    class="created-background"
    src="../assets/images/payment-success-background.jpg"
    mode="aspectFill"
    aria-hidden="true"
  />

  <navigation-bar
    title=""
    back="{{true}}"
    round-back="{{true}}"
    background="transparent"
    color="#2E1D16"
    show-divider="{{false}}"
  />

  <view class="created-content">
    <image
      class="success-mark"
      src="../assets/images/payment-success-check.png"
      mode="aspectFit"
      aria-hidden="true"
    />
    <view class="result-title">支付成功</view>

    <view class="result-amount">
      <text class="result-amount__label">已成功支付金额</text>
      <text class="result-amount__value">{{paymentAmountText}}</text>
    </view>

    <button
      class="order-action"
      bindtap="onDetailTap"
      hover-class="order-action--pressed"
      hover-stay-time="80"
    >查看订单</button>
    <button
      class="home-action"
      bindtap="onHomeTap"
      hover-class="home-action--pressed"
      hover-stay-time="80"
    >返回首页</button>
  </view>
</view>
