<view class="detail-page">
  <navigation-bar
    title="{{navigationTitle}}"
    back="{{true}}"
    background="#F3F3F7"
    color="#2E1D16"
    loading="{{loaded && loading}}"
  />

  <view class="detail-content">
    <view wx:if="{{!loaded && loading}}" class="detail-state">
      <ui-state type="loading" title="正在读取订单" description="支付与履约状态正在同步" />
    </view>
    <view wx:elif="{{!loaded && errorText}}" class="detail-state">
      <ui-state type="error" title="订单详情加载失败" description="{{errorText}}" action-text="重新加载" bindaction="onRetry" />
    </view>

    <block wx:elif="{{detail}}">
      <view wx:if="{{errorText}}" class="inline-error">
        <text>{{errorText}}</text>
        <button bindtap="onRetry">重试</button>
      </view>

      <view class="status-card status-card--{{detail.statusTone}}">
        <view class="status-card__icon">{{detail.status === 'CLOSED' ? '×' : detail.canPay ? '时' : detail.status === 'COMPLETED' ? '✓' : '灶'}}</view>
        <view>
          <view class="status-card__title">{{detail.statusText}}</view>
          <view wx:if="{{detail.canPay && hasCountdown}}" class="status-card__description">
            请在 <text class="status-card__countdown">{{countdownText}}</text> 内完成支付，超时订单自动取消
          </view>
          <view wx:else class="status-card__description">{{detail.canPay ? '支付时限正在确认，请尽快完成支付' : detail.statusDescription}}</view>
        </view>
      </view>

      <view class="detail-card receiver-card">
        <view class="receiver-card__marker">收</view>
        <view>
          <view class="receiver-card__person">{{detail.receiverName}}　{{detail.receiverPhone}}</view>
          <view class="receiver-card__address">{{detail.receiverAddress}}</view>
        </view>
      </view>

      <view class="detail-card">
        <view class="section-heading">商品清单</view>
        <view
          wx:for="{{detail.items}}"
          wx:key="orderItemId"
          class="detail-item"
        >
          <view class="detail-item__image-shell">
            <image
              wx:if="{{item.hasImage}}"
              class="detail-item__image"
              src="{{item.imageUrl}}"
              mode="aspectFill"
              data-index="{{index}}"
              binderror="onItemImageError"
            />
            <view wx:else class="detail-item__fallback">灶</view>
          </view>
          <view class="detail-item__body">
            <view class="detail-item__title">{{item.productTitle}}</view>
            <view wx:if="{{item.specText}}" class="detail-item__spec">{{item.specText}}</view>
            <view wx:if="{{item.wholesaleText}}" class="detail-item__wholesale">{{item.wholesaleText}}</view>
            <view class="detail-item__price-row">
              <text>{{item.unitPriceText}}</text>
              <text>×{{item.quantity}}</text>
            </view>
            <view class="detail-item__subtotal">小计 {{item.lineAmountText}}</view>
          </view>
        </view>
      </view>

      <view class="detail-card amount-card">
        <view class="section-heading">金额明细</view>
        <view class="amount-row"><text>商品金额</text><text>{{detail.productAmountText}}</text></view>
        <view class="amount-row {{detail.hasWholesaleDiscount ? 'amount-row--discount' : ''}}">
          <text>批发优惠</text>
          <text>{{detail.hasWholesaleDiscount ? '-' + detail.wholesaleDiscountText : '暂无优惠'}}</text>
        </view>
        <view class="amount-row {{detail.hasCouponDiscount ? 'amount-row--discount' : ''}}">
          <text>优惠券<text wx:if="{{detail.couponName}}">（{{detail.couponName}}）</text></text>
          <text>{{detail.hasCouponDiscount ? '-' + detail.couponDiscountText : '未使用'}}</text>
        </view>
        <view class="amount-row"><text>运费</text><text>{{detail.freightText}}</text></view>
      </view>

      <view
        wx:if="{{detail.hasAfterSale}}"
        class="detail-card after-sale-card"
        bindtap="onAfterSaleDetailTap"
        aria-role="button"
      >
        <view class="after-sale-card__heading">
          <view>
            <view class="section-heading">退款售后</view>
            <view class="after-sale-card__meta">{{detail.latestAfterSaleView.typeText}} · {{detail.latestAfterSaleView.requestedAmountText}}</view>
          </view>
          <view class="after-sale-card__status after-sale-card__status--{{detail.latestAfterSaleView.statusTone}}">
            {{detail.latestAfterSaleView.statusText}}
          </view>
        </view>
        <view class="after-sale-card__description">{{detail.latestAfterSaleView.statusDescription}}</view>
        <view class="after-sale-card__link">查看处理进度 <text>›</text></view>
      </view>

      <view class="detail-card order-info">
        <view class="section-heading">订单信息</view>
        <view class="info-row"><text>订单编号</text><text>{{detail.orderNo}}</text></view>
        <view class="info-row"><text>下单时间</text><text>{{detail.createdAtText}}</text></view>
        <view wx:if="{{detail.paidAtText}}" class="info-row"><text>支付时间</text><text>{{detail.paidAtText}}</text></view>
        <view wx:if="{{detail.shippedAtText}}" class="info-row"><text>发货时间</text><text>{{detail.shippedAtText}}</text></view>
        <view wx:if="{{detail.completedAtText}}" class="info-row"><text>完成时间</text><text>{{detail.completedAtText}}</text></view>
        <view wx:if="{{detail.closeReason}}" class="info-row"><text>关闭原因</text><text>{{detail.closeReason}}</text></view>
        <view wx:if="{{detail.transactionId}}" class="info-row"><text>微信支付单号</text><text>{{detail.transactionId}}</text></view>
      </view>
    </block>
  </view>

  <view wx:if="{{detail && (detail.canPay || detail.canConfirmReceipt || detail.canDelete || detail.canRebuy || detail.canApplyAfterSale)}}" class="detail-actions">
    <button
      wx:if="{{detail.canCancel}}"
      class="detail-action detail-action--secondary detail-action--minor"
      loading="{{actionType === 'cancel' || actionType === 'expire'}}"
      disabled="{{actionType !== ''}}"
      bindtap="onCancelTap"
    >取消订单</button>
    <button
      wx:if="{{detail.canPay}}"
      class="detail-action detail-action--primary detail-action--major"
      loading="{{actionType === 'pay'}}"
      disabled="{{actionType !== '' || paymentExpired}}"
      bindtap="onPayTap"
    >支付 {{detail.payableAmountText}}</button>
    <button
      wx:if="{{detail.canDelete}}"
      class="detail-action detail-action--secondary detail-action--minor"
      loading="{{actionType === 'delete'}}"
      disabled="{{actionType !== ''}}"
      bindtap="onDeleteTap"
    >删除订单</button>
    <button
      wx:if="{{detail.canRebuy}}"
      class="detail-action detail-action--primary detail-action--major"
      loading="{{actionType === 'rebuy'}}"
      disabled="{{actionType !== ''}}"
      bindtap="onRebuyTap"
    >再次购买</button>
    <button
      wx:if="{{detail.canApplyAfterSale}}"
      class="detail-action detail-action--secondary detail-action--minor"
      disabled="{{actionType !== ''}}"
      bindtap="onApplyAfterSaleTap"
    >{{detail.afterSaleActionText}}</button>
    <button
      wx:if="{{detail.canConfirmReceipt}}"
      class="detail-action detail-action--primary detail-action--major"
      loading="{{actionType === 'confirm'}}"
      disabled="{{actionType !== ''}}"
      bindtap="onConfirmTap"
    >确认收货</button>
  </view>
</view>
