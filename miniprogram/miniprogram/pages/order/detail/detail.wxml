<view class="detail-page">
  <navigation-bar
    title=""
    back="{{true}}"
    color="#1c1c1e"
    background="#ffffff"
    show-divider="{{false}}"
  >
    <view slot="center" class="status-navigation">
      <image
        wx:if="{{detail}}"
        class="status-navigation__icon"
        src="{{detail.statusIcon}}"
        mode="aspectFit"
        aria-hidden="true"
      />
      <text>{{detail ? detail.statusHeadline : '订单详情'}}</text>
    </view>
  </navigation-bar>

  <view wx:if="{{detail && detail.canPay}}" class="payment-notice">
    <block wx:if="{{hasCountdown}}">
      <text>还剩</text>
      <text class="payment-notice__countdown">
        <text class="payment-notice__digits">{{countdownHours}}</text><text class="payment-notice__separator">:</text><text class="payment-notice__digits">{{countdownMinutes}}</text><text class="payment-notice__separator">:</text><text class="payment-notice__digits">{{countdownSeconds}}</text>
      </text>
      <text>订单自动取消</text>
    </block>
    <text wx:else>支付时限正在确认，请尽快完成支付</text>
  </view>

  <scroll-view
    class="detail-scroll"
    scroll-y="{{true}}"
    enhanced="{{true}}"
    bounces="{{false}}"
    enable-passive="{{true}}"
    show-scrollbar="{{false}}"
  >
    <view class="detail-content">
      <view wx:if="{{!loaded && loading}}" class="detail-state detail-state--skeleton">
        <ui-state type="loading" skeleton-type="record-detail" title="正在读取订单" description="支付与履约状态正在同步" />
      </view>
      <view wx:elif="{{!loaded && errorText}}" class="detail-state">
        <ui-state type="error" title="当前服务繁忙" description="{{errorText}}" />
      </view>

      <block wx:elif="{{detail}}">
        <view wx:if="{{errorText}}" class="inline-error">
          <text>{{errorText}}</text>
          <button bindtap="onRetry">重试</button>
        </view>

        <view class="detail-card receiver-card">
          <image
            class="receiver-card__icon"
            src="/assets/icons/location-on-outline-rounded.svg"
            mode="aspectFit"
            aria-hidden="true"
          />
          <view class="receiver-card__body">
            <view class="receiver-card__person">
              <text>{{detail.receiverName}}</text>
              <text>{{detail.receiverPhoneDisplay}}</text>
            </view>
            <view class="receiver-card__address">{{detail.receiverAddress}}</view>
          </view>
          <button
            wx:if="{{detail.canModifyReceiver}}"
            class="receiver-card__modify"
            disabled="{{actionType !== ''}}"
            bindtap="onModifyTap"
            aria-label="修改订单收货地址"
          >修改</button>
        </view>

        <block wx:for="{{detail.shipmentViews}}" wx:key="shipmentId" wx:for-item="shipment">
        <view
          class="detail-card logistics-card"
          data-shipment-id="{{shipment.shipmentId}}"
          bindtap="onShipmentTap"
        >
          <view class="logistics-card__heading">
            <text class="section-heading">包裹 {{shipment.packageNo}}</text>
            <button
              wx:if="{{shipment.canOpenTracking}}"
              class="logistics-card__view"
              data-shipment-id="{{shipment.shipmentId}}"
              loading="{{logisticsOpening}}"
              disabled="{{logisticsOpening}}"
              catchtap="onOpenLogisticsTap"
              aria-label="{{logisticsOpening ? '正在打开全部物流' : '查看全部物流'}}"
            >{{logisticsOpening ? '打开中' : '查看全部物流'}}</button>
          </view>
          <view class="logistics-card__content">
            <view class="logistics-card__row">
              <text class="logistics-card__label">承运商</text>
              <text class="logistics-card__value">{{shipment.carrierName}}</text>
            </view>
            <view class="logistics-card__row logistics-card__row--tracking">
              <text class="logistics-card__label">运单号</text>
              <text class="logistics-card__tracking-no">{{shipment.trackingNo || '暂不可用'}}</text>
              <button
                wx:if="{{shipment.canCopyTrackingNo}}"
                class="copy-action"
                data-shipment-id="{{shipment.shipmentId}}"
                catchtap="onCopyTrackingNoTap"
                aria-label="复制完整运单号"
              >
                <text class="copy-action__divider">｜</text>
                <text class="copy-action__label">复制</text>
              </button>
            </view>
            <view wx:if="{{shipment.itemsText}}" class="logistics-card__row">
              <text class="logistics-card__label">包裹商品</text>
              <text class="logistics-card__value">{{shipment.itemsText}}</text>
            </view>
            <view wx:if="{{shipment.shippedAtText}}" class="logistics-card__row">
              <text class="logistics-card__label">发货时间</text>
              <text class="logistics-card__value">{{shipment.shippedAtText}}</text>
            </view>
          </view>
          <view wx:if="{{activeShipmentId === shipment.shipmentId}}" class="tracking-panel">
            <view class="tracking-panel__heading">
              <text class="tracking-panel__title">物流轨迹</text>
              <text
                wx:if="{{trackingView}}"
                class="tracking-panel__status tracking-panel__status--{{trackingView.statusTone}}"
              >{{trackingView.statusText}}</text>
            </view>
            <view wx:if="{{trackingLoading}}" class="tracking-panel__empty">
              正在更新物流信息...
            </view>
            <block wx:elif="{{trackingView && trackingView.hasPathItems}}">
              <view
                wx:for="{{trackingView.pathItems}}"
                wx:key="eventKey"
                class="tracking-event {{index === 0 ? 'tracking-event--latest' : ''}}"
              >
                <view class="tracking-event__rail">
                  <view class="tracking-event__dot"></view>
                  <view wx:if="{{index < trackingView.pathItems.length - 1}}" class="tracking-event__line"></view>
                </view>
                <view class="tracking-event__body">
                  <text class="tracking-event__message">{{item.actionMessage}}</text>
                  <text wx:if="{{item.actionTimeText}}" class="tracking-event__time">{{item.actionTimeText}}</text>
                </view>
              </view>
            </block>
            <view wx:else class="tracking-panel__empty">
              {{trackingErrorText || (trackingView ? trackingView.pathStateText : '物流轨迹正在获取中')}}
            </view>
            <view wx:if="{{trackingView && trackingView.lastSyncedAtText}}" class="tracking-panel__synced-at">
              更新于 {{trackingView.lastSyncedAtText}}
            </view>
          </view>
        </view>
        </block>

        <view class="detail-card product-card">
          <view
            wx:for="{{detail.items}}"
            wx:key="orderItemId"
            class="detail-item {{index ? 'detail-item--divided' : ''}}"
            data-spu-id="{{item.spuId}}"
            bindtap="onItemTap"
          >
            <view class="detail-item__image-shell">
              <image
                wx:if="{{item.hasImage}}"
                class="detail-item__image"
                src="{{item.imageUrl}}"
                mode="aspectFill"
                data-index="{{index}}"
                binderror="onItemImageError"
              />
              <image
                wx:else
                class="detail-item__fallback"
                src="/assets/icons/empty-products.svg"
                mode="aspectFit"
                aria-hidden="true"
              />
            </view>
            <view class="detail-item__body">
              <view class="detail-item__title-row">
                <view class="detail-item__title">{{item.productTitle}}</view>
                <view class="detail-item__line-prices">
                  <text wx:if="{{item.hasRetailLineAmount}}" class="detail-item__line-original">{{item.retailLineAmountText}}</text>
                  <text class="detail-item__line-amount">{{item.lineAmountText}}</text>
                </view>
              </view>
              <view wx:if="{{item.specText}}" class="detail-item__spec">{{item.specText}}</view>
              <view class="detail-item__quantity">x{{item.quantity}}</view>
            </view>
          </view>
        </view>

        <view class="detail-card amount-card">
          <view class="amount-row"><text>商品金额</text><text>{{detail.productAmountText}}</text></view>
          <view class="amount-row"><text>运费</text><text>{{detail.freightText}}</text></view>
          <view class="amount-row amount-row--discount">
            <text>批发优惠</text>
            <text>{{detail.hasWholesaleDiscount ? '-' + detail.wholesaleDiscountText : '¥0.00'}}</text>
          </view>
          <view class="amount-row amount-row--discount">
            <text>优惠券<text wx:if="{{detail.couponName}}">（{{detail.couponName}}）</text></text>
            <text>{{detail.hasCouponDiscount ? '-' + detail.couponDiscountText : '¥0.00'}}</text>
          </view>
          <view class="amount-card__divider"></view>
          <view class="amount-total">
            <text>共{{detail.totalQuantity}}件，合计</text>
            <text class="amount-total__value">{{detail.payableAmountText}}</text>
          </view>
        </view>

        <view class="detail-card order-info">
          <view
            class="order-info__heading"
            bindtap="onOrderInfoToggle"
            aria-role="button"
            aria-label="{{orderInfoExpanded ? '收起' : '展开'}}订单信息，共{{detail.orderInfoItemCount}}项"
          >
            <view class="order-info__title">
              <text>订单信息</text>
              <text class="order-info__count">共{{detail.orderInfoItemCount}}项</text>
            </view>
            <image
              class="order-info__toggle {{orderInfoExpanded ? 'order-info__toggle--expanded' : ''}}"
              src="/assets/icons/chevron-right-detail.svg"
              mode="aspectFit"
              aria-hidden="true"
            />
          </view>
          <view wx:if="{{orderInfoExpanded}}" class="order-info__content">
            <view class="info-row info-row--order-no">
              <text>订单编号</text>
              <text class="info-row__order-no">{{detail.orderNo}}</text>
              <button class="copy-action" catchtap="onCopyOrderNoTap">
                <text class="copy-action__divider">｜</text>
                <text class="copy-action__label">复制</text>
              </button>
            </view>
            <view class="info-row"><text>下单时间</text><text>{{detail.createdAtText}}</text></view>
            <view wx:if="{{detail.paidAtText}}" class="info-row"><text>支付时间</text><text>{{detail.paidAtText}}</text></view>
            <view wx:if="{{detail.shippedAtText}}" class="info-row"><text>发货时间</text><text>{{detail.shippedAtText}}</text></view>
            <view wx:if="{{detail.completedAtText}}" class="info-row"><text>完成时间</text><text>{{detail.completedAtText}}</text></view>
            <view wx:if="{{detail.closeReason}}" class="info-row"><text>关闭原因</text><text>{{detail.closeReason}}</text></view>
            <view wx:if="{{detail.transactionId}}" class="info-row"><text>微信支付单号</text><text>{{detail.transactionId}}</text></view>
          </view>
          <view
            class="order-info__service"
            hover-class="order-info__service--pressed"
            hover-stay-time="80"
            bindtap="onCustomerServiceTap"
            aria-role="button"
            aria-label="联系订单客服"
          >
            <view class="order-info__service-icon-frame">
              <image
                class="order-info__service-icon"
                src="/assets/icons/profile-customer-service.svg"
                mode="aspectFit"
                aria-hidden="true"
              />
            </view>
          <text class="order-info__service-label">联系客服</text>
        </view>
        </view>
      </block>
    </view>
  </scroll-view>

  <view wx:if="{{detail && detail.canPay}}" class="payment-bar">
    <view class="payment-utilities">
      <button
        class="payment-tool"
        disabled="{{actionType !== ''}}"
        bindtap="onCustomerServiceTap"
        aria-label="联系订单客服"
      >
        <view class="payment-tool__icon-frame">
          <image class="payment-tool__icon payment-tool__icon--service" src="/assets/icons/profile-customer-service.svg" mode="aspectFit" aria-hidden="true" />
        </view>
        <text class="payment-tool__label">客服</text>
      </button>
      <button
        class="payment-tool"
        disabled="{{actionType !== ''}}"
        bindtap="onCancelTap"
        aria-label="取消订单"
      >
        <view class="payment-tool__icon-frame">
          <image class="payment-tool__icon" src="/assets/icons/cancel-rounded-material-symbols-iconify.svg" mode="aspectFit" aria-hidden="true" />
        </view>
        <text class="payment-tool__label">取消</text>
      </button>
    </view>
    <view class="payment-summary">
      <view class="payment-summary__main">
        <text class="payment-summary__label">支付金额</text>
        <text class="payment-summary__amount">{{detail.payableAmountText}}</text>
        <text wx:if="{{detail.hasTotalDiscount}}" class="payment-summary__original">{{detail.originalPayableAmountText}}</text>
      </view>
      <view class="payment-summary__discount">总计优惠 {{detail.totalDiscountText}}</view>
    </view>
    <button
      class="payment-action"
      loading="{{actionType === 'pay'}}"
      disabled="{{actionType !== '' || paymentExpired}}"
      bindtap="onPayTap"
    ><text class="payment-action__label">继续支付</text></button>
  </view>

  <view wx:elif="{{detail && (detail.canConfirmReceipt || detail.canDelete || detail.canRebuy || detail.showAfterSaleAction)}}" class="detail-actions">
    <button
      wx:if="{{detail.canDelete}}"
      class="detail-action detail-action--secondary detail-action--minor"
      loading="{{actionType === 'delete'}}"
      disabled="{{actionType !== ''}}"
      bindtap="onDeleteTap"
    >删除订单</button>
    <button
      wx:if="{{detail.canRebuy}}"
      class="detail-action detail-action--primary detail-action--major"
      loading="{{actionType === 'rebuy'}}"
      disabled="{{actionType !== ''}}"
      bindtap="onRebuyTap"
    >再次购买</button>
    <button
      wx:if="{{detail.showAfterSaleAction}}"
      class="detail-action detail-action--secondary detail-action--minor"
      disabled="{{actionType !== ''}}"
      bindtap="onAfterSaleActionTap"
    >{{detail.afterSaleActionText}}</button>
    <button
      wx:if="{{detail.canConfirmReceipt}}"
      class="detail-action detail-action--primary detail-action--major"
      loading="{{actionType === 'confirm'}}"
      disabled="{{actionType !== ''}}"
      bindtap="onConfirmTap"
    >确认收货</button>
  </view>
</view>
