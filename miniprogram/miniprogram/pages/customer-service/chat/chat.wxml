<view class="chat-page">
  <navigation-bar
    back="{{true}}"
    color="#111111"
    show-divider="{{true}}"
  >
    <view
      slot="center"
      class="chat-navigation-title"
      aria-label="MuYbaby，客服会话"
    >
      <view class="chat-navigation-title__main">
        <text>MuYbaby</text>
      </view>
      <text class="chat-navigation-title__subtitle">客服会话</text>
    </view>
  </navigation-bar>

  <view wx:if="{{loading && !loaded}}" class="chat-state">
    <ui-state type="loading" title="正在接入客服" description="会话记录正在同步" />
  </view>

  <view wx:elif="{{errorText && !loaded}}" class="chat-state">
    <ui-state
      type="error"
      title="当前服务繁忙"
      description="{{errorText}}"
    />
  </view>

  <block wx:else>
    <scroll-view
      class="message-scroll {{historyAnchoring ? 'message-scroll--history-anchoring' : ''}}"
      scroll-y
      enhanced
      scroll-anchoring="{{historyAnchoring}}"
      enable-passive="{{true}}"
      show-scrollbar="{{false}}"
      upper-threshold="80"
      bindscroll="onMessageListScroll"
      binddragstart="onMessageListDragStart"
      binddragend="onMessageListDragEnd"
      bindscrolltoupper="onScrollToUpper"
      bindscrolltolower="onScrollToLower"
    >
      <view class="message-list">
        <view
          wx:if="{{historyLoading || hasMoreHistory || historyExhausted}}"
          class="history-loader"
        >
          <view wx:if="{{historyLoading}}" class="history-loader__status">
            <view class="message-send-loading__spinner"></view>
          </view>
          <button
            wx:elif="{{hasMoreHistory && !historyButtonSuppressed}}"
            class="history-loader__action"
            bindtap="onHistoryTap"
          >查看更早记录</button>
          <view wx:elif="{{historyExhausted}}" class="history-loader__complete">
            <text>已显示全部记录</text>
          </view>
        </view>

        <block wx:for="{{messages}}" wx:key="renderKey">
          <view wx:if="{{item.showTime}}" class="message-time">{{item.timeText}}</view>

          <view
            wx:if="{{commonQuestionAnchorMessageId === item.messageId}}"
            id="message-{{item.messageId}}"
            class="welcome-message"
          >
            <view class="welcome-greeting">
              <image src="{{item.senderAvatar}}" mode="aspectFill" />
              <text class="welcome-greeting__text">您好，很高兴为您服务！</text>
            </view>
            <view class="welcome-card">
              <text class="welcome-card__title">欢迎您光临本店</text>
              <text class="common-question-opening">{{item.content}}</text>
              <view wx:if="{{showCommonQuestions}}" class="common-question-list">
                <view wx:for="{{commonQuestions}}" wx:key="questionId"
                  class="common-question-item {{commonQuestionSending ? 'common-question-item--disabled' : ''}}"
                  data-question="{{item.question}}" bindtap="onCommonQuestionTap" aria-role="button">
                  <text>{{item.question}}</text>
                  <image src="/assets/icons/chevron-right-light.svg" mode="aspectFit" aria-hidden="true" />
                </view>
              </view>
            </view>
          </view>

          <view
            wx:elif="{{item.isSystem}}"
            id="message-{{item.messageId}}"
            class="system-message"
          >
            <text>{{item.content}}</text>
          </view>

          <view
            wx:else
            id="message-{{item.messageId}}"
            class="message-row {{item.isResourceCard ? 'message-row--card' : ''}} {{item.isMine ? 'message-row--mine' : ''}}"
          >
            <view wx:if="{{!item.isMine && !item.isResourceCard}}" class="message-avatar">
              <image
                src="{{item.senderAvatar}}"
                mode="aspectFill"
              />
            </view>

            <view class="message-body">
              <text wx:if="{{!item.isMine && !item.isResourceCard}}" class="message-sender">{{item.senderName}}</text>

              <view
                wx:if="{{item.messageType === 'TEXT'}}"
                class="message-delivery"
              >
                <button
                  wx:if="{{item.isMine && item.sendFailed}}"
                  class="message-send-error"
                  data-id="{{item.messageId}}"
                  catchtap="onRetryTextTap"
                  aria-label="发送失败，点击重试"
                >
                  <image
                    class="message-send-error__icon"
                    src="/assets/icons/chat-error.svg"
                    mode="aspectFit"
                    aria-hidden="true"
                  />
                </button>
                <view
                  wx:elif="{{item.isMine && item.sending}}"
                  class="message-send-loading"
                  aria-label="消息发送中"
                >
                  <view class="message-send-loading__spinner"></view>
                </view>
                <view
                  class="message-bubble {{item.isMine ? 'message-bubble--mine' : 'message-bubble--other'}}"
                >{{item.content}}</view>
              </view>

              <view
                wx:elif="{{item.messageType === 'IMAGE'}}"
                class="message-delivery"
              >
                <button
                  wx:if="{{item.isMine && item.sendFailed}}"
                  class="message-send-error"
                  data-id="{{item.messageId}}"
                  catchtap="onRetryImageTap"
                  aria-label="图片发送失败，点击重试"
                >
                  <image
                    class="message-send-error__icon"
                    src="/assets/icons/chat-error.svg"
                    mode="aspectFit"
                    aria-hidden="true"
                  />
                </button>
                <view
                  wx:elif="{{item.isMine && item.sending}}"
                  class="message-send-loading"
                  aria-label="图片发送中"
                >
                  <view class="message-send-loading__spinner"></view>
                </view>
                <view
                  class="message-image-shell"
                  data-id="{{item.messageId}}"
                  bindtap="onImageTap"
                >
                  <image
                    wx:if="{{item.imageUrl}}"
                    class="message-image"
                    style="{{item.imageStyle}}"
                    src="{{item.imageUrl}}"
                    mode="aspectFill"
                    lazy-load
                  />
                  <view
                    wx:else
                    class="message-image message-image--loading"
                    style="{{item.imageStyle}}"
                  >
                    <text wx:if="{{item.imageFailed}}">图片加载失败</text>
                    <view wx:else class="message-send-loading__spinner"></view>
                  </view>
                </view>
              </view>

              <view wx:elif="{{item.messageType === 'ORDER_CARD'}}" class="chat-card chat-card--order"
                data-id="{{item.orderId}}" bindtap="onOrderCardTap" aria-role="button" aria-label="查看订单详情">
                <view class="chat-card__heading">
                  <text class="chat-card__number">订单号：{{item.orderNo}}</text>
                  <text class="chat-card__status">{{item.orderStatusText}}</text>
                </view>
                <view class="chat-card__main">
                  <view class="chat-card__image-shell">
                    <image wx:if="{{item.orderImage}}" src="{{item.orderImage}}" mode="aspectFill" />
                    <image wx:else class="chat-card__placeholder-icon" src="/assets/icons/order-all.svg" mode="aspectFit" aria-hidden="true" />
                  </view>
                  <view class="chat-card__body"><text class="chat-card__title">{{item.orderTitle}}</text></view>
                  <view class="chat-card__aside">
                    <text class="chat-card__amount">{{item.orderAmountText}}</text>
                    <text class="chat-card__meta">{{item.orderItemText}}</text>
                    <text class="chat-card__date">{{item.orderCreatedAtText}}</text>
                  </view>
                </view>
              </view>

              <view wx:elif="{{item.messageType === 'AFTER_SALE_CARD'}}" class="chat-card chat-card--after-sale"
                data-id="{{item.afterSaleId}}" bindtap="onAfterSaleCardTap" aria-role="button" aria-label="查看售后详情">
                <view class="chat-card__heading">
                  <text class="chat-card__number">售后单：{{item.afterSaleNo}}</text>
                  <text class="chat-card__status">{{item.afterSaleStatusText}}</text>
                </view>
                <view class="chat-card__main">
                  <view class="chat-card__image-shell">
                    <image wx:if="{{item.afterSaleImage}}" src="{{item.afterSaleImage}}" mode="aspectFill" />
                    <image wx:else class="chat-card__placeholder-icon" src="/assets/icons/order-all.svg" mode="aspectFit" aria-hidden="true" />
                  </view>
                  <view class="chat-card__body">
                    <text class="chat-card__title">{{item.afterSaleTitle}}</text>
                    <text class="chat-card__meta">{{item.afterSaleReason}}</text>
                  </view>
                  <view class="chat-card__aside">
                    <text class="chat-card__amount">{{item.afterSaleAmountText}}</text>
                    <text class="chat-card__meta">申请退款</text>
                  </view>
                </view>
              </view>

              <view wx:elif="{{item.messageType === 'PRODUCT_CARD'}}" class="chat-card chat-card--product"
                data-id="{{item.productId}}" bindtap="onProductCardTap" aria-role="button" aria-label="查看商品详情">
                <view class="chat-card__main">
                  <view class="chat-card__image-shell">
                    <image wx:if="{{item.productImage}}" src="{{item.productImage}}" mode="aspectFill" />
                    <image wx:else class="chat-card__placeholder-icon" src="/assets/icons/chat-product.svg" mode="aspectFit" aria-hidden="true" />
                  </view>
                  <view class="chat-card__body">
                    <text class="chat-card__title">{{item.productTitle}}</text>
                    <view class="chat-card__product-bottom">
                      <text class="chat-card__price">{{item.productPriceText}}</text>
                      <text class="chat-card__action">查看商品</text>
                    </view>
                  </view>
                </view>
              </view>

              <view
                wx:else
                class="message-bubble {{item.isMine ? 'message-bubble--mine' : 'message-bubble--other'}}"
              >{{item.content}}</view>
            </view>

            <view
              wx:if="{{item.isMine && !item.isResourceCard}}"
              class="message-avatar"
            >
              <image
                src="{{item.senderAvatar}}"
                mode="aspectFill"
              />
            </view>
          </view>
        </block>

        <view wx:if="{{showCommonQuestions && !commonQuestionAnchorMessageId}}" class="welcome-message">
          <view class="welcome-card">
            <text class="welcome-card__title">常见问题</text>
            <view class="common-question-list">
              <view wx:for="{{commonQuestions}}" wx:key="questionId"
                class="common-question-item {{commonQuestionSending ? 'common-question-item--disabled' : ''}}"
                data-question="{{item.question}}" bindtap="onCommonQuestionTap" aria-role="button">
                <text>{{item.question}}</text>
                <image src="/assets/icons/chevron-right-light.svg" mode="aspectFit" aria-hidden="true" />
              </view>
            </view>
          </view>
        </view>
        <view id="message-list-bottom" class="message-list__bottom"></view>
      </view>
    </scroll-view>

    <view wx:if="{{pendingContextCard}}" class="pending-context">
      <image wx:if="{{pendingContextCard.image}}" class="pending-context__image" src="{{pendingContextCard.image}}" mode="aspectFill" />
      <view class="pending-context__body">
        <text class="pending-context__title">{{pendingContextCard.title}}</text>
        <text wx:if="{{pendingContextCard.description}}" class="pending-context__description">{{pendingContextCard.description}}</text>
        <text class="pending-context__price {{pendingContextCard.kind === 'product' ? 'pending-context__price--product' : ''}}">{{pendingContextCard.priceText}}</text>
      </view>
      <view class="pending-context__actions">
        <button class="pending-context__close" disabled="{{contextSending}}" bindtap="onPendingContextClose" aria-label="收起待发送信息"><image src="/assets/icons/close-material-symbols.svg" mode="aspectFit" /></button>
        <button size="mini" class="pending-context__send" loading="{{contextSending}}" disabled="{{contextSending}}" bindtap="onPendingContextSend">{{pendingContextCard.sendText}}</button>
      </view>
    </view>

    <view class="composer {{panelMode ? 'composer--panel-open' : ''}}">
      <view class="composer__input-shell">
        <textarea
          class="composer__input"
          value="{{inputValue}}"
          auto-height
          adjust-position="{{true}}"
          maxlength="2000"
          confirm-type="send"
          confirm-hold="{{true}}"
          show-confirm-bar="{{false}}"
          cursor-spacing="18"
          placeholder="请输入您要咨询的内容…"
          placeholder-class="composer__placeholder"
          bindinput="onInput"
          bindfocus="onInputFocus"
          bindblur="onInputBlur"
          bindkeyboardheightchange="onKeyboardHeightChange"
          bindconfirm="onInputConfirm"
        />
      </view>
      <button
        class="composer__plus {{panelMode ? 'composer__plus--active' : ''}}"
        disabled="{{uploading}}"
        bindtap="onPlusTap"
        aria-label="{{panelMode ? '收起更多选项' : '更多发送选项'}}"
      >
        <image
          class="composer__plus-icon"
          src="/assets/icons/close-material-symbols.svg"
          mode="aspectFit"
          aria-hidden="true"
        />
      </button>
    </view>

    <view wx:if="{{panelMode}}" class="attachment-panel attachment-panel--{{panelMode}}">
      <view wx:if="{{panelMode === 'main'}}" class="attachment-grid">
        <view class="attachment-action" bindtap="onAlbumTap" aria-role="button">
          <view class="attachment-action__icon">
            <image src="/assets/icons/chat-photo.svg" mode="aspectFit" aria-hidden="true" />
          </view>
          <text>相册</text>
        </view>
        <view class="attachment-action" bindtap="onCameraTap" aria-role="button">
          <view class="attachment-action__icon">
            <image src="/assets/icons/chat-attachment-camera.svg" mode="aspectFit" aria-hidden="true" />
          </view>
          <text>拍摄</text>
        </view>
        <view class="attachment-action" bindtap="onOrderActionTap" aria-role="button">
          <view class="attachment-action__icon">
            <image class="attachment-action__order-icon" src="/assets/icons/order-all.svg" mode="aspectFit" aria-hidden="true" />
          </view>
          <text>订单</text>
        </view>
        <view class="attachment-action" bindtap="onProductActionTap" aria-role="button">
          <view class="attachment-action__icon">
            <image src="/assets/icons/chat-product.svg" mode="aspectFit" aria-hidden="true" />
          </view>
          <text>商品</text>
        </view>
      </view>

    </view>
  </block>

  <view wx:if="{{pickerOpen}}" class="picker-layer" catchtouchmove="onPickerTouchMove">
    <view class="picker-mask" bindtap="onPickerCloseTap"></view>
    <view class="picker-sheet">
      <view class="picker-sheet__header">
        <text>{{pickerTitle}}</text>
        <button bindtap="onPickerCloseTap" aria-label="关闭">
          <image src="/assets/icons/close-material-symbols.svg" mode="aspectFit" aria-hidden="true" />
        </button>
      </view>

      <view class="picker-tabs">
        <button wx:for="{{pickerTabs}}" wx:key="key" class="picker-tab {{pickerTab === item.key ? 'picker-tab--active' : ''}}"
          data-tab="{{item.key}}" bindtap="onPickerTabTap" disabled="{{candidateSendingId}}">{{item.label}}</button>
      </view>
      <view wx:if="{{pickerTab === 'order'}}" class="picker-search">
        <image src="/assets/icons/search-material-symbols-iconify.svg" mode="aspectFit" aria-hidden="true" />
        <input value="{{pickerSearch}}" bindinput="onPickerSearchInput" placeholder="搜索商品名称或订单号" confirm-type="search" />
      </view>

      <view wx:if="{{pickerLoading}}" class="picker-state">
        <view class="upload-progress__spinner"></view>
        <text>正在加载</text>
      </view>

      <view wx:elif="{{pickerErrorText}}" class="picker-state picker-state--error">
        <text>{{pickerErrorText}}</text>
        <button bindtap="onPickerRetry">重试</button>
      </view>

      <view wx:elif="{{!candidates.length}}" class="picker-state">
        <text>这里还没有可发送的内容</text>
      </view>

      <scroll-view wx:else class="candidate-list" scroll-y enhanced show-scrollbar="{{false}}">
        <view wx:for="{{candidates}}" wx:key="id" class="candidate {{item.disabled ? 'candidate--disabled' : ''}}">
          <view wx:if="{{pickerKind === 'order'}}" class="candidate__heading">
            <text>下单时间 {{item.timeText}}</text><text class="candidate__status">{{item.statusText}}</text>
          </view>
          <view class="candidate__main">
            <view class="candidate__image-shell">
              <image wx:if="{{item.hasImage}}" src="{{item.imageUrl}}" mode="aspectFill" />
              <image wx:else class="candidate__placeholder-icon" src="{{pickerKind === 'order' ? '/assets/icons/order-all.svg' : '/assets/icons/chat-product.svg'}}" mode="aspectFit" aria-hidden="true" />
            </view>
            <view class="candidate__body">
              <text class="candidate__title">{{item.title}}</text>
              <text wx:if="{{item.subtitle}}" class="candidate__subtitle">{{item.subtitle}}</text>
              <text wx:if="{{pickerKind === 'order'}}" class="candidate__meta">{{item.metaText}}</text>
              <text wx:if="{{pickerKind === 'product'}}" class="candidate__product-price">{{item.priceText}}</text>
            </view>
            <view class="candidate__aside">
              <text wx:if="{{pickerKind === 'order'}}" class="candidate__price">{{item.priceText}}</text>
              <button data-id="{{item.id}}" bindtap="onCandidateTap" loading="{{candidateSendingId === item.id}}" disabled="{{item.disabled || candidateSendingId}}">{{item.disabled ? '不可用' : '发送'}}</button>
            </view>
          </view>
        </view>
      </scroll-view>
    </view>
  </view>
</view>
