<view class="cart-page">
  <navigation-bar
    title=""
    back="{{navigationBack}}"
    wide-center="{{true}}"
    show-divider="{{false}}"
    color="#2E1D16"
  >
    <view slot="center" class="cart-navigation-title">购物车（{{cartTotalQuantity}}）</view>
    <button
      wx:if="{{!loginRequired && loaded && rawItems.length}}"
      slot="right"
      class="manage-action"
      disabled="{{deletingBatch || updatingId}}"
      bindtap="onManageToggle"
    >{{managing ? '完成' : '管理'}}</button>
  </navigation-bar>

  <view wx:if="{{loginRequired}}" class="cart-login-state">
    <view class="cart-login-state__emblem">
      <image
        class="cart-login-state__emblem-image"
        src="{{brandLogo.src}}"
        style="{{brandLogo.style}}"
        mode="scaleToFill"
        aria-label="MuYbaby 品牌标志"
      />
    </view>
    <view class="cart-login-state__title">登录后查看购物车</view>
    <button
      class="cart-login-state__action"
      bindtap="onLoginTap"
      hover-class="cart-login-state__action--pressed"
    >去登录</button>
  </view>

  <scroll-view
    wx:else
    class="cart-content"
    scroll-y="{{true}}"
    enhanced="{{true}}"
    bounces="{{false}}"
    show-scrollbar="{{false}}"
    refresher-enabled="{{true}}"
    refresher-triggered="{{contentRefreshing}}"
    refresher-background="#f6f6f6"
    bindrefresherrefresh="onContentRefresh"
  >
    <view wx:if="{{!loaded && loading}}" class="cart-state">
      <ui-state type="loading" title="正在准备购物车" description="好味道马上就来" />
    </view>

    <view wx:elif="{{!loaded && errorText}}" class="cart-state">
      <ui-state
        type="error"
        title="购物车加载失败"
        description="{{errorText}}"
        action-text="重新加载"
        bindaction="onRetry"
      />
    </view>

    <view wx:elif="{{loaded && !rawItems.length}}" class="cart-state cart-state--empty">
      <ui-state
        type="empty"
        icon="/assets/icons/empty-cart.svg"
        description="购物车还是空的"
      />
    </view>

    <block wx:else>
      <view wx:if="{{errorText}}" class="inline-error">
        <text>{{errorText}}</text>
        <button class="inline-error__action" bindtap="onRetry">重试</button>
      </view>

      <view class="cart-list">
        <view
          wx:for="{{items}}"
          wx:key="id"
          class="cart-card {{item.available ? '' : 'cart-card--unavailable'}}"
        >
          <view
            class="selection-hit-target"
            data-id="{{item.id}}"
            catchtap="onSelectionToggle"
            aria-role="checkbox"
            aria-checked="{{item.selected}}"
            aria-label="{{item.selected ? '取消选择' : '选择'}}{{item.productTitle}}"
          >
            <view class="selection {{item.selected ? 'selection--checked' : ''}} {{item.available || managing ? '' : 'selection--disabled'}}">
              <image
                wx:if="{{item.selected}}"
                class="selection__check"
                src="/assets/icons/check-rounded-material-symbols-iconify.svg"
                mode="aspectFit"
                aria-hidden="true"
              />
            </view>
          </view>

          <view
            class="cart-card__image-shell"
            data-id="{{item.id}}"
            bindtap="onProductTap"
          >
            <image
              wx:if="{{item.hasImage}}"
              class="cart-card__image"
              src="{{item.imageUrl}}"
              mode="aspectFill"
              data-id="{{item.id}}"
              binderror="onImageError"
            />
            <view wx:else class="cart-card__fallback">灶</view>
          </view>

          <view class="cart-card__body">
            <view class="cart-card__details">
              <view
                class="cart-card__title"
                data-id="{{item.id}}"
                bindtap="onProductTap"
              >{{item.productTitle}}</view>
              <view wx:if="{{item.specText}}" class="cart-card__spec">{{item.specText}}</view>
              <view wx:if="{{!item.available}}" class="unavailable-tag">{{item.unavailableText}}</view>
            </view>

            <view class="cart-card__pricing">
              <view class="price-row">
                <view class="price-row__prices">
                  <view class="price-row__current" aria-label="{{item.priceText}}">
                    <text class="price-row__currency">¥</text>
                    <text class="price-row__integer">{{item.priceIntegerText}}</text>
                    <text class="price-row__decimal">{{item.priceDecimalText}}</text>
                  </view>
                  <text wx:if="{{item.hasRetailPrice}}" class="price-row__retail">{{item.retailPriceText}}</text>
                </view>
                <view class="cart-card__footer">
                  <view wx:if="{{!managing}}" class="quantity-stepper">
                    <button
                      class="quantity-stepper__button"
                      data-id="{{item.id}}"
                      disabled="{{!item.available || item.quantity <= 1 || updatingId || deletingBatch}}"
                      catchtap="onQuantityMinus"
                    >−</button>
                    <view class="quantity-stepper__value">
                      <view wx:if="{{updatingId === item.id}}" class="mini-spinner"></view>
                      <text wx:else>{{item.quantity}}</text>
                    </view>
                    <button
                      class="quantity-stepper__button"
                      data-id="{{item.id}}"
                      disabled="{{!item.available || item.quantity >= 999 || updatingId || deletingBatch}}"
                      catchtap="onQuantityPlus"
                    >+</button>
                  </view>
                  <button
                    wx:else
                    class="delete-icon-action"
                    data-id="{{item.id}}"
                    disabled="{{deletingBatch}}"
                    catchtap="onItemDeleteTap"
                    aria-label="删除{{item.productTitle}}"
                  >
                    <view wx:if="{{deletingId === item.id}}" class="mini-spinner"></view>
                    <image wx:else src="/assets/icons/trash-can-outline-iconify.svg" mode="aspectFit" />
                  </button>
                </view>
              </view>
              <view wx:if="{{item.wholesaleText}}" class="wholesale-copy">{{item.wholesaleText}}</view>
              <view wx:if="{{item.nextWholesaleText}}" class="next-tier-copy">{{item.nextWholesaleText}}</view>
            </view>
          </view>
        </view>
      </view>
    </block>
  </scroll-view>

  <view wx:if="{{!loginRequired && loaded && rawItems.length}}" class="settlement-bar {{managing ? 'settlement-bar--managing' : ''}}">
    <view
      class="select-all"
      bindtap="onSelectAllToggle"
      aria-role="checkbox"
      aria-checked="{{allAvailableSelected}}"
    >
      <view class="selection selection--compact {{allAvailableSelected ? 'selection--checked' : ''}}">
        <image
          wx:if="{{allAvailableSelected}}"
          class="selection__check"
          src="/assets/icons/check-rounded-material-symbols-iconify.svg"
          mode="aspectFit"
          aria-hidden="true"
        />
      </view>
      <text>全选</text>
    </view>
    <view wx:if="{{!managing}}" class="settlement-total">
      <view><text class="settlement-total__label">合计</text><text class="settlement-total__amount">{{selectedAmountText}}</text></view>
    </view>
    <view wx:else class="settlement-spacer"></view>
    <button
      wx:if="{{!managing}}"
      class="checkout-action"
      bindtap="onCheckoutTap"
    >去结算</button>
    <button
      wx:else
      class="batch-delete-action"
      loading="{{deletingBatch}}"
      disabled="{{!selectedIds.length || deletingBatch}}"
      bindtap="onBatchDeleteTap"
    >删除</button>
  </view>
</view>
