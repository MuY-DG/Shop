<view class="cart-page">
  <navigation-bar
    title="购物车"
    background="#FAF2E4"
    color="#2E1D16"
    loading="{{loaded && loading}}"
  />

  <view class="cart-content">
    <view wx:if="{{loginRequired}}" class="cart-login-state">
      <image
        class="cart-login-state__emblem"
        src="/assets/images/zaoxiangji-login-emblem.png"
        mode="aspectFit"
      />
      <view class="cart-login-state__title">登录后查看购物车</view>
      <view class="cart-login-state__description">商品清单与结算信息会安全地保存在你的账户中</view>
      <button
        class="cart-login-state__action"
        bindtap="onLoginTap"
        hover-class="cart-login-state__action--pressed"
      >去登录</button>
    </view>

    <block wx:else>
    <view wx:if="{{loaded && rawItems.length}}" class="cart-heading">
      <view>
        <view class="cart-heading__title">这一锅，慢慢挑</view>
        <view class="cart-heading__meta">
          {{rawItems.length}} 种商品<text wx:if="{{unavailableCount}}"> · {{unavailableCount}} 件失效</text>
        </view>
      </view>
      <button
        class="text-action"
        loading="{{clearing}}"
        disabled="{{clearing || deletingId}}"
        bindtap="onClearTap"
      >清空</button>
    </view>

    <view wx:if="{{!loaded && loading}}" class="cart-state">
      <ui-state type="loading" title="正在准备购物车" description="好味道马上就来" />
    </view>

    <view wx:elif="{{!loaded && errorText}}" class="cart-state">
      <ui-state
        type="error"
        title="购物车加载失败"
        description="{{errorText}}"
        action-text="重新加载"
        bindaction="onRetry"
      />
    </view>

    <view wx:elif="{{loaded && !rawItems.length}}" class="cart-state cart-state--empty">
      <ui-state
        type="empty"
        icon="/assets/icons/empty-cart.svg"
        description="购物车还是空的"
      />
    </view>

    <block wx:else>
      <view wx:if="{{errorText}}" class="inline-error">
        <text>{{errorText}}</text>
        <button class="inline-error__action" bindtap="onRetry">重试</button>
      </view>

      <view class="cart-list">
        <view
          wx:for="{{items}}"
          wx:key="id"
          class="cart-card {{item.available ? '' : 'cart-card--unavailable'}}"
        >
          <view
            class="selection {{item.selected ? 'selection--checked' : ''}} {{item.available ? '' : 'selection--disabled'}}"
            data-id="{{item.id}}"
            catchtap="onSelectionToggle"
            aria-role="checkbox"
            aria-checked="{{item.selected}}"
            aria-label="{{item.selected ? '取消选择' : '选择'}}{{item.productTitle}}"
          >
            <text wx:if="{{item.selected}}">✓</text>
          </view>

          <view
            class="cart-card__image-shell"
            data-id="{{item.id}}"
            bindtap="onProductTap"
          >
            <image
              wx:if="{{item.hasImage}}"
              class="cart-card__image"
              src="{{item.imageUrl}}"
              mode="aspectFill"
              data-id="{{item.id}}"
              binderror="onImageError"
            />
            <view wx:else class="cart-card__fallback">灶</view>
          </view>

          <view class="cart-card__body">
            <view
              class="cart-card__title"
              data-id="{{item.id}}"
              bindtap="onProductTap"
            >{{item.productTitle}}</view>
            <view wx:if="{{item.specText}}" class="cart-card__spec">{{item.specText}}</view>
            <view wx:if="{{!item.available}}" class="unavailable-tag">{{item.unavailableText}}</view>

            <view class="price-row">
              <text class="price-row__current">{{item.priceText}}</text>
              <text wx:if="{{item.hasRetailPrice}}" class="price-row__retail">{{item.retailPriceText}}</text>
            </view>
            <view wx:if="{{item.wholesaleText}}" class="wholesale-copy">{{item.wholesaleText}}</view>
            <view wx:if="{{item.nextWholesaleText}}" class="next-tier-copy">{{item.nextWholesaleText}}</view>

            <view class="cart-card__footer">
              <view>
                <view class="line-amount">小计 {{item.lineAmountText}}</view>
              </view>
              <view class="quantity-stepper">
                <button
                  class="quantity-stepper__button"
                  data-id="{{item.id}}"
                  disabled="{{!item.available || item.quantity <= 1 || updatingId || deletingId || clearing}}"
                  catchtap="onQuantityMinus"
                >−</button>
                <view class="quantity-stepper__value">
                  <view wx:if="{{updatingId === item.id}}" class="mini-spinner"></view>
                  <text wx:else>{{item.quantity}}</text>
                </view>
                <button
                  class="quantity-stepper__button"
                  data-id="{{item.id}}"
                  disabled="{{!item.available || item.quantity >= 999 || updatingId || deletingId || clearing}}"
                  catchtap="onQuantityPlus"
                >+</button>
              </view>
            </view>

            <button
              class="remove-action"
              data-id="{{item.id}}"
              loading="{{deletingId === item.id}}"
              disabled="{{deletingId || clearing}}"
              catchtap="onDeleteTap"
            >移除</button>
          </view>
        </view>
      </view>
    </block>
    </block>
  </view>

  <view wx:if="{{!loginRequired && loaded && rawItems.length}}" class="settlement-bar">
    <view
      class="select-all"
      bindtap="onSelectAllToggle"
      aria-role="checkbox"
      aria-checked="{{allAvailableSelected}}"
    >
      <view class="selection selection--compact {{allAvailableSelected ? 'selection--checked' : ''}}">
        <text wx:if="{{allAvailableSelected}}">✓</text>
      </view>
      <text>全选</text>
    </view>
    <view class="settlement-total">
      <view><text class="settlement-total__label">合计</text><text class="settlement-total__amount">{{selectedAmountText}}</text></view>
      <view class="settlement-total__hint">已选 {{selectedQuantity}} 件，优惠将在结算页计算</view>
    </view>
    <button
      class="checkout-action"
      disabled="{{checkoutDisabled || loading}}"
      bindtap="onCheckoutTap"
    >去结算</button>
  </view>
</view>
