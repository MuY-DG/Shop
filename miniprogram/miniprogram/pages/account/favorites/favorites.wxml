<view class="account-page favorites-page">
  <navigation-bar
    title=""
    back="{{true}}"
    wide-center="{{true}}"
    show-divider="{{false}}"
    color="#2E1D16"
    loading="{{loaded && loading}}"
  >
    <view slot="center" class="favorites-navigation-title">我的收藏</view>
    <button
      wx:if="{{loaded && items.length}}"
      slot="right"
      class="favorites-navigation-action"
      disabled="{{deleting || addingSpuId}}"
      bindtap="onManageToggle"
    >{{managing ? '完成' : '管理'}}</button>
  </navigation-bar>

  <scroll-view
    class="account-scroll"
    scroll-y="{{true}}"
    enhanced="{{true}}"
    bounces="{{true}}"
    enable-passive="{{true}}"
    show-scrollbar="{{false}}"
    refresher-enabled="{{true}}"
    refresher-triggered="{{loaded && loading}}"
    refresher-background="#f6f6f6"
    lower-threshold="160"
    bindrefresherrefresh="onPullDownRefresh"
    bindscrolltolower="onReachBottom"
  >
    <view class="account-content {{managing ? 'account-content--managing' : ''}}">
      <view wx:if="{{!loaded && loading}}" class="account-state">
        <ui-state type="loading" title="正在加载收藏" description="请稍候" />
      </view>
      <view wx:elif="{{!loaded && errorText}}" class="account-state">
        <ui-state type="error" title="收藏加载失败" description="{{errorText}}" action-text="重新加载" bindaction="onRetry" />
      </view>
      <ui-state
        wx:elif="{{loaded && !items.length}}"
        type="empty"
        icon="/assets/icons/empty-favorites.svg"
        description="还没有收藏商品"
      />

      <block wx:else>
        <view wx:if="{{errorText}}" class="inline-error"><text>{{errorText}}</text><button bindtap="onRetry">重试</button></view>
        <view class="favorite-list">
          <view
            wx:for="{{items}}"
            wx:key="spuId"
            class="favorite-row {{managing ? 'favorite-row--managing' : ''}}"
          >
            <view
              wx:if="{{managing}}"
              class="favorite-selection-hit"
              data-id="{{item.spuId}}"
              catchtap="onSelectionToggle"
              aria-role="checkbox"
              aria-checked="{{item.selected}}"
              aria-label="{{item.selected ? '取消选择' : '选择'}}{{item.title}}"
            >
              <view class="favorite-selection {{item.selected ? 'favorite-selection--checked' : ''}}">
                <image
                  wx:if="{{item.selected}}"
                  class="favorite-selection__check"
                  src="/assets/icons/check-rounded-material-symbols-iconify.svg"
                  mode="aspectFit"
                  aria-hidden="true"
                />
              </view>
            </view>
            <view class="favorite-product-card">
              <product-card
                product="{{item}}"
                variant="list"
                flat="{{true}}"
                adding="{{addingSpuId === item.spuId}}"
                bindselect="onProductSelect"
                bindadd="onProductAdd"
              />
            </view>
          </view>
        </view>
        <view wx:if="{{loadingMore}}" class="list-footer">正在加载更多…</view>
        <view wx:elif="{{items.length && !hasMore}}" class="list-footer">没有更多收藏了</view>
      </block>
    </view>
  </scroll-view>

  <view wx:if="{{managing && items.length}}" class="favorite-management-bar">
    <button
      class="favorite-cancel-button"
      loading="{{deleting}}"
      disabled="{{!selectedIds.length || deleting}}"
      bindtap="onCancelFavoritesTap"
    >取消收藏（{{selectedIds.length}}）</button>
  </view>
</view>
