<view class="rights-page">
  <navigation-bar
    title="账户与个人信息权利"
    back="{{true}}"
    round-back="{{true}}"
    show-divider="{{false}}"
    color="#2E1D16"
  />

  <scroll-view class="rights-scroll" scroll-y="{{true}}" show-scrollbar="{{false}}">
    <view class="rights-content">
      <view class="rights-notice">
        <text class="rights-notice__title">申请不会自动删除交易记录</text>
        <text class="rights-notice__body">我们会核验身份与未完结履约事项，并在处理结果中说明实际删除或依法、履约需要保留的数据。</text>
      </view>

      <view class="rights-card">
        <view class="section-title">选择申请类型</view>
        <view
          wx:for="{{requestTypes}}"
          wx:key="type"
          class="type-option {{selectedType === item.type ? 'type-option--selected' : ''}}"
          data-type="{{item.type}}"
          bindtap="onTypeTap"
          aria-role="radio"
          aria-checked="{{selectedType === item.type}}"
        >
          <view class="type-option__indicator"></view>
          <view class="type-option__body">
            <text class="type-option__label">{{item.label}}</text>
            <text class="type-option__description">{{item.description}}</text>
          </view>
        </view>
        <textarea
          class="request-note"
          value="{{requestNote}}"
          maxlength="1000"
          auto-height="{{true}}"
          placeholder="补充说明（选填；更正申请请写明需要更正的内容）"
          bindinput="onNoteInput"
        />
        <button class="submit-button" loading="{{submitting}}" disabled="{{submitting}}" bindtap="onSubmitTap">
          提交申请
        </button>
      </view>

      <view class="section-title section-title--records">我的申请</view>
      <ui-state
        wx:if="{{loading}}"
        type="loading"
        title="正在加载申请记录"
        description="请稍候"
      />
      <ui-state
        wx:elif="{{errorText}}"
        type="error"
        title="申请记录加载失败"
        description="{{errorText}}"
        action-text="重新加载"
        bindaction="onRetry"
      />
      <view wx:elif="{{loaded && !requests.length}}" class="empty-card">尚未提交申请</view>
      <view wx:else class="request-list">
        <view
          wx:for="{{requests}}"
          wx:key="id"
          class="request-card"
          data-id="{{item.id}}"
          bindtap="onRequestTap"
          aria-role="button"
          aria-label="{{item.typeText}}，{{item.statusText}}，查看详情"
        >
          <view class="request-card__header">
            <text class="request-card__type">{{item.typeText}}</text>
            <text class="request-status request-status--{{item.status}}">{{item.statusText}}</text>
          </view>
          <text class="request-card__time">{{item.createdAtText}}</text>
          <text wx:if="{{item.requestNote}}" class="request-card__note">{{item.requestNote}}</text>
          <button
            wx:if="{{item.canWithdraw}}"
            class="withdraw-button"
            data-id="{{item.id}}"
            loading="{{withdrawingId === item.id}}"
            catchtap="onWithdrawTap"
          >撤回</button>
        </view>
      </view>
    </view>
  </scroll-view>

  <view wx:if="{{detailOpen}}" class="detail-mask" bindtap="onCloseDetail">
    <view class="detail-sheet" catchtap="onPreventMove">
      <view class="detail-sheet__header">
        <text class="detail-sheet__title">申请详情</text>
        <button class="detail-sheet__close" bindtap="onCloseDetail" aria-label="关闭">×</button>
      </view>
      <ui-state wx:if="{{detailLoading}}" type="loading" title="正在加载详情" />
      <scroll-view wx:else class="detail-sheet__scroll" scroll-y="{{true}}">
        <view wx:if="{{selectedRequest}}" class="detail-sheet__content">
          <view class="detail-row"><text>申请类型</text><text>{{selectedRequest.typeText}}</text></view>
          <view class="detail-row"><text>当前状态</text><text>{{selectedRequest.statusText}}</text></view>
          <view class="detail-block">
            <text class="detail-block__label">处理原因</text>
            <text>{{selectedRequest.reviewReason || '尚未填写'}}</text>
          </view>
          <view class="detail-block">
            <text class="detail-block__label">数据保留或删除说明</text>
            <text>{{selectedRequest.retentionExplanation || '尚未填写'}}</text>
          </view>
          <view class="detail-block">
            <text class="detail-block__label">保留数据类别</text>
            <text>{{selectedRequest.retainedDataCategoriesText || '尚未填写'}}</text>
          </view>
          <view class="audit-title">处理记录</view>
          <view wx:for="{{selectedAudits}}" wx:key="id" class="audit-item">
            <view class="audit-item__dot"></view>
            <view class="audit-item__body">
              <text class="audit-item__transition">{{item.transitionText}}</text>
              <text class="audit-item__time">{{item.createdAtText}}</text>
              <text wx:if="{{item.reason}}" class="audit-item__reason">{{item.reason}}</text>
            </view>
          </view>
        </view>
      </scroll-view>
    </view>
  </view>
</view>
