<view class="settings-page">
  <navigation-bar
    title="关于与协议"
    back="{{true}}"
    round-back="{{true}}"
    show-divider="{{false}}"
    color="#2E1D16"
  />

  <scroll-view
    class="settings-scroll"
    scroll-y="{{true}}"
    enhanced="{{true}}"
    bounces="{{true}}"
    enable-passive="{{true}}"
    show-scrollbar="{{false}}"
  >
    <view class="settings-content">
      <view class="settings-container">
        <block wx:for="{{sections}}" wx:for-item="section" wx:key="title">
          <view
            wx:for="{{section.items}}"
            wx:for-item="entry"
            wx:key="key"
            class="settings-row"
            data-key="{{entry.key}}"
            bindtap="onItemTap"
            hover-class="settings-row--pressed"
            aria-role="button"
            aria-label="{{entry.label}}"
          >
            <view class="settings-row__body">
              <view class="settings-row__label">{{entry.label}}</view>
              <view wx:if="{{entry.description}}" class="settings-row__description">{{entry.description}}</view>
            </view>
            <image
              class="settings-row__chevron"
              src="/assets/icons/chevron-right-light.svg"
              mode="aspectFit"
              aria-hidden="true"
            />
          </view>
        </block>
      </view>
    </view>
  </scroll-view>
</view>
