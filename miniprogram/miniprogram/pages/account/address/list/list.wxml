<view class="address-page">
  <navigation-bar
    title="收货地址"
    back="{{true}}"
    color="#2E1D16"
    show-divider="{{false}}"
  />

  <scroll-view
    class="address-scroll"
    scroll-y="{{true}}"
    enhanced="{{true}}"
    bounces="{{false}}"
    enable-passive="{{true}}"
    show-scrollbar="{{false}}"
    refresher-enabled="{{true}}"
    refresher-triggered="{{contentRefreshing}}"
    refresher-background="#f6f6f6"
    bindrefresherrefresh="onContentRefresh"
  >
  <view class="address-content">
    <view wx:if="{{!loaded && loading}}" class="address-state">
      <ui-state type="loading" title="正在加载地址" description="请稍候" />
    </view>
    <view wx:elif="{{!loaded && errorText}}" class="address-state">
      <ui-state type="error" title="当前服务繁忙" description="{{errorText}}" />
    </view>
    <view wx:elif="{{loaded && !addresses.length}}" class="address-state address-state--empty">
      <ui-state type="empty" icon="/assets/icons/empty-addresses.svg" description="还没有收货地址" />
    </view>

    <block wx:else>
      <view wx:if="{{errorText}}" class="inline-error">
        <text>{{errorText}}</text>
        <button bindtap="onRetry">重试</button>
      </view>
      <view class="address-list">
        <view wx:for="{{addresses}}" wx:key="id" class="address-row" data-id="{{item.id}}" bindtap="onEditTap">
          <view class="address-row__body">
            <view class="address-row__detail">{{item.detailDisplay}}</view>
            <view class="address-row__identity">
              <text wx:if="{{item.isDefault}}" class="default-tag">默认</text>
              <text class="address-row__name">{{item.receiverName}}</text>
              <text class="address-row__phone">{{item.phoneDisplay}}</text>
            </view>
          </view>
          <view class="address-row__edit" data-id="{{item.id}}" catchtap="onEditTap" aria-role="button" aria-label="编辑收货地址">
            <image class="address-row__edit-icon" src="/assets/icons/edit-square-outline-mdi-iconify.svg" mode="aspectFit" />
          </view>
        </view>
      </view>
    </block>
  </view>
  </scroll-view>

  <view class="address-footer">
    <button class="add-address-button" bindtap="onAddTap">新增收货地址</button>
  </view>
</view>
