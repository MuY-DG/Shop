<view class="address-edit-page">
  <navigation-bar
    title="{{navigationTitle}}"
    back="{{true}}"
    home="{{true}}"
    background="#FAF2E4"
    color="#2E1D16"
    loading="{{loading || saving}}"
  />

  <view class="address-edit-content">
    <view wx:if="{{loading && !loaded}}" class="edit-state">
      <ui-state type="loading" title="正在加载地址" description="请稍候" />
    </view>
    <view wx:elif="{{!loaded && loadErrorText}}" class="edit-state">
      <ui-state type="error" title="地址加载失败" description="{{loadErrorText}}" action-text="重新加载" bindaction="onRetry" />
    </view>

    <view wx:else class="address-form">
      <view class="form-heading">
        <view class="form-heading__title">配送信息</view>
        <view class="form-heading__subtitle">请填写真实、完整的收货信息</view>
      </view>

      <view class="location-assist">
        <button
          class="location-assist__button"
          loading="{{locating}}"
          disabled="{{locating || saving}}"
          bindtap="onLocateTap"
        >
          <image class="location-assist__icon" src="/assets/icons/location-on-outline-rounded.svg" mode="aspectFit" />
          <view class="location-assist__copy">
            <view class="location-assist__title">{{locating ? '正在打开地图' : '高德地图选择收货地址'}}</view>
            <view class="location-assist__subtitle">支持当前定位、拖动选点、附近地点和关键词搜索</view>
          </view>
          <text class="location-assist__chevron">›</text>
        </button>
        <view wx:if="{{locationStatusText}}" class="location-assist__status">{{locationStatusText}}</view>
      </view>

      <view class="form-field">
        <text class="form-field__label">收货人</text>
        <input
          class="form-field__input"
          value="{{form.receiverName}}"
          data-field="receiverName"
          maxlength="64"
          placeholder="请输入收货人姓名"
          placeholder-class="form-field__placeholder"
          bindinput="onInput"
        />
      </view>
      <view class="form-field">
        <text class="form-field__label">联系电话</text>
        <input
          class="form-field__input"
          value="{{form.receiverPhone}}"
          data-field="receiverPhone"
          maxlength="32"
          placeholder="请输入手机或联系电话"
          placeholder-class="form-field__placeholder"
          bindinput="onInput"
        />
      </view>
      <picker mode="region" value="{{region}}" bindchange="onRegionChange">
        <view class="form-field form-field--picker">
          <text class="form-field__label">所在地区</text>
          <view class="form-field__value {{form.province ? '' : 'form-field__placeholder'}}">
            {{form.province ? form.province + ' ' + form.city + ' ' + form.district : '请选择省市区'}}
          </view>
          <text class="form-field__chevron">›</text>
        </view>
      </picker>
      <view class="form-field form-field--textarea">
        <text class="form-field__label">详细地址</text>
        <textarea
          class="form-field__textarea"
          value="{{form.detailAddress}}"
          data-field="detailAddress"
          maxlength="255"
          auto-height="{{true}}"
          placeholder="街道、门牌号、小区、楼栋和房间号"
          placeholder-class="form-field__placeholder"
          bindinput="onInput"
        />
      </view>
      <view class="form-field form-field--switch">
        <view>
          <view class="form-field__label">设为默认地址</view>
          <view class="form-field__hint">结算时优先选择该地址</view>
        </view>
        <switch checked="{{form.isDefault}}" color="#B72B22" bindchange="onDefaultChange" />
      </view>

      <view wx:if="{{validationErrorText}}" class="validation-error">{{validationErrorText}}</view>
      <button class="save-button" loading="{{saving}}" disabled="{{saving}}" bindtap="onSaveTap">保存地址</button>
    </view>
  </view>
</view>
