<view class="address-edit-page">
  <navigation-bar
    title="{{navigationTitle}}"
    back="{{true}}"
    color="#2E1D16"
    show-divider="{{false}}"
    loading="{{loading || saving || importing || deleting}}"
  />

  <view class="address-edit-content">
    <view wx:if="{{loading && !loaded}}" class="edit-state">
      <ui-state type="loading" title="正在加载地址" description="请稍候" />
    </view>
    <view wx:elif="{{!loaded && loadErrorText}}" class="edit-state">
      <ui-state type="error" title="地址加载失败" description="{{loadErrorText}}" action-text="重新加载" bindaction="onRetry" />
    </view>

    <view wx:else class="address-form">
      <view class="form-heading">
        <view class="form-heading__title">配送信息</view>
        <button class="wechat-import" disabled="{{importing || saving || deleting}}" bindtap="onWechatImportTap">
          <image src="/assets/icons/wechat.svg" mode="aspectFit" />
          <text>{{importing ? '导入中…' : '微信导入'}}</text>
        </button>
      </view>

      <view class="form-field">
        <text class="form-field__label">收货人</text>
        <input
          class="form-field__input"
          value="{{form.receiverName}}"
          data-field="receiverName"
          maxlength="10"
          placeholder="姓名"
          placeholder-class="form-field__placeholder"
          bindinput="onInput"
        />
      </view>
      <view class="form-field">
        <text class="form-field__label">手机号</text>
        <input
          class="form-field__input"
          value="{{form.receiverPhone}}"
          data-field="receiverPhone"
          maxlength="32"
          placeholder="手机号码"
          placeholder-class="form-field__placeholder"
          bindinput="onInput"
        />
      </view>
      <button
        class="form-field form-field--address"
        disabled="{{locating || saving || importing || deleting}}"
        bindtap="onLocateTap"
      >
        <text class="form-field__label">地址</text>
        <view class="address-value">
          <view wx:if="{{locationNameDisplay || locationAddressDisplay}}" class="address-summary">
            <view wx:if="{{locationNameDisplay}}" class="address-summary__name">
              {{locating ? '正在打开微信地图…' : locationNameDisplay}}
            </view>
            <view wx:else class="address-summary__single">
              {{locating ? '正在打开微信地图…' : locationAddressDisplay}}
            </view>
            <view
              wx:if="{{locationNameDisplay && locationAddressDisplay}}"
              class="address-summary__detail"
            >
              {{locationAddressDisplay}}
            </view>
          </view>
          <view wx:else class="form-field__value form-field__placeholder">
            {{locating ? '正在打开微信地图…' : '请选择收货地址'}}
          </view>
        </view>
        <image
          class="form-field__chevron"
          src="/assets/icons/chevron-right-light.svg"
          mode="aspectFit"
        />
      </button>
      <picker
        wx:if="{{needsRegionSelection}}"
        class="region-picker"
        mode="region"
        value="{{regionValue}}"
        disabled="{{locating || saving || importing || deleting}}"
        bindchange="onRegionChange"
      >
        <view class="form-field form-field--region-fallback">
          <text class="form-field__label">补充地区</text>
          <view class="address-value">
            <view class="form-field__value {{regionDisplay ? '' : 'form-field__placeholder'}}">
              {{regionDisplay || '请选择省、市、区'}}
            </view>
          </view>
          <image
            class="form-field__chevron"
            src="/assets/icons/chevron-right-light.svg"
            mode="aspectFit"
          />
        </view>
      </picker>
      <view wx:if="{{locationStatusText}}" class="form-hint">{{locationStatusText}}</view>
      <view class="form-field">
        <view class="form-field__label">门牌号</view>
        <input
          class="form-field__input"
          value="{{doorplate}}"
          maxlength="96"
          placeholder="例如 3 栋 2 单元 201"
          placeholder-class="form-field__placeholder"
          bindinput="onDoorplateInput"
        />
      </view>
      <view class="form-field form-field--switch">
        <view class="form-field__label">设为默认地址</view>
        <switch checked="{{form.isDefault}}" color="#B72B22" bindchange="onDefaultChange" />
      </view>

      <view wx:if="{{validationErrorText}}" class="validation-error">{{validationErrorText}}</view>
      <button class="save-button" loading="{{saving}}" disabled="{{locating || saving || importing || deleting}}" bindtap="onSaveTap">保存地址</button>
      <button
        wx:if="{{addressId}}"
        class="delete-button"
        loading="{{deleting}}"
        disabled="{{saving || importing || deleting}}"
        bindtap="onDeleteTap"
      >删除收货地址</button>
    </view>
  </view>
</view>
