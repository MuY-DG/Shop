<view class="address-edit-page">
  <navigation-bar
    title="{{navigationTitle}}"
    back="{{true}}"
    home="{{true}}"
    background="#FAF2E4"
    color="#2E1D16"
    loading="{{loading || saving}}"
  />

  <view class="address-edit-content">
    <view wx:if="{{loading && !loaded}}" class="edit-state">
      <ui-state type="loading" title="正在加载地址" description="请稍候" />
    </view>
    <view wx:elif="{{!loaded && loadErrorText}}" class="edit-state">
      <ui-state type="error" title="地址加载失败" description="{{loadErrorText}}" action-text="重新加载" bindaction="onRetry" />
    </view>

    <view wx:else class="address-form">
      <view class="form-heading">
        <view class="form-heading__title">配送信息</view>
        <view class="form-heading__subtitle">地图选择地址，再补充楼栋、单元或房间号</view>
      </view>

      <view class="form-field">
        <text class="form-field__label">收货人</text>
        <input
          class="form-field__input"
          value="{{form.receiverName}}"
          data-field="receiverName"
          maxlength="64"
          placeholder="请输入收货人姓名"
          placeholder-class="form-field__placeholder"
          bindinput="onInput"
        />
      </view>
      <view class="form-field">
        <text class="form-field__label">联系电话</text>
        <input
          class="form-field__input"
          value="{{form.receiverPhone}}"
          data-field="receiverPhone"
          maxlength="32"
          placeholder="请输入手机或联系电话"
          placeholder-class="form-field__placeholder"
          bindinput="onInput"
        />
      </view>
      <button
        class="form-field form-field--address"
        disabled="{{locating || saving}}"
        bindtap="onLocateTap"
      >
        <text class="form-field__label">地址</text>
        <view class="address-value">
          <view class="form-field__value {{addressDisplay ? '' : 'form-field__placeholder'}}">
            {{locating ? '正在打开地图…' : (addressDisplay || '点击地图选择收货地址')}}
          </view>
          <view wx:if="{{locationStatusText}}" class="address-value__hint">
            {{locationStatusText}}
          </view>
        </view>
        <text class="form-field__chevron">›</text>
      </button>
      <view class="form-field">
        <view class="form-field__label form-field__label--optional">
          <text>门牌号</text>
          <text class="form-field__optional">选填</text>
        </view>
        <input
          class="form-field__input"
          value="{{doorplate}}"
          maxlength="96"
          placeholder="例如 3 栋 2 单元 201"
          placeholder-class="form-field__placeholder"
          bindinput="onDoorplateInput"
        />
      </view>
      <view class="form-field form-field--switch">
        <view>
          <view class="form-field__label">设为默认地址</view>
          <view class="form-field__hint">结算时优先选择该地址</view>
        </view>
        <switch checked="{{form.isDefault}}" color="#B72B22" bindchange="onDefaultChange" />
      </view>

      <view wx:if="{{validationErrorText}}" class="validation-error">{{validationErrorText}}</view>
      <button class="save-button" loading="{{saving}}" disabled="{{saving}}" bindtap="onSaveTap">保存地址</button>
    </view>
  </view>
</view>
