<view class="location-picker-page">
  <navigation-bar
    wx:if="{{!ready}}"
    title=""
    back="{{true}}"
    background="#F6EDDF"
    color="#161616"
    show-divider="{{false}}"
  />

  <view wx:if="{{loading}}" class="picker-loading">
    <ui-state type="loading" title="" description="请稍候" />
  </view>
  <view wx:elif="{{!ready}}" class="picker-state">
    <ui-state
      type="error"
      title="地图选址暂不可用"
      description="{{loadErrorText}}"
      action-text="重新加载"
      bindaction="onRetry"
    />
  </view>

  <view wx:else class="picker-content {{panelExpanded ? 'picker-content--expanded' : ''}}">
    <view class="map-shell {{panelDragging ? 'map-shell--dragging' : ''}}" style="height: {{mapVisibleHeight}}px;">
      <map
        id="address-map"
        class="address-map"
        style="height: {{mapHeight}}px;"
        longitude="{{longitude}}"
        latitude="{{latitude}}"
        scale="{{scale}}"
        show-location="{{true}}"
        enable-zoom="{{true}}"
        enable-scroll="{{true}}"
        enable-rotate="{{false}}"
        bindregionchange="onMapRegionChange"
      >
        <cover-view
          class="map-back"
          style="top: {{mapBackTop}}px;"
          bindtap="onBackTap"
          aria-role="button"
          aria-label="返回上一页"
        >
          <cover-image
            class="map-back__icon"
            src="/assets/icons/navigation-back.png"
          />
        </cover-view>
        <cover-view class="center-pin {{dragging ? 'center-pin--dragging' : ''}}">
          <cover-view class="center-pin__head">
            <cover-view class="center-pin__dot"></cover-view>
          </cover-view>
          <cover-view class="center-pin__stem"></cover-view>
          <cover-view class="center-pin__shadow"></cover-view>
        </cover-view>
        <cover-view
          class="map-locate {{locating ? 'map-locate--loading' : ''}}"
          style="bottom: {{mapLocateBottom}}px;"
          bindtap="onLocateTap"
          aria-role="button"
          aria-label="回到当前位置"
        >
          <cover-image
            class="map-locate__icon"
            src="{{atCurrentLocation ? '/assets/icons/location-target-active.png' : '/assets/icons/location-target-idle.png'}}"
          />
        </cover-view>
        <cover-view class="map-tip" style="top: {{mapTipTop}}px;">
          {{resolving ? '正在识别此处地址…' : '拖动地图，让指针落在目标位置'}}
        </cover-view>
      </map>
    </view>

    <view class="search-zone">
      <view class="search-box">
        <image class="search-box__icon" src="/assets/icons/address-search.png" mode="aspectFit" />
        <input
          class="search-box__input"
          value="{{keyword}}"
          confirm-type="search"
          placeholder="搜索小区、大厦、街道或门店"
          placeholder-class="search-box__placeholder"
          bindinput="onSearchInput"
        />
        <text wx:if="{{searching}}" class="search-box__status">搜索中</text>
        <button wx:elif="{{keyword}}" class="search-box__clear" bindtap="onClearSearch">×</button>
      </view>
    </view>

    <view class="result-panel">
      <view wx:if="{{showSearchResults}}" class="search-results">
        <view class="panel-heading">
          <text class="panel-heading__title">搜索结果</text>
          <text class="panel-heading__meta">{{searchTips.length}}个</text>
        </view>
        <scroll-view
          wx:if="{{searchTips.length}}"
          class="place-list"
          scroll-y="{{panelExpanded && !panelDragging}}"
          lower-threshold="160"
          bindscroll="onListScroll"
          bindtouchstart="onListTouchStart"
          bindtouchmove="onListTouchMove"
          bindtouchend="onListTouchEnd"
          bindtouchcancel="onListTouchEnd"
          bindscrolltolower="onSearchLoadMore"
        >
          <button
            wx:for="{{searchTips}}"
            wx:key="id"
            class="place-row"
            data-index="{{index}}"
            bindtap="onTipTap"
          >
            <view class="place-row__body">
              <view class="place-row__name">{{item.name}}</view>
              <view class="place-row__address">{{item.address}}</view>
            </view>
            <text class="place-row__chevron">›</text>
          </button>
          <view wx:if="{{searchLoadingMore}}" class="list-footer">正在加载更多地点…</view>
          <view
            wx:elif="{{searchHasMore}}"
            class="list-footer list-footer--action"
            bindtap="onSearchLoadMore"
          >上滑或点击加载更多</view>
          <view wx:elif="{{!searching}}" class="list-footer">已显示全部搜索结果</view>
        </scroll-view>
        <view wx:elif="{{searching}}" class="empty-result">正在搜索地点…</view>
        <view wx:else class="empty-result">暂未找到可选地点，请更换关键词</view>
      </view>

      <view wx:else class="nearby-results">
        <view class="panel-heading">
          <text class="panel-heading__title">{{selectedPlaceId ? '已选择地点' : '附近地点'}}</text>
        </view>
        <scroll-view
          class="place-list place-list--nearby"
          scroll-y="{{panelExpanded && !panelDragging}}"
          lower-threshold="160"
          bindscroll="onListScroll"
          bindtouchstart="onListTouchStart"
          bindtouchmove="onListTouchMove"
          bindtouchend="onListTouchEnd"
          bindtouchcancel="onListTouchEnd"
          bindscrolltolower="onNearbyLoadMore"
        >
          <button
            wx:for="{{nearbyPlaces}}"
            wx:key="id"
            class="place-row {{selectedPlaceId === item.id ? 'place-row--selected' : ''}}"
            data-index="{{index}}"
            bindtap="onPlaceTap"
          >
            <view class="place-row__body">
              <view class="place-row__name">{{item.name}}</view>
              <view class="place-row__address">{{item.address}}</view>
            </view>
            <view class="place-row__trailing">
              <text wx:if="{{item.distanceText}}" class="place-row__distance">{{item.distanceText}}</text>
              <image
                wx:if="{{selectedPlaceId === item.id}}"
                class="place-row__check"
                src="/assets/icons/address-check.svg"
                mode="aspectFit"
                aria-label="已选择"
              />
            </view>
          </button>
          <view wx:if="{{!nearbyPlaces.length && !resolving}}" class="empty-result">
            附近暂无可选地点，可拖动地图或使用搜索
          </view>
          <view wx:if="{{nearbyLoadingMore}}" class="list-footer">正在加载更多地点…</view>
          <view
            wx:elif="{{nearbyHasMore}}"
            class="list-footer list-footer--action"
            bindtap="onNearbyLoadMore"
          >上滑或点击加载更多</view>
          <view wx:elif="{{nearbyPlaces.length}}" class="list-footer">已显示全部附近地点</view>
        </scroll-view>
      </view>
    </view>

    <view class="confirm-bar">
      <button
        class="confirm-button"
        disabled="{{!selected || resolving}}"
        bindtap="onConfirmTap"
      >
        使用该地址
      </button>
    </view>
  </view>
</view>
