<view class="account-page history-page">
  <navigation-bar
    title=""
    back="{{true}}"
    wide-center="{{true}}"
    show-divider="{{false}}"
    color="#2E1D16"
  >
    <view slot="center" class="history-navigation-title">足迹</view>
    <view wx:if="{{loaded && items.length}}" slot="right" class="history-navigation-actions">
      <button
        wx:if="{{managing}}"
        class="history-navigation-action history-navigation-action--clear"
        loading="{{clearing}}"
        disabled="{{clearing || deleting}}"
        bindtap="onClearTap"
        aria-label="清空全部足迹"
      >清空</button>
      <button
        class="history-navigation-action"
        disabled="{{clearing || deleting || addingSpuId}}"
        bindtap="onManageToggle"
      >{{managing ? '完成' : '管理'}}</button>
    </view>
  </navigation-bar>

  <scroll-view
    class="account-scroll"
    scroll-y="{{true}}"
    enhanced="{{true}}"
    bounces="{{false}}"
    enable-passive="{{true}}"
    show-scrollbar="{{false}}"
    refresher-enabled="{{true}}"
    refresher-triggered="{{contentRefreshing}}"
    refresher-background="#f6f6f6"
    lower-threshold="160"
    bindrefresherrefresh="onContentRefresh"
    bindscrolltolower="onReachBottom"
  >
    <view class="account-content {{managing ? 'account-content--managing' : ''}}">
      <view wx:if="{{!loaded && loading}}" class="account-state">
        <ui-state type="loading" title="正在加载足迹" description="请稍候" />
      </view>
      <view wx:elif="{{!loaded && errorText}}" class="account-state">
        <ui-state type="error" title="当前服务繁忙" description="{{errorText}}" />
      </view>
      <ui-state
        wx:elif="{{loaded && !items.length}}"
        type="empty"
        icon="/assets/icons/empty-history.svg"
        description="还没有足迹"
      />

      <block wx:else>
        <view wx:if="{{errorText}}" class="inline-error"><text>{{errorText}}</text><button bindtap="onRetry">重试</button></view>
        <view
          wx:for="{{groups}}"
          wx:for-item="group"
          wx:key="key"
          class="history-group"
        >
          <view class="history-group__heading" aria-role="heading">
            <text class="history-group__date">{{group.label}}</text>
          </view>
          <view class="history-grid">
            <view
              wx:for="{{group.items}}"
              wx:for-item="item"
              wx:key="spuId"
              class="history-card {{item.available ? '' : 'history-card--disabled'}}"
              aria-role="group"
              aria-label="{{'足迹商品，' + item.title}}"
            >
              <view
                class="history-card__detail"
                data-id="{{item.spuId}}"
                bindtap="onProductTap"
                hover-class="{{managing || item.available ? 'history-card--pressed' : 'none'}}"
                hover-stay-time="80"
                aria-role="button"
                aria-disabled="{{!managing && !item.available}}"
                aria-label="{{item.available ? item.title + '，' + item.priceText + '，查看商品详情' : item.title + '，' + item.priceText + '，商品已下架'}}"
              >
                <view class="history-card__image-wrap">
                  <image
                    wx:if="{{item.hasImage}}"
                    class="history-card__image"
                    src="{{item.imageUrl}}"
                    mode="aspectFill"
                    lazy-load="{{true}}"
                    data-id="{{item.spuId}}"
                    binderror="onImageError"
                    aria-hidden="true"
                  />
                  <view wx:else class="history-card__placeholder" aria-hidden="true">{{item.placeholder}}</view>
                  <view wx:if="{{item.availabilityText}}" class="history-card__unavailable">{{item.availabilityText}}</view>
                  <view
                    wx:if="{{managing}}"
                    class="history-selection-hit"
                    data-id="{{item.spuId}}"
                    catchtap="onSelectionToggle"
                    aria-role="checkbox"
                    aria-checked="{{item.selected}}"
                    aria-label="{{item.selected ? '取消选择' : '选择'}}{{item.title}}"
                  >
                    <view class="history-selection {{item.selected ? 'history-selection--checked' : ''}}">
                      <image
                        wx:if="{{item.selected}}"
                        class="history-selection__check"
                        src="/assets/icons/check-rounded-material-symbols-iconify.svg"
                        mode="aspectFit"
                        aria-hidden="true"
                      />
                    </view>
                  </view>
                </view>
                <view class="history-card__body">
                  <view class="history-card__title">{{item.title}}</view>
                  <view class="history-card__footer">
                    <view class="history-card__price">{{item.priceText}}</view>
                    <view
                      wx:if="{{!managing}}"
                      class="history-card__cart {{addingSpuId === item.spuId ? 'history-card__cart--loading' : ''}} {{!item.available ? 'history-card__cart--disabled' : ''}}"
                      data-id="{{item.spuId}}"
                      catchtap="onAddCartTap"
                      hover-class="history-card__cart--pressed"
                      hover-stay-time="80"
                      aria-role="button"
                      aria-disabled="{{!item.available}}"
                      aria-label="{{item.available ? '将' + item.title + '加入购物车' : item.title + '已下架'}}"
                    >
                      <view wx:if="{{addingSpuId === item.spuId}}" class="history-card__cart-spinner" aria-hidden="true"></view>
                      <block wx:else>
                        <view class="history-card__cart-plus-horizontal" aria-hidden="true"></view>
                        <view class="history-card__cart-plus-vertical" aria-hidden="true"></view>
                      </block>
                    </view>
                  </view>
                </view>
              </view>
            </view>
          </view>
        </view>
        <view wx:if="{{loadingMore}}" class="list-footer">正在加载更多…</view>
        <view wx:elif="{{items.length && !hasMore}}" class="list-footer">没有更多足迹了</view>
      </block>
    </view>
  </scroll-view>

  <view wx:if="{{managing && items.length}}" class="history-management-bar">
    <view
      class="history-select-all"
      bindtap="onSelectAllToggle"
      aria-role="checkbox"
      aria-checked="{{allSelected}}"
    >
      <view class="history-selection history-selection--compact {{allSelected ? 'history-selection--checked' : ''}}">
        <image
          wx:if="{{allSelected}}"
          class="history-selection__check"
          src="/assets/icons/check-rounded-material-symbols-iconify.svg"
          mode="aspectFit"
          aria-hidden="true"
        />
      </view>
      <text>全选</text>
    </view>
    <text class="history-selected-count">已选 {{selectedIds.length}} 个商品</text>
    <button
      class="history-batch-delete"
      loading="{{deleting}}"
      disabled="{{!selectedIds.length || deleting || clearing}}"
      bindtap="onBatchDeleteTap"
    >删除</button>
  </view>
</view>
