<view class="user-profile-page">
  <navigation-bar
    title="个人资料"
    back="{{true}}"
    round-back="{{true}}"
    show-divider="{{false}}"
    color="#333333"
    loading="{{loading || saving || savingAvatar || loggingOut}}"
  />

  <scroll-view
    class="user-profile-scroll"
    scroll-y="{{true}}"
    enhanced="{{true}}"
    bounces="{{true}}"
    enable-passive="{{true}}"
    show-scrollbar="{{false}}"
  >
  <view class="user-profile-content">
    <view class="profile-card">
      <view class="avatar-slot">
        <image
          class="avatar-button__image"
          src="{{avatarUrl}}"
          mode="aspectFill"
        />
        <button
          class="avatar-button"
          open-type="chooseAvatar"
          disabled="{{saving || savingAvatar || loggingOut}}"
          bindchooseavatar="onAvatarChoose"
          aria-label="更换头像"
        ></button>
      </view>
      <view class="profile-field">
        <text class="profile-field__label">昵称</text>
        <input
          class="profile-field__input"
          type="nickname"
          value="{{nickname}}"
          maxlength="32"
          confirm-type="done"
          disabled="{{saving || savingAvatar || loggingOut}}"
          placeholder="选择微信昵称"
          placeholder-class="profile-field__placeholder"
          bindinput="onNicknameInput"
        />
      </view>
      <view class="profile-field profile-field--last">
        <text class="profile-field__label">手机号</text>
        <view class="profile-field__value">{{phoneNumberMasked}}</view>
      </view>
    </view>

    <view wx:if="{{loadErrorText}}" class="profile-sync-note">{{loadErrorText}}</view>
    <view wx:if="{{validationErrorText}}" class="profile-error">{{validationErrorText}}</view>

    <view class="profile-actions">
      <button
        class="save-button {{saving || savingAvatar || loggingOut ? 'save-button--disabled' : ''}}"
        loading="{{saving}}"
        disabled="{{saving || savingAvatar || loggingOut}}"
        hover-class="save-button--pressed"
        bindtap="onSaveTap"
      >保存</button>

      <button
        class="logout-button {{saving || savingAvatar || loggingOut ? 'logout-button--disabled' : ''}}"
        loading="{{loggingOut}}"
        disabled="{{saving || savingAvatar || loggingOut}}"
        bindtap="onLogoutTap"
      >退出登录</button>
    </view>
  </view>
  </scroll-view>
</view>
