<view class="hero-section">
  <swiper
    class="hero-swiper"
    current="{{currentBanner}}"
    autoplay="{{banners.length > 1}}"
    circular="{{banners.length > 1}}"
    interval="4500"
    duration="650"
    easing-function="easeInOutCubic"
    bindchange="onBannerChange"
  >
    <swiper-item
      wx:for="{{banners}}"
      wx:key="id"
      class="hero-item"
      data-index="{{index}}"
      bindtap="onBannerTap"
      hover-class="{{item.navigationPath ? 'hero-item--pressed' : 'none'}}"
      aria-role="{{item.navigationPath ? 'button' : 'img'}}"
      aria-label="{{item.ariaLabel}}"
    >
      <image
        wx:if="{{item.hasImage}}"
        class="hero-image"
        src="{{item.imageUrl}}"
        mode="aspectFit"
        lazy-load="{{true}}"
        data-index="{{index}}"
        binderror="onBannerImageError"
      />
      <view wx:else class="hero-placeholder">
        <view class="hero-placeholder__seal">灶</view>
        <view class="hero-placeholder__title">灶香集</view>
        <view class="hero-placeholder__subtitle">地道川味 · 真材实料</view>
      </view>

      <view wx:if="{{item.title || item.subtitle}}" class="hero-copy">
        <view wx:if="{{item.title}}" class="hero-copy__title">{{item.title}}</view>
        <view wx:if="{{item.subtitle}}" class="hero-copy__subtitle">{{item.subtitle}}</view>
      </view>
    </swiper-item>
  </swiper>
  <view class="hero-top-wash"></view>
  <view class="hero-fade"></view>
  <view
    wx:if="{{banners.length > 1}}"
    class="banner-dots"
    aria-label="轮播图位置，第 {{currentBanner + 1}} 张，共 {{banners.length}} 张"
  >
    <view
      wx:for="{{banners}}"
      wx:key="id"
      class="banner-dot {{currentBanner === index ? 'is-active' : ''}}"
    ></view>
  </view>
</view>
