<view class="catalog-browser {{tabPage || scrollPage ? 'catalog-browser--fixed' : ''}} {{tabPage ? 'catalog-browser--tab' : ''}}">
  <view wx:if="{{tabPage}}" class="catalog-tab-wash" aria-hidden="true"></view>
  <view class="catalog-tools">
    <view class="sort-bar">
      <view
        class="sort-item {{sortMode === 'COMPREHENSIVE' ? 'sort-item--active' : ''}}"
        data-sort="COMPREHENSIVE"
        bindtap="onSortTap"
        aria-role="button"
        aria-label="按综合排序"
      >综合</view>
      <view
        class="sort-item {{sortMode === 'SALES_DESC' ? 'sort-item--active' : ''}}"
        data-sort="SALES_DESC"
        bindtap="onSortTap"
        aria-role="button"
        aria-label="按销量从高到低排序"
      >销量</view>
      <view
        class="sort-item {{sortMode === 'PRICE_ASC' || sortMode === 'PRICE_DESC' ? 'sort-item--active' : ''}}"
        data-sort="PRICE"
        bindtap="onSortTap"
        aria-role="button"
        aria-label="{{sortMode === 'PRICE_ASC' ? '价格升序，点击切换为降序' : sortMode === 'PRICE_DESC' ? '价格降序，点击切换为升序' : '按价格排序'}}"
      >
        <text>价格</text>
        <image
          class="sort-item__arrow {{sortMode === 'PRICE_ASC' ? 'sort-item__arrow--up' : ''}}"
          src="/assets/icons/chevron-right-light.svg"
          mode="aspectFit"
          aria-hidden="true"
        />
      </view>
      <view
        class="sort-item {{hasFilters ? 'sort-item--active' : ''}}"
        bindtap="onFilterOpen"
        aria-role="button"
        aria-label="{{hasFilters ? '筛选，已启用' : '筛选商品'}}"
      >
        <text>筛选</text>
        <view wx:if="{{hasFilters}}" class="sort-item__dot" aria-hidden="true"></view>
      </view>
      <view
        class="view-toggle"
        bindtap="onViewToggle"
        hover-class="view-toggle--pressed"
        aria-role="button"
        aria-label="{{viewMode === 'grid' ? '切换为列表展示' : '切换为网格展示'}}"
      >
        <image
          class="view-toggle__icon"
          src="{{viewMode === 'grid' ? '/assets/icons/view-list-rounded.svg' : '/assets/icons/view-grid-outline.svg'}}"
          mode="aspectFit"
          aria-hidden="true"
        />
      </view>
    </view>

    <scroll-view
      class="category-scroll"
      scroll-x="{{true}}"
      enhanced="{{true}}"
      show-scrollbar="{{false}}"
      enable-flex="{{true}}"
    >
      <view class="category-track">
        <view
          wx:for="{{categoryTabs}}"
          wx:key="id"
          class="category-tab {{item.selected ? 'category-tab--active' : ''}}"
          data-id="{{item.id}}"
          bindtap="onCategoryTap"
          hover-class="category-tab--pressed"
          aria-role="button"
          aria-label="{{item.name}}{{item.selected ? '，已选择' : ''}}"
        >{{item.name}}</view>
      </view>
    </scroll-view>

    <view wx:if="{{activeKeyword}}" class="search-summary">
      <text class="search-summary__keyword">“{{activeKeyword}}”</text>
      <text>相关商品 {{total}} 件</text>
    </view>
  </view>

  <scroll-view
    class="catalog-content"
    scroll-y="{{tabPage || scrollPage}}"
    enhanced="{{tabPage || scrollPage}}"
    show-scrollbar="{{false}}"
    lower-threshold="160"
    refresher-enabled="{{tabPage || scrollPage}}"
    refresher-triggered="{{contentRefreshing}}"
    refresher-background="#F3F3F7"
    bindscrolltolower="onContentLower"
    bindrefresherrefresh="onContentRefresh"
  >
    <view wx:if="{{!loaded && loading}}" class="catalog-state">
      <ui-state type="loading" title="正在加载商品" description="商品马上就来" />
    </view>

    <view wx:elif="{{!loaded && errorText}}" class="catalog-state">
      <ui-state
        type="error"
        title="商品加载失败"
        description="{{errorText}}"
        action-text="重新加载"
        bindaction="onRetry"
      />
    </view>

    <view wx:elif="{{loaded && !products.length}}" class="catalog-state catalog-state--empty">
      <ui-state
        type="empty"
        icon="/assets/icons/empty-search.svg"
        description="{{hasFilters ? '没有符合当前筛选的商品' : activeKeyword ? '没有找到相关商品' : '这个分类还没有商品'}}"
      />
    </view>

    <block wx:else>
      <view class="catalog-grid catalog-grid--{{viewMode}}">
        <view wx:for="{{products}}" wx:key="spuId" class="catalog-item">
          <product-card
            product="{{item}}"
            variant="{{viewMode === 'list' ? 'list' : 'compact'}}"
            flat="{{true}}"
            adding="{{addingSpuId === item.spuId}}"
            bindselect="onProductSelect"
            bindadd="onProductAdd"
          />
        </view>
      </view>

      <view wx:if="{{loadingMore}}" class="catalog-footer">正在加载更多…</view>
      <view
        wx:elif="{{errorText}}"
        class="catalog-footer catalog-footer--error"
        bindtap="onRetry"
        aria-role="button"
      >{{errorText}}，点击重试</view>
      <view
        wx:elif="{{sourceProducts.length && sourceProducts.length >= total}}"
        class="catalog-footer catalog-footer--done"
      >已经到底了</view>
    </block>
  </scroll-view>

  <view
    wx:if="{{tabPage}}"
    class="catalog-tab-wash"
    aria-hidden="true"
  ></view>

  <view
    wx:if="{{filterVisible}}"
    class="filter-mask"
    bindtap="onFilterClose"
    catchtouchmove="noop"
    aria-role="dialog"
    aria-label="商品筛选"
  >
    <view class="filter-panel" catchtap="noop">
      <view class="filter-panel__handle" aria-hidden="true"></view>
      <view class="filter-panel__header">
        <text class="filter-panel__title">筛选商品</text>
        <image
          class="filter-panel__close"
          src="/assets/icons/close-material-symbols.svg"
          mode="aspectFit"
          bindtap="onFilterClose"
          aria-role="button"
          aria-label="关闭筛选"
        />
      </view>

      <scroll-view class="filter-panel__content" scroll-y="{{true}}">
        <view class="filter-group">
          <view class="filter-group__title">分类</view>
          <view class="filter-options">
            <view
              wx:for="{{draftCategoryTabs}}"
              wx:key="id"
              class="filter-option {{item.selected ? 'filter-option--active' : ''}}"
              data-id="{{item.id}}"
              bindtap="onFilterCategoryTap"
              aria-role="button"
            >{{item.name}}</view>
          </view>
        </view>

        <view
          wx:for="{{parameterFilterGroups}}"
          wx:key="key"
          wx:for-item="group"
          class="filter-group"
        >
          <view class="filter-group__title">{{group.name}}</view>
          <view class="filter-options">
            <view
              wx:for="{{group.options}}"
              wx:key="key"
              wx:for-item="option"
              class="filter-option {{option.selected ? 'filter-option--active' : ''}} {{option.disabled ? 'filter-option--disabled' : ''}}"
              data-key="{{group.key}}"
              data-value="{{option.value}}"
              bindtap="onFilterOptionTap"
              aria-role="button"
              aria-disabled="{{option.disabled}}"
            >
              <text>{{option.label}}</text>
              <text class="filter-option__count">{{option.count}}</text>
            </view>
          </view>
        </view>

        <view wx:if="{{!parameterFilterGroups.length}}" class="filter-panel__empty">
          当前商品暂无可筛选参数
        </view>
      </scroll-view>

      <view class="filter-panel__actions">
        <view
          class="filter-action filter-action--secondary"
          bindtap="onFilterReset"
          aria-role="button"
        >重置</view>
        <view
          class="filter-action filter-action--primary"
          bindtap="onFilterApply"
          aria-role="button"
        >确定</view>
      </view>
    </view>
  </view>
</view>
