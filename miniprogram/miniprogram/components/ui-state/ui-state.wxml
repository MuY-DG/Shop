<view class="ui-state ui-state--{{type}}">
  <view wx:if="{{type === 'loading'}}" class="ui-state__loading-toast" aria-label="{{title || description}}">
    <view class="ui-state__loading"></view>
    <text class="ui-state__loading-text">{{title || description}}</text>
  </view>

  <block wx:elif="{{type === 'empty'}}">
    <image
      class="ui-state__empty-icon"
      src="{{icon}}"
      mode="aspectFit"
      aria-hidden="true"
    />
    <view class="ui-state__empty-description">{{description || title}}</view>
  </block>

  <block wx:else>
    <view wx:if="{{title}}" class="ui-state__title">{{title}}</view>
    <view wx:if="{{description}}" class="ui-state__description">{{description}}</view>
    <view wx:if="{{actionText}}" class="ui-state__action">
      <ui-button
        variant="secondary"
        size="small"
        bindtap="handleAction"
      >{{actionText}}</ui-button>
    </view>
  </block>
</view>
