<view class="ui-state ui-state--{{type}}">
  <view class="ui-state__visual">
    <view wx:if="{{type === 'loading'}}" class="ui-state__loading"></view>

    <view wx:elif="{{type === 'error'}}" class="ui-state__error-mark"></view>

    <view wx:else class="ui-state__empty-box">
      <view class="ui-state__empty-line ui-state__empty-line--long"></view>
      <view class="ui-state__empty-line"></view>
    </view>
  </view>

  <view wx:if="{{title}}" class="ui-state__title">{{title}}</view>
  <view wx:if="{{description}}" class="ui-state__description">{{description}}</view>
  <view wx:if="{{actionText}}" class="ui-state__action">
    <ui-button
      variant="{{type === 'error' ? 'danger' : 'secondary'}}"
      size="small"
      bindtap="handleAction"
    >{{actionText}}</ui-button>
  </view>
</view>
