<view class="detail-card">
  <view class="section-heading">
    <text class="section-heading__title">批量更划算</text>
    <text class="section-heading__subtitle">按单次购买数量自动匹配</text>
  </view>
  <view class="wholesale-grid">
    <view
      wx:for="{{tiers}}"
      wx:key="minQuantity"
      class="wholesale-tier {{item.active ? 'wholesale-tier--active' : ''}}"
    >
      <text class="wholesale-quantity">{{item.minQuantity}} 件起</text>
      <text class="wholesale-price">¥{{item.priceText}} / 件</text>
    </view>
  </view>
</view>
