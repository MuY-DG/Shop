<view class="detail-card">
  <view class="section-heading">
    <text class="section-heading__title">商品特点</text>
    <text class="section-heading__subtitle">一眼看懂这款锅底</text>
  </view>
  <view class="parameter-list">
    <view wx:for="{{items}}" wx:key="id" class="parameter-row">
      <text class="parameter-name">{{item.name}}</text>
      <view class="parameter-value">
        <text class="{{item.fact.kind === 'spice' ? 'parameter-spice parameter-spice--' + item.fact.spiceTone : ''}}">{{item.value}}</text>
        <view wx:if="{{item.fact.kind === 'spice'}}" class="parameter-spice-icons">
          <image
            wx:for="{{item.fact.spiceIconIndexes}}"
            wx:for-item="iconIndex"
            wx:key="*this"
            class="parameter-icon"
            src="{{item.fact.iconPath}}"
            mode="aspectFit"
          />
        </view>
        <text wx:if="{{item.fact.servingText}}" class="parameter-extra">
          {{item.fact.servingText}}
        </text>
      </view>
    </view>
  </view>
</view>
