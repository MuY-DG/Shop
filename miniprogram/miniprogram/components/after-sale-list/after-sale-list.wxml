<view class="after-sale-list">
  <view class="after-sale-tabs" aria-role="tablist">
    <view
      wx:for="{{tabs}}"
      wx:key="value"
      class="after-sale-tab {{activeGroup === item.value ? 'after-sale-tab--active' : ''}}"
      data-group="{{item.value}}"
      bindtap="onTabTap"
      hover-class="after-sale-tab--pressed"
      aria-role="tab"
      aria-label="{{item.label}}{{activeGroup === item.value ? '，已选择' : ''}}"
    >{{item.label}}</view>
  </view>

  <scroll-view
    class="after-sale-scroll"
    scroll-y="{{true}}"
    enhanced="{{true}}"
    bounces="{{false}}"
    enable-passive="{{true}}"
    show-scrollbar="{{false}}"
    refresher-enabled="{{true}}"
    refresher-triggered="{{contentRefreshing}}"
    refresher-background="#f6f6f6"
    lower-threshold="160"
    bindrefresherrefresh="onContentRefresh"
    bindscrolltolower="onReachBottom"
  >
    <view class="after-sale-content">
      <view wx:if="{{!loaded && loading}}" class="after-sale-state after-sale-state--skeleton">
        <ui-state type="loading" skeleton-type="record-list" title="正在加载售后记录" description="请稍候" />
      </view>
      <view wx:elif="{{!loaded && errorText}}" class="after-sale-state">
        <ui-state type="error" title="当前服务繁忙" description="{{errorText}}" />
      </view>
      <view wx:elif="{{loaded && !records.length}}" class="after-sale-state">
        <ui-state
          type="empty"
          icon="/assets/icons/empty-after-sale.svg"
          description="{{activeGroup === 'PROCESSING' ? '暂无处理中的售后' : '暂无已完结的售后'}}"
        />
      </view>

      <block wx:else>
        <view wx:if="{{errorText}}" class="inline-error">
          <text>{{errorText}}</text>
          <button bindtap="onRetry">重试</button>
        </view>
        <view wx:for="{{records}}" wx:key="id" class="after-sale-card">
          <view
            class="after-sale-card__detail"
            data-id="{{item.id}}"
            bindtap="onRecordTap"
            hover-class="after-sale-card--pressed"
            hover-stay-time="80"
            aria-role="button"
          >
            <view class="after-sale-card__header">
              <text class="after-sale-card__order">订单 {{item.orderNo}}</text>
              <text class="after-sale-card__type">{{item.listTypeText}}</text>
            </view>
            <view wx:if="{{item.items.length}}" class="after-sale-card__items">
              <view
                wx:for="{{item.items}}"
                wx:for-item="product"
                wx:key="id"
                class="after-sale-product {{index ? 'after-sale-product--divided' : ''}}"
              >
                <view class="after-sale-product__image-shell">
                  <image
                    wx:if="{{product.hasImage}}"
                    class="after-sale-product__image"
                    src="{{product.imageUrl}}"
                    mode="aspectFill"
                    data-id="{{item.id}}"
                    data-item-id="{{product.id}}"
                    binderror="onItemImageError"
                  />
                  <image
                    wx:else
                    class="after-sale-product__fallback"
                    src="/assets/icons/empty-products.svg"
                    mode="aspectFit"
                    aria-hidden="true"
                  />
                </view>
                <view class="after-sale-product__body">
                  <view class="after-sale-product__title">{{product.titleText}}</view>
                  <view wx:if="{{product.specificationText}}" class="after-sale-product__spec">{{product.specificationText}}</view>
                  <view class="after-sale-product__quantity">{{product.requestedQuantityText}}</view>
                </view>
                <view class="after-sale-product__refund">
                  <text class="after-sale-product__refund-label">退款：</text>
                  <text class="after-sale-product__refund-value">{{product.requestedAmountText}}</text>
                </view>
              </view>
            </view>
            <view wx:else class="after-sale-card__empty-product">商品信息暂不可用</view>
            <view class="after-sale-card__status-summary">
              <text class="after-sale-card__status-text">{{item.cardStatusText}}</text>
              <text class="after-sale-card__status-description">{{item.cardStatusDescription}}</text>
            </view>
          </view>

          <view class="after-sale-card__actions">
            <view wx:if="{{item.canDelete}}" class="after-sale-more">
              <button
                class="after-sale-action after-sale-action--more"
                data-id="{{item.id}}"
                disabled="{{actionAfterSaleId}}"
                catchtap="onMoreTap"
              >更多</button>
              <view wx:if="{{openMenuAfterSaleId === item.id}}" class="after-sale-menu">
                <button
                  class="after-sale-menu__item"
                  data-id="{{item.id}}"
                  catchtap="onDeleteTap"
                >删除售后单</button>
              </view>
            </view>
            <view class="after-sale-card__action-right">
              <button
                class="after-sale-action after-sale-action--secondary"
                data-order-id="{{item.orderId}}"
                disabled="{{actionAfterSaleId}}"
                catchtap="onCustomerServiceTap"
              >联系客服</button>
              <button
                wx:if="{{item.canReapply}}"
                class="after-sale-action after-sale-action--primary"
                data-id="{{item.id}}"
                disabled="{{actionAfterSaleId}}"
                catchtap="onReapplyTap"
              >重新申请</button>
            </view>
          </view>
        </view>
        <view wx:if="{{loadingMore}}" class="page-tip">正在加载更多</view>
        <view wx:elif="{{records.length && !hasMore}}" class="page-tip">已显示全部售后记录</view>
      </block>
    </view>
  </scroll-view>
</view>
