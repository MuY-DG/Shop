<view class="summary-card">
  <view class="price-row">
    <view wx:if="{{priceText}}" class="current-price">
      <text class="currency">¥</text>
      <text class="price-integer">{{priceIntegerText}}</text>
      <text class="price-decimal">{{priceDecimalText}}</text>
    </view>
    <text wx:else class="price-unavailable">暂无报价</text>
    <text wx:if="{{hasOriginalPrice}}" class="original-price">¥{{originalPriceText}}</text>
    <text wx:if="{{wholesaleApplied}}" class="wholesale-active">批发价已生效</text>
    <text wx:if="{{salesText}}" class="sales-text">{{salesText}}</text>
  </view>

  <view class="product-title">{{detail.title}}</view>
  <view wx:if="{{detail.subtitle}}" class="product-subtitle">{{detail.subtitle}}</view>
  <scroll-view
    wx:if="{{detail.sellingPoints && detail.sellingPoints.length}}"
    class="selling-point-scroll"
    scroll-x="{{true}}"
    enhanced="{{true}}"
    show-scrollbar="{{false}}"
    enable-flex="{{true}}"
  >
    <view class="selling-point-track">
      <view
        wx:for="{{detail.sellingPoints}}"
        wx:key="*this"
        class="selling-point-tag"
      >{{item}}</view>
    </view>
  </scroll-view>
</view>
