<view
  class="ui-card ui-card--{{variant}} ui-card--padding-{{padding}} {{interactive ? 'ui-card--interactive' : ''}}"
  hover-class="{{interactive ? 'ui-card--pressed' : 'none'}}"
  hover-stay-time="80"
  bindtap="handleTap"
  aria-role="{{interactive ? 'button' : 'group'}}"
  aria-label="{{ariaLabel}}"
>
  <slot />
</view>
