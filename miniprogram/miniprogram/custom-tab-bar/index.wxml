<view
  class="tab-bar {{isAndroid ? 'tab-bar--android' : ''}}"
  hidden="{{hidden}}"
  aria-role="tablist"
  aria-label="主导航"
>
  <view class="tab-bar__items" style="transform: translateY({{itemOffsetRpx}}rpx);">
    <view
      wx:for="{{list}}"
      wx:key="pagePath"
      class="tab-bar__item {{selected === index ? 'tab-bar__item--selected' : ''}}"
      data-index="{{index}}"
      bindtap="onTabTap"
      hover-class="tab-bar__item--pressed"
      aria-role="tab"
      aria-label="{{item.ariaLabel}}{{selected === index ? '，当前页面' : ''}}"
      aria-selected="{{selected === index}}"
    >
      <view class="tab-bar__icon-wrap" aria-hidden="true">
        <view class="tab-bar__icon">
          <image
            class="tab-bar__icon-image {{selected === index ? '' : 'tab-bar__icon-image--visible'}}"
            src="{{item.iconPath}}"
            mode="aspectFit"
          />
          <image
            class="tab-bar__icon-image {{selected === index ? 'tab-bar__icon-image--visible' : ''}}"
            src="{{item.selectedIconPath}}"
            mode="aspectFit"
          />
        </view>
        <text wx:if="{{item.badge}}" class="tab-bar__badge">{{item.badge}}</text>
      </view>
      <text class="tab-bar__label">{{item.text}}</text>
    </view>
  </view>
</view>
