<view class="tab-bar" aria-role="tablist" aria-label="主导航">
  <view class="tab-bar__items">
    <view
      wx:for="{{list}}"
      wx:key="pagePath"
      class="tab-bar__item {{selected === index ? 'tab-bar__item--selected' : ''}}"
      data-index="{{index}}"
      bindtap="onTabTap"
      hover-class="tab-bar__item--pressed"
      aria-role="tab"
      aria-label="{{item.text}}{{selected === index ? '，当前页面' : ''}}"
      aria-selected="{{selected === index}}"
    >
      <view class="tab-bar__icon tab-bar__icon--{{item.icon}}" aria-hidden="true">
        <block wx:if="{{item.icon === 'home'}}">
          <view class="home-icon__roof"></view>
          <view class="home-icon__body"></view>
        </block>
        <block wx:elif="{{item.icon === 'category'}}">
          <view class="category-icon__cell category-icon__cell--one"></view>
          <view class="category-icon__cell category-icon__cell--two"></view>
          <view class="category-icon__cell category-icon__cell--three"></view>
          <view class="category-icon__cell category-icon__cell--four"></view>
        </block>
        <block wx:elif="{{item.icon === 'message'}}">
          <view class="message-icon__bubble"></view>
          <view class="message-icon__dot message-icon__dot--one"></view>
          <view class="message-icon__dot message-icon__dot--two"></view>
          <view class="message-icon__dot message-icon__dot--three"></view>
        </block>
        <block wx:elif="{{item.icon === 'cart'}}">
          <view class="cart-icon__handle"></view>
          <view class="cart-icon__basket"></view>
          <view class="cart-icon__wheel cart-icon__wheel--one"></view>
          <view class="cart-icon__wheel cart-icon__wheel--two"></view>
        </block>
        <block wx:else>
          <view class="profile-icon__head"></view>
          <view class="profile-icon__body"></view>
        </block>
        <text wx:if="{{item.badge}}" class="tab-bar__badge">{{item.badge}}</text>
      </view>
      <text class="tab-bar__label">{{item.text}}</text>
    </view>
  </view>
</view>
