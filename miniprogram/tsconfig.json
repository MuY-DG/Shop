{
  "compilerOptions": {
    "strict": true,
    "target": "ES2017",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "types": ["miniprogram-api-typings"],
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "lib": ["ES2020"]
  },
  "include": [
    "./miniprogram/**/*.ts",
    "./typings/index.d.ts"
  ],
  "exclude": [
    "./node_modules",
    "./typings/types"
  ]
}
