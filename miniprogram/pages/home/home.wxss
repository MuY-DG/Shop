.hero {
  padding: 48rpx 32rpx;
  border-radius: 16rpx;
  background: #b3261e;
  color: #ffffff;
}

.eyebrow {
  font-size: 24rpx;
  opacity: 0.82;
  margin-bottom: 12rpx;
}

.title {
  font-size: 48rpx;
  font-weight: 800;
}

.subtitle {
  margin-top: 16rpx;
  font-size: 28rpx;
}

.health-line {
  margin-top: 28rpx;
  font-size: 22rpx;
  opacity: 0.78;
}

.section-block {
  margin-top: 28rpx;
}

.section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 18rpx;
}

.section-link {
  color: #b3261e;
  font-size: 26rpx;
  font-weight: 600;
}

.category-strip {
  width: 100%;
  white-space: nowrap;
}

.category-track {
  display: flex;
  gap: 16rpx;
}

.category-pill {
  flex: 0 0 auto;
  display: inline-flex;
  align-items: center;
  gap: 12rpx;
  max-width: 240rpx;
  padding: 18rpx 22rpx;
  border-radius: 12rpx;
  background: #ffffff;
  box-sizing: border-box;
  box-shadow: 0 10rpx 30rpx rgba(110, 82, 67, 0.08);
}

.category-icon-image,
.category-icon-text {
  width: 48rpx;
  height: 48rpx;
  border-radius: 8rpx;
  flex: 0 0 auto;
}

.category-icon-text {
  display: flex;
  align-items: center;
  justify-content: center;
  background: #f5dfd8;
  color: #b3261e;
  font-size: 22rpx;
  font-weight: 700;
}

.category-name {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-size: 26rpx;
  font-weight: 600;
}

.empty-state {
  padding: 40rpx 0;
  color: #7a6f68;
  font-size: 26rpx;
  text-align: center;
}

.product-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 18rpx;
}

.product-card {
  overflow: hidden;
  border-radius: 12rpx;
  background: #ffffff;
  box-shadow: 0 12rpx 32rpx rgba(110, 82, 67, 0.08);
}

.product-image-wrap {
  width: 100%;
  height: 330rpx;
  background: #ead9cf;
}

.product-image,
.product-image-placeholder {
  width: 100%;
  height: 100%;
}

.product-image-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #9c5549;
  font-size: 30rpx;
  font-weight: 700;
}

.product-info {
  padding: 18rpx;
}

.product-title {
  min-height: 68rpx;
  color: #241f1c;
  font-size: 28rpx;
  font-weight: 700;
  line-height: 34rpx;
  display: -webkit-box;
  overflow: hidden;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.product-subtitle {
  margin-top: 8rpx;
  min-height: 30rpx;
  color: #7a6f68;
  font-size: 24rpx;
  line-height: 30rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.selling-points {
  display: flex;
  gap: 8rpx;
  min-height: 34rpx;
  margin-top: 12rpx;
  overflow: hidden;
}

.selling-point {
  flex: 0 1 auto;
  max-width: 130rpx;
  padding: 4rpx 10rpx;
  border-radius: 6rpx;
  background: #fff4d8;
  color: #8b5a09;
  font-size: 20rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.product-meta {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 8rpx;
  margin-top: 18rpx;
}

.price {
  color: #b3261e;
  font-size: 30rpx;
  font-weight: 800;
}

.stock {
  color: #7a6f68;
  font-size: 22rpx;
  white-space: nowrap;
}

.sold-out {
  color: #b84a3d;
}
