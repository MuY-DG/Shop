<view class="page home-page">
  <view class="hero">
    <view class="eyebrow">Hotpot Shop</view>
    <view class="title">火锅底料商城</view>
    <view class="subtitle">精选牛油、清油、番茄和菌汤锅底</view>
    <view class="health-line">{{healthText}}</view>
  </view>

  <view class="section-block">
    <view class="section-header">
      <view class="section-title">分类</view>
    </view>
    <scroll-view class="category-strip" scroll-x="true" enhanced="true" show-scrollbar="false">
      <view class="category-track">
        <view
          wx:for="{{categories}}"
          wx:key="id"
          class="category-pill"
          data-id="{{item.id}}"
          bindtap="onCategoryTap"
        >
          <image wx:if="{{item.iconUrl}}" class="category-icon-image" src="{{item.iconUrl}}" mode="aspectFill" />
          <view wx:else class="category-icon-text">{{item.iconText}}</view>
          <view class="category-name">{{item.name}}</view>
        </view>
      </view>
    </scroll-view>
  </view>

  <view class="section-block">
    <view class="section-header">
      <view class="section-title">推荐商品</view>
      <navigator class="section-link" open-type="switchTab" url="/pages/product/list/list">全部</navigator>
    </view>

    <view wx:if="{{loadingProducts}}" class="empty-state">商品加载中...</view>
    <view wx:elif="{{productErrorText}}" class="empty-state">{{productErrorText}}</view>
    <view wx:elif="{{products.length === 0}}" class="empty-state">暂无商品</view>
    <view wx:else class="product-grid">
      <view
        wx:for="{{products}}"
        wx:key="id"
        class="product-card"
        data-id="{{item.id}}"
        bindtap="onProductTap"
      >
        <view class="product-image-wrap">
          <image wx:if="{{item.mainImage}}" class="product-image" src="{{item.mainImage}}" mode="aspectFill" />
          <view wx:else class="product-image-placeholder">火锅</view>
        </view>
        <view class="product-info">
          <view class="product-title">{{item.title}}</view>
          <view class="product-subtitle">{{item.subtitle}}</view>
          <view class="selling-points">
            <view
              wx:for="{{item.sellingPoints}}"
              wx:key="*this"
              wx:for-item="point"
              class="selling-point"
            >
              {{point}}
            </view>
          </view>
          <view class="product-meta">
            <view class="price">{{item.priceText}}</view>
            <view class="stock {{item.soldOut ? 'sold-out' : ''}}">{{item.stockText}}</view>
          </view>
        </view>
      </view>
    </view>
  </view>
</view>
