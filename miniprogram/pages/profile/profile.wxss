.profile-page {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.status-card,
.action-list {
  border-radius: 12rpx;
  background: #ffffff;
  box-shadow: 0 12rpx 32rpx rgba(110, 82, 67, 0.08);
}

.status-card {
  padding: 24rpx;
}

.profile-row {
  color: #241f1c;
  font-size: 28rpx;
  line-height: 40rpx;
}

.profile-row + .profile-row {
  margin-top: 12rpx;
}

.profile-warning {
  margin-top: 12rpx;
  color: #b26a2b;
  font-size: 24rpx;
  line-height: 36rpx;
}

.phone-button {
  margin-top: 24rpx;
}

.action-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  padding: 24rpx;
  color: #241f1c;
  font-size: 28rpx;
  line-height: 40rpx;
}

.action-row + .action-row {
  border-top: 1rpx solid #f0e4da;
}

.action-title {
  font-weight: 700;
}

.action-arrow {
  color: #8a6f61;
  font-size: 34rpx;
  line-height: 34rpx;
}
