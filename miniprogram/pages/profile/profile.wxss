.profile-page {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.status-card,
.action-list {
  border-radius: 12rpx;
  background: #ffffff;
  box-shadow: 0 12rpx 32rpx rgba(110, 82, 67, 0.08);
}

.status-card {
  padding: 24rpx;
}

.profile-row {
  color: #241f1c;
  font-size: 28rpx;
  line-height: 40rpx;
}

.profile-row + .profile-row {
  margin-top: 12rpx;
}

.nickname-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  margin-top: 12rpx;
}

.nickname-edit-button,
.nickname-action-button {
  flex: none;
  margin: 0;
}

.nickname-editor {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 16rpx;
}

.nickname-input {
  flex: 1;
  min-width: 0;
  height: 64rpx;
  box-sizing: border-box;
  padding: 0 20rpx;
  border: 1rpx solid #e3d2c5;
  border-radius: 8rpx;
  background: #fffdfa;
  color: #241f1c;
  font-size: 26rpx;
}

.nickname-actions {
  display: flex;
  gap: 8rpx;
}

.nickname-save-button {
  color: #ffffff;
  background: #8a5c42;
}

.nickname-message {
  margin-top: 12rpx;
  color: #8a5c42;
  font-size: 24rpx;
  line-height: 36rpx;
}

.profile-warning {
  margin-top: 12rpx;
  color: #b26a2b;
  font-size: 24rpx;
  line-height: 36rpx;
}

.phone-button {
  margin-top: 24rpx;
}

.action-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  padding: 24rpx;
  color: #241f1c;
  font-size: 28rpx;
  line-height: 40rpx;
}

.action-row + .action-row {
  border-top: 1rpx solid #f0e4da;
}

.action-title {
  font-weight: 700;
}

.action-arrow {
  color: #8a6f61;
  font-size: 34rpx;
  line-height: 34rpx;
}
