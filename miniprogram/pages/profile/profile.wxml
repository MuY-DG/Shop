<view class="profile-page">
  <view class="status-card">
    <view class="profile-row">{{loginStatus}}</view>
    <view class="nickname-row">
      <view class="profile-row">用户名称：{{nickname || '-'}}</view>
      <button class="nickname-edit-button" size="mini" bindtap="onStartNicknameEdit" disabled="{{isLoggingIn || !isLoggedIn || nicknameSaving}}">编辑</button>
    </view>
    <view wx:if="{{nicknameEditing}}" class="nickname-editor">
      <input class="nickname-input" value="{{nicknameDraft}}" maxlength="32" placeholder="请输入 2–32 个字符" bindinput="onNicknameInput" />
      <view class="nickname-actions">
        <button class="nickname-action-button" size="mini" bindtap="onCancelNicknameEdit" disabled="{{nicknameSaving}}">取消</button>
        <button class="nickname-action-button nickname-save-button" size="mini" bindtap="onSaveNickname" loading="{{nicknameSaving}}" disabled="{{nicknameSaving}}">保存</button>
      </view>
    </view>
    <view wx:if="{{nicknameMessage}}" class="nickname-message">{{nicknameMessage}}</view>
    <view class="profile-row">{{phoneStatus}}</view>
    <view wx:if="{{profileWarning}}" class="profile-warning">{{profileWarning}}</view>
    <button class="phone-button" open-type="getPhoneNumber" bindgetphonenumber="onGetPhoneNumber" disabled="{{isLoggingIn || !isLoggedIn || phoneAuthorizing}}">{{phoneButtonText}}</button>
  </view>

  <view class="action-list">
    <view
      wx:for="{{actionItems}}"
      wx:key="path"
      class="action-row"
      data-path="{{item.path}}"
      bindtap="onActionTap"
    >
      <view class="action-title">{{item.title}}</view>
      <view class="action-arrow">›</view>
    </view>
  </view>
</view>
