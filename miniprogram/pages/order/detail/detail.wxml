<view class="page order-detail-page">
  <view wx:if="{{loading && !detail}}" class="empty-state">订单详情加载中...</view>
  <view wx:elif="{{errorText && !detail}}" class="empty-state">{{errorText}}</view>
  <block wx:elif="{{detail}}">
    <view class="summary">
      <view class="summary-head">
        <view>
          <view class="summary-label">订单号</view>
          <view class="order-no">{{detail.orderNo}}</view>
        </view>
        <view class="status">{{detail.statusText}}</view>
      </view>
      <view class="summary-meta">创建时间：{{detail.createdAtText}}</view>
      <view wx:if="{{detail.closeReason}}" class="close-block">
        <view>关闭原因：{{detail.closeReason}}</view>
        <view wx:if="{{detail.closedAtText}}">关闭时间：{{detail.closedAtText}}</view>
      </view>
    </view>

    <view class="section">
      <view class="section-title">商品明细</view>
      <view class="item-list">
        <view wx:for="{{detail.items}}" wx:key="orderItemId" class="order-item">
          <image class="item-image" src="{{item.imageUrl}}" mode="aspectFill" />
          <view class="item-body">
            <view class="item-title">{{item.productTitle}}</view>
            <view class="item-subtitle">{{item.productSubtitle}}</view>
            <view class="item-spec">{{item.specText}}</view>
            <view class="item-meta">
              <view class="price">{{item.unitPriceText}}</view>
              <view class="quantity">x{{item.quantity}}</view>
            </view>
            <view class="line-amount">{{item.lineAmountText}}</view>
          </view>
        </view>
      </view>
    </view>

    <view class="section">
      <view class="section-title">金额明细</view>
      <view class="amount-row">
        <text>商品原价</text>
        <text>{{detail.productOriginalAmountText}}</text>
      </view>
      <view class="amount-row">
        <text>商品金额</text>
        <text>{{detail.productAmountText}}</text>
      </view>
      <view wx:if="{{detail.couponName}}" class="amount-row discount">
        <text>{{detail.couponName}}</text>
        <text>-{{detail.couponDiscountText}}</text>
      </view>
      <view class="amount-row">
        <text>运费</text>
        <text>{{detail.freightText}}</text>
      </view>
      <view class="amount-row">
        <text>实付</text>
        <text>{{detail.paidAmountText}}</text>
      </view>
      <view class="amount-row payable">
        <text>应付</text>
        <text>{{detail.payableAmountText}}</text>
      </view>
    </view>
  </block>
</view>
