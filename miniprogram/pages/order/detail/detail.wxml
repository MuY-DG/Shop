<view class="page order-detail-page {{showActionBar ? 'with-action-bar' : ''}}">
  <view wx:if="{{loading && !detail}}" class="empty-state">订单详情加载中...</view>
  <view wx:elif="{{errorText && !detail}}" class="empty-state">{{errorText}}</view>
  <block wx:elif="{{detail}}">
    <view class="summary">
      <view class="summary-head">
        <view class="summary-main">
          <view class="summary-label">订单号</view>
          <view class="order-no">{{detail.orderNo}}</view>
        </view>
        <view class="status">{{detail.statusText}}</view>
      </view>
      <view class="summary-meta">创建时间：{{detail.createdAtText}}</view>
      <view wx:if="{{detail.closeReason}}" class="close-block">
        <view>关闭原因：{{detail.closeReason}}</view>
        <view wx:if="{{detail.closedAtText}}">关闭时间：{{detail.closedAtText}}</view>
      </view>
    </view>

    <view wx:if="{{latestAfterSale}}" class="section aftersale-section">
      <view class="section-head">
        <view class="section-title">售后状态</view>
        <view class="aftersale-status">{{latestAfterSale.statusText}}</view>
      </view>
      <view class="aftersale-grid">
        <view>
          <view class="field-label">类型</view>
          <view class="field-value">{{latestAfterSale.typeText}}</view>
        </view>
        <view>
          <view class="field-label">申请金额</view>
          <view class="field-value amount">{{latestAfterSale.requestedAmountText}}</view>
        </view>
        <view>
          <view class="field-label">退款金额</view>
          <view class="field-value amount">{{latestAfterSale.refundAmountText}}</view>
        </view>
        <view>
          <view class="field-label">申请时间</view>
          <view class="field-value">{{latestAfterSale.createdAtText}}</view>
        </view>
      </view>
      <view class="audit-note">
        <view class="field-label">审核备注</view>
        <view class="field-value note">{{latestAfterSale.auditNoteText}}</view>
      </view>
    </view>

    <view class="section">
      <view class="section-title">商品明细</view>
      <view class="item-list">
        <view wx:for="{{detail.items}}" wx:key="orderItemId" class="order-item">
          <image class="item-image" src="{{item.imageUrl}}" mode="aspectFill" />
          <view class="item-body">
            <view class="item-title">{{item.productTitle}}</view>
            <view class="item-subtitle">{{item.productSubtitle}}</view>
            <view class="item-spec">{{item.specText}}</view>
            <view class="item-meta">
              <view class="price">{{item.unitPriceText}}</view>
              <view class="quantity">x{{item.quantity}}</view>
            </view>
            <view class="line-amount">{{item.lineAmountText}}</view>
          </view>
        </view>
      </view>
    </view>

    <view class="section">
      <view class="section-title">金额明细</view>
      <view class="amount-row">
        <text>商品原价</text>
        <text>{{detail.productOriginalAmountText}}</text>
      </view>
      <view class="amount-row">
        <text>商品金额</text>
        <text>{{detail.productAmountText}}</text>
      </view>
      <view wx:if="{{detail.couponName}}" class="amount-row discount">
        <text>{{detail.couponName}}</text>
        <text>-{{detail.couponDiscountText}}</text>
      </view>
      <view class="amount-row">
        <text>运费</text>
        <text>{{detail.freightText}}</text>
      </view>
      <view class="amount-row">
        <text>实付</text>
        <text>{{detail.paidAmountText}}</text>
      </view>
      <view class="amount-row payable">
        <text>应付</text>
        <text>{{detail.payableAmountText}}</text>
      </view>
    </view>
  </block>

  <view wx:if="{{detail && showActionBar}}" class="action-bar">
    <button
      class="action-button secondary"
      disabled="{{paymentOperating || cancelOperating}}"
      bindtap="onCustomerServiceTap"
    >
      咨询客服
    </button>
    <button
      wx:if="{{canCancel}}"
      class="action-button secondary"
      loading="{{cancelOperating}}"
      disabled="{{paymentOperating || cancelOperating}}"
      bindtap="onCancelTap"
    >
      取消订单
    </button>
    <button
      wx:if="{{canApplyAfterSale}}"
      class="action-button secondary"
      disabled="{{paymentOperating || cancelOperating}}"
      bindtap="onAfterSaleTap"
    >
      申请售后
    </button>
    <button
      wx:elif="{{hasActiveAfterSale}}"
      class="action-button disabled"
      disabled
    >
      售后处理中
    </button>
    <button
      wx:if="{{canPay}}"
      class="action-button primary"
      loading="{{paymentOperating}}"
      disabled="{{paymentOperating || cancelOperating}}"
      bindtap="onPayTap"
    >
      立即支付
    </button>
  </view>
</view>
