<view class="page preview-page">
  <view wx:if="{{loading && !preview}}" class="empty-state">订单预览加载中...</view>
  <view wx:elif="{{errorText && !preview}}" class="empty-state">{{errorText}}</view>
  <block wx:elif="{{preview}}">
    <view class="section">
      <view class="section-title">商品清单</view>
      <view class="item-list">
        <view wx:for="{{preview.items}}" wx:key="cartItemId" class="order-item">
          <image class="item-image" src="{{item.imageUrl}}" mode="aspectFill" />
          <view class="item-body">
            <view class="item-title">{{item.productTitle}}</view>
            <view class="item-subtitle">{{item.productSubtitle}}</view>
            <view class="item-spec">{{item.specText}}</view>
            <view class="item-meta">
              <view class="price">{{item.unitPriceText}}</view>
              <view class="quantity">x{{item.quantity}}</view>
            </view>
            <view class="line-amount">{{item.lineAmountText}}</view>
          </view>
        </view>
      </view>
    </view>

    <view class="section">
      <view class="section-title">金额明细</view>
      <view class="amount-row">
        <text>商品原价</text>
        <text>{{preview.productOriginalAmountText}}</text>
      </view>
      <view class="amount-row">
        <text>商品金额</text>
        <text>{{preview.productAmountText}}</text>
      </view>
      <view wx:if="{{preview.couponName}}" class="amount-row discount">
        <text>{{preview.couponName}}</text>
        <text>-{{preview.couponDiscountText}}</text>
      </view>
      <view class="amount-row">
        <text>运费</text>
        <text>{{preview.freightText}}</text>
      </view>
      <view class="amount-row payable">
        <text>应付</text>
        <text>{{preview.payableAmountText}}</text>
      </view>
    </view>
  </block>

  <view class="submit-bar">
    <view>
      <view class="submit-label">应付</view>
      <view class="submit-amount">{{preview ? preview.payableAmountText : '¥0.00'}}</view>
    </view>
    <button
      class="submit-button"
      loading="{{submitting}}"
      disabled="{{!preview || submitting}}"
      bindtap="onSubmitTap"
    >
      提交订单
    </button>
  </view>
</view>
