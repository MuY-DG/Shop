.preview-page {
  min-height: 100vh;
  padding: 24rpx 24rpx 150rpx;
  background: #f7f3ee;
  box-sizing: border-box;
}

.empty-state {
  padding: 160rpx 32rpx;
  color: #7a6f68;
  font-size: 28rpx;
  text-align: center;
}

.retry-button {
  margin-top: 24rpx;
  color: #b3261e;
}

.inline-error {
  margin-bottom: 20rpx;
  padding: 18rpx 22rpx;
  border-radius: 10rpx;
  background: #fff0ed;
  color: #b3261e;
  font-size: 24rpx;
  line-height: 34rpx;
}

.section {
  margin-bottom: 24rpx;
  padding: 24rpx;
  border-radius: 12rpx;
  background: #ffffff;
  box-shadow: 0 12rpx 32rpx rgba(110, 82, 67, 0.08);
  box-sizing: border-box;
}

.section-title {
  margin-bottom: 18rpx;
  color: #241f1c;
  font-size: 30rpx;
  font-weight: 800;
}

.address-section {
  position: relative;
}

.address-content {
  padding-right: 110rpx;
}

.address-receiver {
  display: flex;
  gap: 20rpx;
  color: #241f1c;
  font-size: 28rpx;
  font-weight: 800;
}

.address-detail {
  margin-top: 12rpx;
  color: #51443e;
  font-size: 25rpx;
  line-height: 36rpx;
}

.address-change {
  position: absolute;
  right: 24rpx;
  bottom: 26rpx;
  color: #b3261e;
  font-size: 24rpx;
}

.address-empty {
  padding: 18rpx 0;
  color: #b3261e;
  font-size: 28rpx;
  font-weight: 700;
}

.item-list {
  display: flex;
  flex-direction: column;
  gap: 22rpx;
}

.order-item {
  display: grid;
  grid-template-columns: 148rpx minmax(0, 1fr);
  gap: 20rpx;
}

.item-image {
  width: 148rpx;
  height: 148rpx;
  border-radius: 10rpx;
  background: #ead9cf;
}

.item-body {
  min-width: 0;
}

.item-title {
  color: #241f1c;
  font-size: 28rpx;
  font-weight: 800;
  line-height: 38rpx;
}

.item-subtitle,
.item-spec,
.quantity {
  color: #7a6f68;
  font-size: 22rpx;
  line-height: 32rpx;
}

.item-subtitle,
.item-spec {
  margin-top: 6rpx;
}

.item-meta {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-top: 14rpx;
}

.price,
.line-amount {
  color: #b3261e;
  font-weight: 800;
}

.price {
  font-size: 28rpx;
}

.line-amount {
  margin-top: 8rpx;
  font-size: 26rpx;
  text-align: right;
}

.amount-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  padding: 14rpx 0;
  color: #51443e;
  font-size: 26rpx;
  line-height: 36rpx;
}

.amount-row.discount {
  color: #8b5a09;
}

.amount-row.payable {
  margin-top: 10rpx;
  border-top: 1rpx solid #f0e4dc;
  color: #b3261e;
  font-size: 32rpx;
  font-weight: 800;
}

.submit-bar {
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  display: grid;
  grid-template-columns: minmax(0, 1fr) 240rpx;
  gap: 20rpx;
  align-items: center;
  padding: 18rpx 24rpx calc(18rpx + env(safe-area-inset-bottom));
  background: #ffffff;
  box-shadow: 0 -10rpx 30rpx rgba(68, 44, 32, 0.08);
  box-sizing: border-box;
}

.submit-label {
  color: #7a6f68;
  font-size: 22rpx;
}

.submit-amount {
  margin-top: 4rpx;
  color: #b3261e;
  font-size: 36rpx;
  font-weight: 800;
}

.submit-button {
  width: 240rpx;
  height: 84rpx;
  border-radius: 12rpx;
  background: #b3261e;
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 800;
  line-height: 84rpx;
}

.submit-button[disabled] {
  opacity: 0.55;
}
