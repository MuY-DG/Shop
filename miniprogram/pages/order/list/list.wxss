.order-list-page {
  min-height: 100vh;
  padding: 24rpx;
  background: #f7f3ee;
  box-sizing: border-box;
}

.empty-state {
  padding: 160rpx 32rpx;
  color: #7a6f68;
  font-size: 28rpx;
  text-align: center;
}

.order-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.order-card {
  padding: 24rpx;
  border-radius: 12rpx;
  background: #ffffff;
  box-shadow: 0 12rpx 32rpx rgba(110, 82, 67, 0.08);
  box-sizing: border-box;
}

.order-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.order-no {
  min-width: 0;
  color: #51443e;
  font-size: 24rpx;
  line-height: 34rpx;
}

.status {
  flex: none;
  color: #b3261e;
  font-size: 24rpx;
  font-weight: 800;
}

.product-title {
  margin-top: 16rpx;
  color: #241f1c;
  font-size: 30rpx;
  font-weight: 800;
  line-height: 40rpx;
}

.order-meta {
  margin-top: 8rpx;
  color: #7a6f68;
  font-size: 22rpx;
  line-height: 32rpx;
}

.amount-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 12rpx;
  margin-top: 22rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid #f0e4dc;
}

.amount-label {
  color: #7a6f68;
  font-size: 20rpx;
  line-height: 28rpx;
}

.amount-value {
  margin-top: 4rpx;
  color: #51443e;
  font-size: 22rpx;
  font-weight: 700;
  line-height: 32rpx;
}

.amount-value.discount {
  color: #8b5a09;
}

.amount-value.payable {
  color: #b3261e;
}
