<view class="page order-list-page">
  <view wx:if="{{loading && orders.length === 0}}" class="empty-state">订单加载中...</view>
  <view wx:elif="{{errorText && orders.length === 0}}" class="empty-state">{{errorText}}</view>
  <view wx:elif="{{orders.length === 0}}" class="empty-state">暂无订单</view>
  <view wx:else class="order-list">
    <view
      wx:for="{{orders}}"
      wx:key="orderId"
      class="order-card"
      data-id="{{item.orderId}}"
      bindtap="onOrderTap"
    >
      <view class="order-head">
        <view class="order-no">{{item.orderNo}}</view>
        <view class="status">{{item.statusText}}</view>
      </view>
      <view class="product-title">{{item.productTitle}}</view>
      <view class="order-meta">{{item.itemCount}} 件商品 · {{item.createdAtText}}</view>
      <view class="amount-grid">
        <view>
          <view class="amount-label">商品</view>
          <view class="amount-value">{{item.productAmountText}}</view>
        </view>
        <view>
          <view class="amount-label">优惠</view>
          <view class="amount-value discount">-{{item.couponDiscountText}}</view>
        </view>
        <view>
          <view class="amount-label">运费</view>
          <view class="amount-value">{{item.freightText}}</view>
        </view>
        <view>
          <view class="amount-label">应付</view>
          <view class="amount-value payable">{{item.payableAmountText}}</view>
        </view>
      </view>
    </view>
  </view>
</view>
