<view class="page address-list-page">
  <view wx:if="{{selectionMode}}" class="selection-tip">请选择本次订单的收货地址</view>
  <view wx:if="{{errorText && addresses.length > 0}}" class="inline-error">
    <text>{{errorText}}</text>
    <button class="inline-retry" size="mini" bindtap="onRetryTap">重试</button>
  </view>

  <view wx:if="{{loading && addresses.length === 0}}" class="empty-state">地址加载中...</view>
  <view wx:elif="{{errorText && addresses.length === 0}}" class="empty-state">
    <view>{{errorText}}</view>
    <button class="retry-button" size="mini" bindtap="onRetryTap">重试</button>
  </view>
  <view wx:elif="{{addresses.length === 0}}" class="empty-state">暂无收货地址，请先新增</view>
  <view wx:else class="address-list">
    <view
      wx:for="{{addresses}}"
      wx:key="id"
      class="address-card"
      data-id="{{item.id}}"
      bindtap="onAddressTap"
    >
      <view class="address-header">
        <view class="receiver">
          <text class="receiver-name">{{item.receiverName}}</text>
          <text class="receiver-phone">{{item.receiverPhone}}</text>
        </view>
        <view wx:if="{{item.isDefault}}" class="default-badge">默认</view>
      </view>
      <view class="formatted-address">{{item.formattedAddress}}</view>
      <view wx:if="{{!selectionMode}}" class="address-actions">
        <button class="minor-button" size="mini" data-id="{{item.id}}" catchtap="onEditTap">编辑</button>
        <button
          class="minor-button"
          size="mini"
          data-id="{{item.id}}"
          loading="{{settingDefaultId === item.id}}"
          disabled="{{item.isDefault || settingDefaultId !== ''}}"
          catchtap="onDefaultTap"
        >设为默认</button>
        <button
          class="minor-button danger"
          size="mini"
          data-id="{{item.id}}"
          loading="{{deletingId === item.id}}"
          disabled="{{deletingId !== ''}}"
          catchtap="onDeleteTap"
        >删除</button>
      </view>
      <view wx:else class="select-hint">选择此地址</view>
    </view>
  </view>

  <button class="create-button" bindtap="onCreateTap">新增收货地址</button>
</view>
