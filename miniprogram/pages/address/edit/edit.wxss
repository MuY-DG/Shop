.address-edit-page {
  min-height: 100vh;
  padding: 24rpx 24rpx 150rpx;
  background: #f7f3ee;
  box-sizing: border-box;
}

.empty-state {
  padding: 160rpx 32rpx;
  color: #7a6f68;
  font-size: 28rpx;
  text-align: center;
}

.retry-button {
  margin-top: 24rpx;
  color: #b3261e;
}

.form-card {
  padding: 8rpx 28rpx 28rpx;
  border-radius: 12rpx;
  background: #ffffff;
  box-shadow: 0 12rpx 32rpx rgba(110, 82, 67, 0.08);
}

.field {
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f0e4dc;
}

.field-label {
  color: #241f1c;
  font-size: 26rpx;
  font-weight: 700;
}

.field input,
.field textarea {
  width: 100%;
  min-height: 54rpx;
  margin-top: 12rpx;
  color: #51443e;
  font-size: 28rpx;
  line-height: 40rpx;
}

.default-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  padding-top: 26rpx;
}

.field-help {
  margin-top: 6rpx;
  color: #7a6f68;
  font-size: 22rpx;
}

.form-error {
  margin-top: 24rpx;
  color: #b3261e;
  font-size: 24rpx;
  line-height: 34rpx;
}

.save-button {
  position: fixed;
  right: 24rpx;
  bottom: calc(22rpx + env(safe-area-inset-bottom));
  left: 24rpx;
  height: 84rpx;
  border-radius: 12rpx;
  background: #b3261e;
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 800;
  line-height: 84rpx;
}

.save-button[disabled] {
  opacity: 0.55;
}
