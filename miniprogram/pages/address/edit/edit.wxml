<view class="page address-edit-page">
  <view wx:if="{{loading}}" class="empty-state">地址加载中...</view>
  <view wx:elif="{{errorText && addressId > 0 && !receiverName}}" class="empty-state">
    <view>{{errorText}}</view>
    <button class="retry-button" size="mini" bindtap="onRetryTap">重试</button>
  </view>
  <view wx:else class="form-card">
    <view class="field">
      <view class="field-label">收货人</view>
      <input value="{{receiverName}}" maxlength="64" placeholder="请输入收货人姓名" data-field="receiverName" bindinput="onInput" />
    </view>
    <view class="field">
      <view class="field-label">手机号</view>
      <input type="number" value="{{receiverPhone}}" maxlength="32" placeholder="请输入收货手机号" data-field="receiverPhone" bindinput="onInput" />
    </view>
    <view class="field">
      <view class="field-label">省份</view>
      <input value="{{province}}" maxlength="64" placeholder="例如：四川省" data-field="province" bindinput="onInput" />
    </view>
    <view class="field">
      <view class="field-label">城市</view>
      <input value="{{city}}" maxlength="64" placeholder="例如：成都市" data-field="city" bindinput="onInput" />
    </view>
    <view class="field">
      <view class="field-label">区县</view>
      <input value="{{district}}" maxlength="64" placeholder="例如：武侯区" data-field="district" bindinput="onInput" />
    </view>
    <view class="field">
      <view class="field-label">详细地址</view>
      <textarea value="{{detailAddress}}" maxlength="255" auto-height="true" placeholder="街道、楼栋、门牌号" data-field="detailAddress" bindinput="onInput"></textarea>
    </view>
    <view class="default-row">
      <view>
        <view class="field-label">设为默认地址</view>
        <view class="field-help">下单时优先使用此地址</view>
      </view>
      <switch checked="{{isDefault}}" color="#b3261e" bindchange="onDefaultChange" />
    </view>
    <view wx:if="{{errorText}}" class="form-error">{{errorText}}</view>
  </view>

  <button
    class="save-button"
    loading="{{submitting}}"
    disabled="{{loading || submitting}}"
    bindtap="onSubmitTap"
  >保存地址</button>
</view>
