.coupon-page {
  min-height: 100vh;
  padding-bottom: 32rpx;
  box-sizing: border-box;
}

.page-header {
  margin-bottom: 24rpx;
}

.page-title {
  color: #241f1c;
  font-size: 40rpx;
  font-weight: 800;
  line-height: 52rpx;
}

.page-subtitle {
  margin-top: 8rpx;
  color: #7a6f68;
  font-size: 24rpx;
  line-height: 34rpx;
}

.empty-state {
  padding: 160rpx 32rpx;
  color: #7a6f68;
  font-size: 28rpx;
  text-align: center;
}

.section-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.section-block {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.section-title {
  color: #51443e;
  font-size: 26rpx;
  font-weight: 700;
}

.coupon-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.coupon-card {
  display: grid;
  grid-template-columns: 180rpx minmax(0, 1fr);
  gap: 20rpx;
  align-items: center;
  padding: 24rpx;
  border-radius: 12rpx;
  background: #ffffff;
  box-shadow: 0 12rpx 32rpx rgba(110, 82, 67, 0.08);
  box-sizing: border-box;
}

.coupon-card.muted {
  opacity: 0.68;
}

.coupon-main {
  min-width: 0;
  text-align: center;
}

.coupon-amount {
  color: #b3261e;
  font-size: 44rpx;
  font-weight: 800;
  line-height: 56rpx;
}

.coupon-threshold {
  margin-top: 8rpx;
  color: #7a6f68;
  font-size: 22rpx;
  line-height: 32rpx;
}

.coupon-body {
  min-width: 0;
}

.coupon-name {
  color: #241f1c;
  font-size: 30rpx;
  font-weight: 800;
  line-height: 40rpx;
}

.coupon-meta {
  margin-top: 8rpx;
  color: #7a6f68;
  font-size: 22rpx;
  line-height: 32rpx;
}
