.coupon-page {
  min-height: 100vh;
  padding-bottom: 32rpx;
  box-sizing: border-box;
}

.page-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
  margin-bottom: 24rpx;
}

.page-title {
  color: #241f1c;
  font-size: 40rpx;
  font-weight: 800;
  line-height: 52rpx;
}

.page-subtitle {
  margin-top: 8rpx;
  color: #7a6f68;
  font-size: 24rpx;
  line-height: 34rpx;
}

.mine-button {
  color: #8a6f61;
}

.empty-state {
  padding: 160rpx 32rpx;
  color: #7a6f68;
  font-size: 28rpx;
  text-align: center;
}

.coupon-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.coupon-card {
  display: grid;
  grid-template-columns: 180rpx minmax(0, 1fr) 148rpx;
  gap: 20rpx;
  align-items: center;
  padding: 24rpx;
  border-radius: 12rpx;
  background: #ffffff;
  box-shadow: 0 12rpx 32rpx rgba(110, 82, 67, 0.08);
  box-sizing: border-box;
}

.coupon-card.disabled {
  opacity: 0.7;
}

.coupon-main {
  min-width: 0;
  text-align: center;
}

.coupon-amount {
  color: #b3261e;
  font-size: 44rpx;
  font-weight: 800;
  line-height: 56rpx;
}

.coupon-threshold {
  margin-top: 8rpx;
  color: #7a6f68;
  font-size: 22rpx;
  line-height: 32rpx;
}

.coupon-body {
  min-width: 0;
}

.coupon-name {
  color: #241f1c;
  font-size: 30rpx;
  font-weight: 800;
  line-height: 40rpx;
}

.coupon-description,
.coupon-meta {
  margin-top: 8rpx;
  color: #7a6f68;
  font-size: 22rpx;
  line-height: 32rpx;
}

.coupon-description {
  display: -webkit-box;
  overflow: hidden;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.coupon-state {
  margin-top: 10rpx;
  color: #8b5a09;
  font-size: 22rpx;
  line-height: 32rpx;
}

.claim-button {
  width: 148rpx;
  height: 72rpx;
  padding: 0;
  border-radius: 10rpx;
  background: #b3261e;
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 700;
  line-height: 72rpx;
}
