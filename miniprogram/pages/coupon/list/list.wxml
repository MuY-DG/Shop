<view class="page coupon-page">
  <view class="page-header">
    <view>
      <view class="page-title">领券中心</view>
      <view class="page-subtitle">先领券，购物车会自动推荐最优优惠</view>
    </view>
    <button class="mine-button" size="mini" bindtap="onMineTap">我的优惠券</button>
  </view>

  <view wx:if="{{loading && coupons.length === 0}}" class="empty-state">优惠券加载中...</view>
  <view wx:elif="{{errorText && coupons.length === 0}}" class="empty-state">{{errorText}}</view>
  <view wx:elif="{{coupons.length === 0}}" class="empty-state">暂无可领取优惠券</view>
  <view wx:else class="coupon-list">
    <view
      wx:for="{{coupons}}"
      wx:key="templateId"
      class="coupon-card {{item.claimable ? '' : 'disabled'}}"
    >
      <view class="coupon-main">
        <view class="coupon-amount">{{item.discountText}}</view>
        <view class="coupon-threshold">{{item.thresholdText}}</view>
      </view>
      <view class="coupon-body">
        <view class="coupon-name">{{item.name}}</view>
        <view class="coupon-description">{{item.description}}</view>
        <view class="coupon-meta">{{item.validityText}}</view>
        <view class="coupon-meta">{{item.limitText}}</view>
        <view class="coupon-state">{{item.claimStateText}}</view>
      </view>
      <button
        class="claim-button"
        data-id="{{item.templateId}}"
        loading="{{claimingTemplateId === item.templateId}}"
        disabled="{{item.disabled}}"
        bindtap="onClaimTap"
      >
        {{item.actionText}}
      </button>
    </view>
  </view>
</view>
