.product-detail-page {
  padding: 0 0 156rpx;
}

.empty-state {
  padding: 160rpx 32rpx;
  color: #7a6f68;
  font-size: 28rpx;
  text-align: center;
}

.gallery,
.gallery-placeholder {
  width: 100%;
  height: 720rpx;
  background: #ead9cf;
}

.gallery-image,
.gallery-placeholder {
  width: 100%;
  height: 100%;
}

.gallery-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #9c5549;
  font-size: 36rpx;
  font-weight: 800;
}

.summary,
.section {
  margin: 24rpx 32rpx 0;
  padding: 28rpx;
  border-radius: 12rpx;
  background: #ffffff;
  box-sizing: border-box;
  box-shadow: 0 12rpx 32rpx rgba(110, 82, 67, 0.08);
}

.category-name {
  display: inline-flex;
  max-width: 100%;
  padding: 6rpx 12rpx;
  border-radius: 6rpx;
  background: #f5dfd8;
  color: #b3261e;
  font-size: 22rpx;
  font-weight: 700;
  box-sizing: border-box;
}

.product-title {
  margin-top: 18rpx;
  color: #241f1c;
  font-size: 40rpx;
  font-weight: 800;
  line-height: 50rpx;
}

.product-subtitle {
  margin-top: 12rpx;
  color: #7a6f68;
  font-size: 26rpx;
  line-height: 36rpx;
}

.price-row {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 20rpx;
  margin-top: 26rpx;
}

.price {
  color: #b3261e;
  font-size: 44rpx;
  font-weight: 800;
}

.stock {
  color: #7a6f68;
  font-size: 24rpx;
}

.selling-points {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 22rpx;
}

.selling-point {
  max-width: 280rpx;
  padding: 6rpx 12rpx;
  border-radius: 6rpx;
  background: #fff4d8;
  color: #8b5a09;
  font-size: 22rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.section-title {
  margin-bottom: 18rpx;
  color: #241f1c;
  font-size: 30rpx;
  font-weight: 800;
}

.quantity-section,
.quantity-control {
  display: flex;
  align-items: center;
}

.quantity-section {
  justify-content: space-between;
  gap: 24rpx;
}

.quantity-title {
  margin-bottom: 6rpx;
}

.quantity-limit {
  color: #7a6f68;
  font-size: 22rpx;
}

.quantity-control {
  display: grid;
  grid-template-columns: 58rpx 74rpx 58rpx;
}

.quantity-button {
  width: 58rpx;
  height: 58rpx;
  margin: 0;
  padding: 0;
  border-radius: 8rpx;
  background: #fff8f4;
  color: #8a6f61;
  font-size: 30rpx;
  line-height: 58rpx;
}

.quantity-button[disabled] {
  opacity: 0.45;
}

.quantity-value {
  height: 58rpx;
  color: #241f1c;
  font-size: 26rpx;
  font-weight: 800;
  line-height: 58rpx;
  text-align: center;
}

.sku-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 14rpx;
}

.sku-option {
  min-height: 116rpx;
  padding: 18rpx;
  border: 1rpx solid #ead9cf;
  border-radius: 10rpx;
  background: #ffffff;
  box-sizing: border-box;
}

.sku-option.selected {
  border-color: #b3261e;
  background: #fff3ef;
}

.sku-option.disabled {
  opacity: 0.45;
}

.sku-name {
  color: #241f1c;
  font-size: 26rpx;
  font-weight: 700;
  line-height: 34rpx;
}

.sku-meta {
  display: flex;
  justify-content: space-between;
  gap: 12rpx;
  margin-top: 12rpx;
  color: #7a6f68;
  font-size: 22rpx;
}

.action-bar {
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
  padding: 18rpx 24rpx calc(18rpx + env(safe-area-inset-bottom));
  background: #ffffff;
  box-shadow: 0 -10rpx 30rpx rgba(68, 44, 32, 0.08);
  box-sizing: border-box;
}

.action-button {
  width: 100%;
  height: 84rpx;
  border-radius: 12rpx;
  color: #ffffff;
  font-size: 26rpx;
  font-weight: 700;
  line-height: 84rpx;
}

.action-button[disabled] {
  opacity: 0.55;
}

.cart-button {
  background: #8a6f61;
}

.buy-button {
  background: #b3261e;
}
