<view class="page product-detail-page">
  <view wx:if="{{loading}}" class="empty-state">商品加载中...</view>
  <view wx:elif="{{errorText}}" class="empty-state">{{errorText}}</view>
  <block wx:elif="{{detail}}">
    <swiper wx:if="{{galleryImages.length > 0}}" class="gallery" indicator-dots="true" autoplay="true" interval="4000">
      <swiper-item wx:for="{{galleryImages}}" wx:key="id">
        <image class="gallery-image" src="{{item.url}}" mode="aspectFill" />
      </swiper-item>
    </swiper>
    <view wx:else class="gallery-placeholder">火锅底料</view>

    <view class="summary">
      <view class="category-name">{{detail.categoryName}}</view>
      <view class="product-title">{{detail.title}}</view>
      <view class="product-subtitle">{{detail.subtitle}}</view>
      <view class="price-row">
        <view class="price-block">
          <view class="price">{{selectedPriceText}}</view>
          <view wx:if="{{selectedRetailPriceText}}" class="retail-price">常规 {{selectedRetailPriceText}}</view>
        </view>
        <view class="stock">{{selectedStockText}}</view>
      </view>
      <view wx:if="{{wholesaleApplied}}" class="wholesale-badge">批发价已生效</view>
      <view class="selling-points">
        <view
          wx:for="{{detail.sellingPoints}}"
          wx:key="*this"
          wx:for-item="point"
          class="selling-point"
        >
          {{point}}
        </view>
      </view>
    </view>

    <view wx:if="{{wholesaleTierViews.length}}" class="section wholesale-section">
      <view class="section-title">批发阶梯价</view>
      <view class="wholesale-grid">
        <view
          wx:for="{{wholesaleTierViews}}"
          wx:key="minQuantity"
          class="wholesale-tier {{item.active ? 'active' : ''}}"
        >
          <view>{{item.minQuantity}} 件起</view>
          <view class="wholesale-price">{{item.priceText}} / 件</view>
        </view>
      </view>
    </view>

    <view class="section">
      <view class="section-title">规格</view>
      <view class="sku-grid">
        <view
          wx:for="{{skuViews}}"
          wx:key="id"
          class="sku-option {{item.selected ? 'selected' : ''}} {{item.disabled ? 'disabled' : ''}}"
          data-id="{{item.id}}"
          bindtap="onSkuTap"
        >
          <view class="sku-name">{{item.specText}}</view>
          <view class="sku-meta">
            <text>{{item.priceText}}</text>
            <text>{{item.stockText}}</text>
          </view>
        </view>
      </view>
    </view>

    <view class="section quantity-section">
      <view>
        <view class="section-title quantity-title">购买数量</view>
        <view class="quantity-limit">最多可购 {{selectedQuantityMax}} 件</view>
        <view wx:if="{{selectedWholesaleHint}}" class="quantity-wholesale-hint">{{selectedWholesaleHint}}</view>
      </view>
      <view class="quantity-control">
        <button
          class="quantity-button"
          disabled="{{selectedQuantity <= 1}}"
          bindtap="onQuantityMinus"
        >-</button>
        <view class="quantity-value">{{selectedQuantity}}</view>
        <button
          class="quantity-button"
          disabled="{{selectedQuantityMax <= 0 || selectedQuantity >= selectedQuantityMax}}"
          bindtap="onQuantityPlus"
        >+</button>
      </view>
    </view>

    <view wx:if="{{detail.detailHtml}}" class="section">
      <view class="section-title">详情</view>
      <rich-text nodes="{{detail.detailHtml}}"></rich-text>
    </view>
  </block>

  <view class="action-bar">
    <button
      class="action-button service-button"
      disabled="{{!detail}}"
      bindtap="onCustomerServiceTap"
    >联系客服</button>
    <button
      class="action-button cart-button"
      disabled="{{!selectedSkuId || addingCart || buying}}"
      loading="{{addingCart}}"
      bindtap="onAddCartTap"
    >
      加入购物车
    </button>
    <button
      class="action-button buy-button"
      disabled="{{!selectedSkuId || buying || addingCart}}"
      loading="{{buying}}"
      bindtap="onBuyNowTap"
    >立即购买</button>
  </view>
</view>
