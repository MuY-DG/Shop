.product-list-page {
  padding-top: 24rpx;
}

.category-bar {
  position: sticky;
  top: 0;
  z-index: 2;
  width: 100%;
  padding: 8rpx 0 22rpx;
  background: #f7f3ee;
  white-space: nowrap;
}

.category-track {
  display: flex;
  gap: 16rpx;
}

.category-tab {
  flex: 0 0 auto;
  min-width: 112rpx;
  max-width: 240rpx;
  padding: 16rpx 22rpx;
  border: 1rpx solid #ead9cf;
  border-radius: 12rpx;
  background: #ffffff;
  color: #51443e;
  font-size: 26rpx;
  font-weight: 600;
  text-align: center;
  box-sizing: border-box;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.category-tab.active {
  border-color: #b3261e;
  background: #b3261e;
  color: #ffffff;
}

.empty-state {
  padding: 120rpx 0;
  color: #7a6f68;
  font-size: 28rpx;
  text-align: center;
}

.product-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.product-card {
  display: flex;
  gap: 20rpx;
  padding: 20rpx;
  border-radius: 12rpx;
  background: #ffffff;
  box-shadow: 0 12rpx 32rpx rgba(110, 82, 67, 0.08);
}

.product-image-wrap {
  width: 190rpx;
  height: 190rpx;
  flex: 0 0 190rpx;
  border-radius: 10rpx;
  overflow: hidden;
  background: #ead9cf;
}

.product-image,
.product-image-placeholder {
  width: 100%;
  height: 100%;
}

.product-image-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #9c5549;
  font-size: 30rpx;
  font-weight: 700;
}

.product-body {
  min-width: 0;
  flex: 1;
}

.product-title {
  color: #241f1c;
  font-size: 30rpx;
  font-weight: 800;
  line-height: 38rpx;
  display: -webkit-box;
  overflow: hidden;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.product-subtitle {
  margin-top: 8rpx;
  color: #7a6f68;
  font-size: 24rpx;
  line-height: 32rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.selling-points {
  display: flex;
  gap: 8rpx;
  min-height: 34rpx;
  margin-top: 14rpx;
  overflow: hidden;
}

.selling-point {
  flex: 0 1 auto;
  max-width: 150rpx;
  padding: 4rpx 10rpx;
  border-radius: 6rpx;
  background: #fff4d8;
  color: #8b5a09;
  font-size: 20rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.product-footer {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 12rpx;
  margin-top: 24rpx;
}

.price {
  color: #b3261e;
  font-size: 34rpx;
  font-weight: 800;
}

.stock {
  color: #7a6f68;
  font-size: 23rpx;
  white-space: nowrap;
}

.sold-out {
  color: #b84a3d;
}

.load-more,
.inline-error {
  padding: 28rpx 0 12rpx;
  color: #7a6f68;
  font-size: 24rpx;
  text-align: center;
}

.inline-error {
  color: #b84a3d;
}
