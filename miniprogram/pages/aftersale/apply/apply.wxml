<view class="page aftersale-apply-page">
  <view class="section">
    <view class="section-title">售后类型</view>
    <view class="type-segment">
      <button
        wx:for="{{typeOptions}}"
        wx:key="value"
        class="type-button {{selectedType === item.value ? 'active' : ''}}"
        data-type="{{item.value}}"
        bindtap="onTypeTap"
      >
        {{item.label}}
      </button>
    </view>
  </view>

  <view class="section">
    <view class="field">
      <view class="field-label">售后原因</view>
      <picker mode="selector" range="{{reasons}}" value="{{reasonIndex}}" bindchange="onReasonChange">
        <view class="picker-value">{{reasons[reasonIndex]}}</view>
      </picker>
    </view>

    <view class="field">
      <view class="field-label">退款金额</view>
      <view class="amount-input-row">
        <text class="currency">¥</text>
        <input
          class="amount-input"
          type="digit"
          value="{{amountYuan}}"
          placeholder="0.00"
          bindinput="onAmountInput"
        />
      </view>
      <view wx:if="{{maxRefundText}}" class="field-hint">最多可退 {{maxRefundText}}</view>
    </view>

    <view class="field">
      <view class="field-label">补充描述</view>
      <textarea
        class="description-input"
        maxlength="500"
        value="{{description}}"
        placeholder="请描述售后原因，可选"
        bindinput="onDescriptionInput"
      />
    </view>
  </view>

  <view class="section">
    <view class="section-head">
      <view class="section-title">凭证图片</view>
      <view class="section-count">{{evidenceFiles.length}}/3</view>
    </view>
    <view class="evidence-grid">
      <view wx:for="{{evidenceFiles}}" wx:key="fileId" class="evidence-item">
        <image class="evidence-image" src="{{item.tempFilePath}}" mode="aspectFill" />
        <button class="remove-button" data-index="{{index}}" bindtap="onRemoveEvidenceTap">移除</button>
      </view>
      <button
        wx:if="{{evidenceFiles.length < 3}}"
        class="upload-button"
        loading="{{uploading}}"
        disabled="{{uploading || submitting}}"
        bindtap="onChooseEvidenceTap"
      >
        上传图片
      </button>
    </view>
  </view>

  <view class="submit-bar">
    <button
      class="submit-button"
      loading="{{submitting}}"
      disabled="{{submitting || uploading}}"
      bindtap="onSubmitTap"
    >
      提交申请
    </button>
  </view>
</view>
